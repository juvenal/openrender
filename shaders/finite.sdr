#!version 1.0.0
light
#!parameters:
uniform	float	intensity	=	1
uniform	color	lightcolor	=	1
uniform	vector	location	=	 [ 0 0 0 ]
#!variables:
varying	vector	temporary_0
uniform	vector	temporary_1
uniform	vector	temporary_2
#!Init:
	return            
#!Code:
	vuvector           temporary_0 location
	subvv             	L Ps temporary_0
	vfromf            	temporary_2 intensity
	mulvv             	temporary_1 temporary_2 lightcolor
	vuvector           Cl temporary_1
	return            
