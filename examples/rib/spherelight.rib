##RenderMan RIB-Structure 1.0
version 3.03
# spherelight.rib -- demonstrates the spherelight area light shader
# (shaders/spherelight.sl), the RSL replacement for the old hardcoded
# CSphereLight. Needs the raytrace hider: spherelight uses visibility()
# for its per-sample soft-shadow test.
Hider "raytrace"
Display "spherelight.tif" "file" "rgba"
Projection "perspective" "fov" 40
Format 320 240 1
Clipping 0.1 1000
Translate 0 0 12
WorldBegin
    LightSource "spherelight" 1 "from" [4 6 -2] "radius" [1.0]
                "intensity" [80] "numSamples" [16]
    AttributeBegin
        Color [0.8 0.8 0.8]
        Surface "matte"
        Translate 0 0 3
        Sphere 1.5 -1.5 1.5 360
    AttributeEnd
    AttributeBegin
        Color [0.7 0.7 0.7]
        Surface "matte"
        Translate 0 -3 0
        Rotate -90 1 0 0
        Disk 0 20 360
    AttributeEnd
WorldEnd
