##RenderMan RIB-Structure 1.0
version 3.03
#Hider "raytrace"
PixelSamples 4 4
Display "subdiv-interpolateboundary.tif" "file" "rgba"
Projection "perspective" "fov" 45
#Format 320 240 1
Translate 0 0 240
Rotate 74 1 0 0
Rotate 10 0 1 0

WorldBegin
  LightSource "ambientlight" 1 "intensity" [0.15]
  LightSource "distantlight" 2 "intensity" [0.9] "lightcolor" [1 .95 .9] "from" [20 30 25] "to" [0 0 0]
  LightSource "distantlight" 3 "intensity" [0.35] "lightcolor" [.7 .8 1] "from" [-25 10 -20] "to" [0 0 0]

  Sides 2
  Color [0.7 0.7 0.8]
  Surface "matte"
  SubdivisionMesh "catmull-clark"
        [4 4 4 4 4 4 4 4 4]
        [0 4 5 1 1 5 6 2 2 6 7 3 4 8 9 5 5 9 10 6 6 10 11 7 8 12 13 9 9 13 14 10 10 14 15 11]
        ["interpolateboundary"] [0 0] [] []
    "P" [-60 60 0 -60 20 0 -60 -20 0 -60 -60 0 -20 60 0 -20 20 45 -20 -20 45 -20 -60 0 20 60 0 20 20 45 20 -20 45 20 -60 0 60 60 0 60 20 0 60 -20 0 60 -60 0]
WorldEnd

