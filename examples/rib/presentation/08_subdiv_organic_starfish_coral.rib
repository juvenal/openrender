##RenderMan RIB-Structure 1.1
##Scene: 08_subdiv_organic_starfish_coral.rib
##Features: Multi-Arm Branching Catmull-Clark SubdivisionMesh with Extraordinary (Valence-6)
##          Vertices and Smooth Per-Vertex Color Interpolation ("varying color Cs")
version 3.03

Format 1024 768 1.0
PixelSamples 4 4
PixelFilter "gaussian" 2.0 2.0
ShadingRate 1.0
Display "08_subdiv_organic_starfish_coral.tif" "file" "rgba"

Projection "perspective" "fov" [38.0]
Clipping 0.1 100.0

Translate 0.0 -0.1 6.8
Rotate -26.0 1 0 0
Rotate 15.0 0 1 0

WorldBegin

    LightSource "ambientlight" 1 "intensity" [0.15] "lightcolor" [0.75 0.88 1.0]
    LightSource "pointlight" 2 "from" [3.5 6.0 -3.0] "intensity" [38.0] "lightcolor" [1.0 0.96 0.88]
    LightSource "pointlight" 3 "from" [-4.5 3.5 -2.0] "intensity" [18.0] "lightcolor" [0.45 0.82 1.0]
    LightSource "pointlight" 4 "from" [0.0 -1.0 -1.5] "intensity" [8.0] "lightcolor" [1.0 0.55 0.35]

    # Seabed Floor
    AttributeBegin
        Color [0.78 0.74 0.66]
        Surface "matte" "Kd" [0.85]
        Polygon "P" [-15.0 -1.45 -15.0  15.0 -1.45 -15.0  15.0 -1.45 15.0  -15.0 -1.45 15.0]
    AttributeEnd

    # =========================================================================
    # Primary Showcase: 4-Arm Organic Starfish / Reef Crown
    # Built from a central hub cube (vertices 0..7) with 4 extruded tapering arms:
    #   +X Arm: vertices 8..11
    #   -X Arm: vertices 12..15
    #   +Z Arm: vertices 16..19
    #   -Z Arm: vertices 20..23
    #   Top Dome Apex: vertices 24..27
    # Total = 28 vertices, 26 quad faces (closed manifold genus-0 mesh)
    # =========================================================================
    AttributeBegin
        Attribute "identifier" "name" ["SubdivOrganicStarfish"]
        Translate 0.0 -0.35 0.0
        Rotate 12 0 1 0
        Surface "plastic" "Ka" [0.18] "Kd" [0.72] "Ks" [0.75] "roughness" [0.08]

        SubdivisionMesh "catmull-clark"
            [
                4  4 4 4 4 4
                4 4 4 4 4
                4 4 4 4 4
                4 4 4 4 4
                4 4 4 4 4
            ]
            [
                # Bottom Hub Cap (1 face)
                0 3 2 1
                # Top Crown Extrusion (5 faces: 4 sides + 1 top cap)
                4 5 25 24   5 6 26 25   6 7 27 26   7 4 24 27   24 25 26 27
                # +X Arm on face (1, 2, 6, 5) -> 5 faces
                1 8 11 5    8 9 10 11   2 9 8 1     6 10 9 2    5 11 10 6
                # -X Arm on face (3, 0, 4, 7) -> 5 faces
                3 12 15 7   12 13 14 15 0 13 12 3   4 14 13 0   7 15 14 4
                # +Z Arm on face (2, 3, 7, 6) -> 5 faces
                2 16 19 6   16 17 18 19 3 17 16 2   7 18 17 3   6 19 18 7
                # -Z Arm on face (0, 1, 5, 4) -> 5 faces
                0 20 23 4   20 21 22 23 1 21 20 0   5 22 21 1   4 23 22 5
            ]
            ["interpolateboundary" "corner"]
            [0 0  4 1]
            # Slightly sharpen the 4 arm tips for organic reef spines
            [9 13 17 21]
            [2.0]
            "P" [
                # 0..3: Hub bottom (y = -0.85)
                -0.65 -0.85 -0.65    0.65 -0.85 -0.65    0.65 -0.85  0.65   -0.65 -0.85  0.65
                # 4..7: Hub upper shoulder (y = 0.25)
                -0.75  0.25 -0.75    0.75  0.25 -0.75    0.75  0.25  0.75   -0.75  0.25  0.75
                # 8..11: +X Arm tip (curling upward and forward)
                 2.55 -0.55 -0.35    2.75 -0.25  0.25    2.45  0.55  0.35    2.35  0.35 -0.25
                # 12..15: -X Arm tip (curling upward)
                -2.55 -0.55  0.35   -2.75 -0.25 -0.25   -2.45  0.55 -0.35   -2.35  0.35  0.25
                # 16..19: +Z Arm tip
                 0.35 -0.65  2.55   -0.25 -0.35  2.75   -0.35  0.45  2.45    0.25  0.25  2.35
                # 20..23: -Z Arm tip
                -0.35 -0.65 -2.55    0.25 -0.35 -2.75    0.35  0.45 -2.45   -0.25  0.25 -2.35
                # 24..27: Central Spire Crown (y = 1.65)
                -0.32  1.65 -0.32    0.32  1.65 -0.32    0.32  1.65  0.32   -0.32  1.65  0.32
            ]
            "varying color Cs" [
                # 0..3: Deep Violet-Blue Base
                0.22 0.18 0.65   0.22 0.18 0.65   0.22 0.18 0.65   0.22 0.18 0.65
                # 4..7: Coral Magenta Hub
                0.85 0.25 0.55   0.85 0.25 0.55   0.85 0.25 0.55   0.85 0.25 0.55
                # 8..11: +X Arm Golden-Orange Tip
                1.00 0.65 0.15   1.00 0.78 0.20   1.00 0.65 0.15   1.00 0.55 0.20
                # 12..15: -X Arm Turquoise-Cyan Tip
                0.10 0.85 0.78   0.15 0.95 0.85   0.10 0.85 0.78   0.15 0.75 0.70
                # 16..19: +Z Arm Warm Coral-Red Tip
                0.98 0.32 0.25   1.00 0.45 0.30   0.98 0.32 0.25   0.92 0.28 0.22
                # 20..23: -Z Arm Lime-Emerald Tip
                0.35 0.92 0.38   0.45 0.98 0.42   0.35 0.92 0.38   0.28 0.82 0.32
                # 24..27: Luminous Pearl-Yellow Spire Apex
                1.00 0.92 0.45   1.00 0.92 0.45   1.00 0.92 0.45   1.00 0.92 0.45
            ]
    AttributeEnd

    # =========================================================================
    # Secondary Subdivision Mesh: Genus-1 Toroidal Sea Anemone Ring (Back Left)
    # =========================================================================
    AttributeBegin
        Attribute "identifier" "name" ["SubdivToroidalAnemone"]
        Translate -2.1 -0.55 -1.6
        Rotate 35 1 0 0
        Rotate 20 0 1 0
        Color [0.95 0.45 0.68]
        Surface "plastic" "Ka" [0.2] "Kd" [0.68] "Ks" [0.85] "roughness" [0.06]

        # 16-vertex, 16-quad Genus-1 Torus Cage
        SubdivisionMesh "catmull-clark"
            [4 4 4 4  4 4 4 4  4 4 4 4  4 4 4 4]
            [
                # Outer wall (4 quads)
                0 1 5 4     1 2 6 5     2 3 7 6     3 0 4 7
                # Top rim (4 quads)
                4 5 13 12   5 6 14 13   6 7 15 14   7 4 12 15
                # Inner hole wall (4 quads)
                12 13 9 8   13 14 10 9  14 15 11 10 15 12 8 11
                # Bottom rim (4 quads)
                8 9 1 0     9 10 2 1    10 11 3 2   11 8 0 3
            ]
            ["interpolateboundary"] [0 0] [] []
            "P" [
                # 0..3: Outer bottom (r=1.2, y=-0.4)
                -1.2 -0.4 -1.2    1.2 -0.4 -1.2    1.2 -0.4  1.2   -1.2 -0.4  1.2
                # 4..7: Outer top (r=1.3, y=0.4)
                -1.3  0.4 -1.3    1.3  0.4 -1.3    1.3  0.4  1.3   -1.3  0.4  1.3
                # 8..11: Inner bottom (r=0.48, y=-0.4)
                -0.48 -0.4 -0.48  0.48 -0.4 -0.48  0.48 -0.4 0.48  -0.48 -0.4 0.48
                # 12..15: Inner top (r=0.52, y=0.4)
                -0.52  0.4 -0.52  0.52  0.4 -0.52  0.52  0.4 0.52  -0.52  0.4 0.52
            ]
    AttributeEnd

WorldEnd
