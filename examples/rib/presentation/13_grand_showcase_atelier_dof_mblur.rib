            [
                0 3 2 1
                0 1 5 4   1 2 6 5   2 3 7 6   3 0 4 7
                4 5 9 8   5 6 10 9  6 7 11 10 7 4 8 11
                8 9 10 11
            ]
            ["interpolateboundary" "crease" "crease" "corner" "hole"]
            [
                0 0
                5 1
                5 1
                4 1
                1 0
            ]
            [
                0 1 2 3 0
                4 5 6 7 4
                8 9 10 11
                5
            ]
            [
                5.0
                3.5
                4.5
            ]
            "P" [
                -0.85 -1.70 -0.85    0.85 -1.70 -0.85    0.85 -1.70  0.85   -0.85 -1.70  0.85
                -1.35  0.00 -1.35    1.35  0.00 -1.35    1.35  0.00  1.35   -1.35  0.00  1.35
                -0.65  1.65 -0.65    0.65  1.65 -0.65    0.65  1.65  0.65   -0.65  1.65  0.65
            ]
    AttributeEnd

    # =========================================================================
