    # =========================================================================
    AttributeBegin
        Attribute "identifier" "name" ["GrandAtelierBlobby"]
        Translate 2.25 -0.45 -0.15
        Surface "plastic" "Ka" [0.22] "Kd" [0.68] "Ks" [0.92] "roughness" [0.04]

        Blobby 5
            [
                1001 0
