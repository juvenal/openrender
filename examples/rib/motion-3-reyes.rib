##RenderMan RIB-Structure 1.1
version 3.03
Display "motion-3-reyes.tif" "file" "rgba"
Projection "perspective" "fov" 45
Hider "reyes"
Format 400 300 1
PixelSamples 3 3
#DepthOfField 2 1 5
Shutter 0 1

Translate 0 0 10
MotionBegin [0 1]
  Rotate 0 0 0 1
  Rotate 90 0 0 1
MotionEnd
Rotate -90 1 0 0

WorldBegin
  Color 0 1 0
  Cone 1.5 0.75 360

  Color 1 0 0
  Translate -4 0 0
  Cone 1.5 1 360

  Color 0 0 1
  Translate 7 1 0
  Cone 1.5 0.25 360
WorldEnd
