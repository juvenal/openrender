##RenderMan RIB-Structure 1.0
version 3.03
# Spec 021 (T010): csg-nurbs-sphere-union-raytrace.rib with its open NURBS sheet removed and
# no solid block: what that scene must render once the open operand contributes nothing.
Hider "raytrace"
PixelSamples 4 4
Display "csg-nurbs-sheet-expected-raytrace.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" 40
Clipping 0.1 1000
Translate 0 0 5
Rotate -25 1 0 0
Rotate 30 0 1 0
WorldBegin
    LightSource "ambientlight" 1 "intensity" [0.15]
    LightSource "distantlight" 2 "intensity" [0.9] "from" [5 5 -5] "to" [0 0 0]
    Color [0.7 0.7 0.8]
    Surface "plastic"
    Sides 2
    Sphere 0.7 -0.7 0.7 360
WorldEnd
