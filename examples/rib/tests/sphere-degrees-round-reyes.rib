##RenderMan RIB-Structure 1.0
# GitHub issue #3 (spec 017, US4) regression: degrees()/round() silently
# no-op under the JIT. Pure math, not stochastic -- no numthreads
# requirement.
version 3.03
Hider "reyes"
Option "shaderformat" "default" ["rslo"]
Display "sphere-degrees-round-reyes.tif" "file" "rgba"
Projection "perspective"
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  Surface "degrees_round_probe"
  Sphere 1 -1 1 360
WorldEnd
