##RenderMan RIB-Structure 1.0
version 3.03
# Ray-origin self-hit guard (fix/ray-origin-self-hit): a lone sphere gathers
# and computes occlusion over the hemisphere around its normal. A convex
# surface can not see itself, so every ray must miss and the image must be
# black; see shaders/ray_self_hit_probe.sl.
Hider "reyes"
Display "sphere-ray-self-hit-reyes-slo.tif" "file" "rgb"
Format 160 120 1
Projection "perspective" "fov" 30
Translate 0 0 6
WorldBegin
  Attribute "visibility" "diffuse" [1]
  Attribute "visibility" "int specular" [1]
  Attribute "shade" "shaderformat" ["slo"]
  Surface "ray_self_hit_probe" "samples" [64]
  Sphere 1 -1 1 360
WorldEnd
