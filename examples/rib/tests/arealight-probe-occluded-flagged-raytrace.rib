##RenderMan RIB-Structure 1.0
# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLightProbe_Occluded (flagged): the quad probe scene plus a wall at x = 1.5 (y in [-3, 3], z in [0, 5]) between the emitter and
# every receiver pixel, outside the camera window. The wall carries Attribute "visibility" "int transmission" [1]: it casts the area light's shadow, every pixel reads 0.
version 3.03
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "arealight-probe-occluded-flagged-raytrace.tif" "file" "rgba"
Format 8 8 1
Projection "orthographic"
Clipping 0.1 100
WorldBegin
  AttributeBegin
    AreaLightSource "arealight" 1 "float intensity" [10]
    Surface "constant"
    Polygon "P" [3 -1 1  3 -1 3  3 1 3  3 1 1]
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Attribute "visibility" "int transmission" [1]
    Surface "matte"
    Polygon "P" [1.5 -3 0  1.5 -3 5  1.5 3 5  1.5 3 0]
  AttributeEnd
  AttributeBegin
    Surface "al_surface_matte"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
