##RenderMan RIB-Structure 1.0
# Spec 035 (closure tree and BSDF), generated by specs/035-closure-tree-bsdf/tools/gen_scenes.py: do not edit.
# closures-instancing: ObjectBegin/ObjectInstance carrying the mode and a Bxdf. An instance takes the attributes current at
# ObjectInstance (RISpec 3.2 section 5.10), so the mode and the Bxdf are bound at the instance, never inside the object block (a Bxdf
# statement there is refused).
version 3.03
Hider "zbuffer"
PixelSamples 2 2
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "closures-instancing-zbuffer.tif" "file" "rgba"
Format 16 16 1
Projection "perspective" "fov" [40]
Clipping 0.1 1000
Translate 0 0 7
WorldBegin
  LightSource "distantlight" 1 "intensity" 1.2 "from" [0 0 0] "to" [0.3 -0.3 1]
  ObjectBegin 1
    Sphere 1 -1 1 360
  ObjectEnd
  AttributeBegin
    Translate -1.6 0 0
    Color [0.9 0.3 0.2]
    Attribute "shade" "closuremode" ["both"]
    Bxdf "plastic"
    ObjectInstance 1
  AttributeEnd
  AttributeBegin
    Translate 1.6 0 0
    Color [0.2 0.3 0.9]
    Attribute "shade" "closuremode" ["closures"]
    Surface "matte"
    ObjectInstance 1
  AttributeEnd
WorldEnd
