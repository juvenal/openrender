##RenderMan RIB-Structure 1.0
version 3.03
# Full torus (axis z) partly hidden behind a sphere, and a second torus behind
# the camera: raytrace vs REYES parity for CToroid::intersect
Hider "reyes"
Display "torus-reyes.tif" "file" "rgba"
Format 200 200 1
PixelSamples 4 4
Projection "perspective" "fov" 40
Clipping 0.1 1000
Translate 0 0 5
Rotate -60 1 0 0
WorldBegin
    LightSource "ambientlight" 1 "intensity" [0.15]
    LightSource "distantlight" 2 "intensity" [0.9] "from" [-2 3 5] "to" [0 0 0]
    Surface "matte"
    Color [1 0.6 0.2]
    Torus 1 0.3 0 360 360
    # Partly in front of the torus: a raytraced torus hit must not replace the
    # nearer sphere hit (the intersector's ray-interval check)
    TransformBegin
        Translate 0.2 1.82 -0.3
        Color [0.2 0.4 1]
        Sphere 0.35 -0.35 0.35 360
    TransformEnd
    # Behind the camera, on the optical axis, its axis along the view: every
    # central camera ray's line crosses it at t < 0. Nothing of it may render
    # (the intersector's ray-origin check)
    TransformBegin
        Translate 0 6.062 -3.5
        Rotate 60 1 0 0
        Color [1 0 0]
        Torus 0.5 0.12 0 360 360
    TransformEnd
WorldEnd
