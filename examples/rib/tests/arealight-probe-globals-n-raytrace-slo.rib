##RenderMan RIB-Structure 1.0
# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLightProbe_Globals (n): the emitter (x = 3, y in [1, 3], z in [1, 3], facing -x, area 4) under al_light_n;
# the receiver (al_surface_lightsum) sums Cl over the light's samples, each weighted by 1 / (n p_A) = A / n.
# Cl = (N + 1) / 2 of the light-surface N = (-1, 0, 0): the receiver sums A * (0, 0.5, 0.5) = (0, 2, 2) exactly (N is constant on the quad). The receiver's N = (0, 0, -1) gives (2, 2, 0) on a classic run.
# Probed at pixel (0, 0).
version 3.03
Option "shaderformat" "default" ["slo"]
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "arealight-probe-globals-n-raytrace-slo.tif" "file" "rgba"
Format 8 8 1
Projection "orthographic"
Clipping 0.1 100
WorldBegin
  AttributeBegin
    AreaLightSource "al_light_n" 1 
    Surface "constant"
    Polygon "P" [3 1 1  3 1 3  3 3 3  3 3 1]
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Attribute "shade" "shaderformat" ["rslo"]
    Surface "al_surface_lightsum"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
