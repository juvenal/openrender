##RenderMan RIB-Structure 1.0
# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLightProbe_DiskIrradiance: a Lambertian plane (al_surface_matte, z = 4) under a disk (radius 1.2, centre (3, 0, 2), in the plane z = 2 facing +z toward the receiver)
# running the SHIPPED arealight shader (intensity 10) with 1024 samples (Attribute "arealight" "int samples"): the renderer adds
# 1/(n p_A) and the visibility only (Decision A), so the pixel is  I * integral cos_e cos_r / r^2 dA.
# Closed form on the disk's axis: E = I pi R^2 / (R^2 + d^2); the probed pixels are off axis, so the expected values are the
# polar quadrature of probe_expected.py (checked against the on-axis closed form by quadric_self_test()).
# Expected (probe_expected.py), the same in .rslo and .slo:
#   pixel (3, 3): expected 1.068318581, tolerance 0.074870262 (4 sigma_1 / sqrt(1024), sigma_1 = 0.598962096)
#   pixel (1, 2): expected 0.674959314, tolerance 0.044203652 (4 sigma_1 / sqrt(1024), sigma_1 = 0.353629214)
#   pixel (6, 5): expected 2.093298695, tolerance 0.154508416 (4 sigma_1 / sqrt(1024), sigma_1 = 1.236067329)
version 3.03
Option "shaderformat" "default" ["slo"]
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "arealight-probe-disk-raytrace-slo.tif" "file" "rgba"
Format 8 8 1
Projection "orthographic"
Clipping 0.1 100
WorldBegin
  AttributeBegin
    Attribute "arealight" "int samples" [1024]
    AreaLightSource "arealight" 1 "float intensity" [10]
    Surface "constant"
    Translate 3 0 2
    Disk 0 1.2 360
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Surface "al_surface_matte"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
