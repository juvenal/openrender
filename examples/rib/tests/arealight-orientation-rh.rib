##RenderMan RIB-Structure 1.0
# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLight_Orientation (rh): the soft quad emitter with Orientation "rh" before it: the emitting side follows the orientation; pixel (0, 127) reads 0.000000000.
# Derived by reading RiOrientation, not by trial: "rh" sets ATTRIBUTES_FLAGS_INSIDE (the default "lh" has it clear), the same flag one ReverseOrientation sets,
# so the quad emits to the other side and the receiver, lit in the unflipped case, is dark: the value is 0, the same as arealight-orientation-reversed.
version 3.03
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "arealight-orientation-rh.tif" "file" "rgba"
Format 256 256 1
Projection "orthographic"
Clipping 0.1 100
WorldBegin
  AttributeBegin
    Attribute "arealight" "int samples" [64]
    AreaLightSource "arealight" 1 "float intensity" [40]
    Surface "constant"
    Orientation "rh"
    Polygon "P" [3 -0.25 1.75  3 -0.25 2.25  3 0.25 2.25  3 0.25 1.75]
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Surface "al_surface_matte"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
