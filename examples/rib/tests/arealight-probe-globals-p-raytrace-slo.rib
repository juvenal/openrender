##RenderMan RIB-Structure 1.0
# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLightProbe_Globals (p): the emitter (x = 3, y in [1, 3], z in [1, 3], facing -x, area 4) under al_light_p;
# the receiver (al_surface_lightsum) sums Cl over the light's samples, each weighted by 1 / (n p_A) = A / n.
# Cl = the light-surface P: the receiver sums A * mean(P_sample) = A * centroid = (12, 8, 8); x is exact (the quad is in x = 3), y and z carry sampling noise. The receiver's own P has x near 0, so a classic run reads about (0, ., 16).
# Probed at pixel (0, 0).
version 3.03
Option "shaderformat" "default" ["slo"]
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "arealight-probe-globals-p-raytrace-slo.tif" "file" "rgba"
Format 8 8 1
Projection "orthographic"
Clipping 0.1 100
WorldBegin
  AttributeBegin
    AreaLightSource "al_light_p" 1 
    Surface "constant"
    Polygon "P" [3 1 1  3 1 3  3 3 3  3 3 1]
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Attribute "shade" "shaderformat" ["rslo"]
    Surface "al_surface_lightsum"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
