##RenderMan RIB-Structure 1.0
version 3.03
# T037 (Polish, SC-006): a SolidBegin "primitive" block containing a nested
# SolidBegin/SolidEnd. A "primitive" block is a CSG leaf (FR-019) and MUST
# NOT contain a nested solid block. Expected: exactly one CODE_BADTOKEN
# diagnostic ("SolidBegin/SolidEnd cannot be nested inside a \"primitive\"
# solid block") from csgValidateNestedSolidBegin()
# (src/ri/csgTree.cpp) -- the renderer must not crash. The inner
# SolidBegin/SolidEnd is rejected but the outer primitive's own geometry
# still renders.
Hider "raytrace"
Display "csg-malformed-nested-in-primitive.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" 40
Clipping 0.1 1000
Translate 0 0 4
Rotate -20 1 0 0
Rotate 25 0 1 0
WorldBegin
    LightSource "ambientlight" 1 "intensity" [0.15]
    LightSource "distantlight" 2 "intensity" [0.9] "from" [5 5 -5] "to" [0 0 0]
    Color [0.7 0.7 0.8]
    Surface "matte"
    SolidBegin "primitive"
        Sphere 1 -1 1 360
        SolidBegin "union"
            SolidBegin "primitive"
                Sphere 0.5 -0.5 0.5 360
            SolidEnd
        SolidEnd
    SolidEnd
WorldEnd
