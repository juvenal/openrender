##RenderMan RIB-Structure 1.0
# See sphere-clearlighting-reyes.rib -- no numthreads requirement (not
# stochastic).
version 3.03
Hider "reyes"
Display "sphere-clearlighting-reyes-slo.tif" "file" "rgba"
Projection "perspective"
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  Attribute "shade" "shaderformat" ["slo"]
  LightSource "distantlight" 1 "intensity" [0.9] "from" [2 2 -2] "to" [0 0 0]
  Surface "debug_clearlighting_probe"
  Sphere 1 -1 1 360
WorldEnd
