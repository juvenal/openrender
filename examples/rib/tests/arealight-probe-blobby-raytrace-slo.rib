##RenderMan RIB-Structure 1.0
# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLightProbe_BlobbyIrradiance: a blobby (one ellipsoid field, matrix scale 1.5: surface radius 0.7695361, centre (3, 0, 2)) as the emitter under the
# shipped arealight (intensity 10), 8192 samples. RiBlobby derives a polygon mesh and hands it to addObject, so the blobby emits through that mesh.
# Expected: the closed form of a sphere of that radius, E = I pi (r / d)^2 cos(theta_c), the tolerance 4 sigma_1 / sqrt(n) plus 3 % of E for the
# facets of the derived mesh (pre-declared; a blobby that did not emit reads 0). Expected (probe_expected.py):
#   pixel (3, 3): expected 0.727285551, tolerance 0.076376725 (4 sigma_1 / sqrt(8192), sigma_1 = 1.234510201)
#   pixel (1, 2): expected 0.517934865, tolerance 0.053320589 (4 sigma_1 / sqrt(8192), sigma_1 = 0.854921363)
#   pixel (6, 5): expected 1.216315770, tolerance 0.132402877 (4 sigma_1 / sqrt(8192), sigma_1 = 2.170272590)
version 3.03
Option "shaderformat" "default" ["slo"]
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "arealight-probe-blobby-raytrace-slo.tif" "file" "rgba"
Format 8 8 1
Projection "orthographic"
Clipping 0.1 100
WorldBegin
  AttributeBegin
    Attribute "arealight" "int samples" [8192]
    AreaLightSource "arealight" 1 "float intensity" [10]
    Surface "constant"
    Translate 3 0 2
    Blobby 1 [1001 0] [1.5 0 0 0  0 1.5 0 0  0 0 1.5 0  0 0 0 1] [""]
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Surface "al_surface_matte"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
