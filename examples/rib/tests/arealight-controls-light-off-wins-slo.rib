##RenderMan RIB-Structure 1.0
# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLight_Controls_Render (off at the light level wins): the light's scope has mode off, the receiver asks for mode full:
# off at any level turns the light off for that receiver: every pixel is dark.
version 3.03
Option "shaderformat" "default" ["slo"]
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "arealight-controls-light-off-wins-slo.tif" "file" "rgba"
Format 8 8 1
Projection "orthographic"
Clipping 0.1 100
WorldBegin
  AttributeBegin
    Attribute "arealight" "string mode" ["off"]
    AreaLightSource "arealight" 1 "float intensity" [10]
    Surface "constant"
    Polygon "P" [3 -1 1  3 -1 3  3 1 3  3 1 1]
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Attribute "arealight" "string mode" ["full"]
    Surface "al_surface_matte"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
