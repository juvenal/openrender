##RenderMan RIB-Structure 1.0
# Grid T-junction cracks (#51): coverage-alpha-sides2-reyes.rib with default
# (non-binary) dicing. Three Sides 2 spheres of opacity 0.5, one sample at each
# pixel centre. Every covered pixel's alpha must be 1 - 0.5^k, k counting each
# sphere's front and back along the ray, as test_depth_analytic computes it
# from the spheres' camera-space
# positions: (0, 0, 6) r 1.5, (0.5, 0.3, 3) r 0.5 and (1.9, -1, 4.5) r 0.6. A
# sample on a micropolygon edge shared by two quads must be counted once, and
# so must a sample where two grids diced at different rates meet: their
# boundary polylines differ, leaving overlap and gap slivers (#51).
version 3.03
Hider "reyes" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Display "coverage-alpha-sides2-tjunction-reyes.tif" "file" "a" "quantize" [0 0 0 0]
Projection "perspective" "fov" 45
Format 160 120 1
Translate 0 0 6

WorldBegin
  Surface "constant"
  Opacity 0.5 0.5 0.5
  Sides 2
  Sphere 1.5 -1.5 1.5 360

  AttributeBegin
    Translate 0.5 0.3 -3
    Sphere 0.5 -0.5 0.5 360
  AttributeEnd

  AttributeBegin
    Translate 1.9 -1 -1.5
    Sphere 0.6 -0.6 0.6 360
  AttributeEnd
WorldEnd
