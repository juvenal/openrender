##RenderMan RIB-Structure 1.0
# GitHub issue #3 (spec 017, US5) regression: textureinfo() silently
# no-op under the JIT. Deterministic file-metadata lookup, not
# stochastic -- no numthreads requirement. Needs
# textureinfo_probe.tex copied into the CWD (tests/visual/CMakeLists.txt).
version 3.03
Hider "reyes"
Option "shaderformat" "default" ["rslo"]
Display "sphere-textureinfo-reyes.tif" "file" "rgba"
Projection "perspective"
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  Surface "textureinfo_probe"
  Sphere 1 -1 1 360
WorldEnd
