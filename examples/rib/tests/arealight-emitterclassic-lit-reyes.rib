  AttributeBegin
    AreaLightSource "arealight" 1 "float intensity" [10]
    Color [0.8 0.4 0.2]
    Surface "al_surface_matte"
    Polygon "P" [-0.196891 -0.8 3.175  -0.803109 -0.8 2.825  -0.803109 0.8 2.825  -0.196891 0.8 3.175]
    Polygon "P" [0.803109 -0.8 2.825  0.196891 -0.8 3.175  0.196891 0.8 3.175  0.803109 0.8 2.825]
  AttributeEnd
  Illuminate 1 1
  Illuminate 2 1
WorldEnd
