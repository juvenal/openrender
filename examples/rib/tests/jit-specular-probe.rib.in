##RenderMan RIB-Structure 1.0
# GitHub #111 (ShadingParity_JitSpecular_*, ShadingParity_JitSpecularEngaged_*):
# one sphere shaded by jit_specular_probe, whose output is specular() alone,
# running as @FORMAT@ (the lights always run as .rslo, so the two formats
# differ only in the probe). Generated by tests/visual/CMakeLists.txt.
# Sampler "sobol", single-threaded, one centre sample per pixel, so the
# shading is the only source of difference.
version 3.03
Hider "@HIDER@" "jitter" [0]
Option "sampling" "sampler" ["sobol"]
Option "sampling" "seed" [0]
Option "shaderformat" "default" ["rslo"]
Option "limits" "numthreads" [1]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "@OUTPUT@" "file" "rgba"
@PROJECTION@
Format 48 48 1
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  LightSource "distantlight" 1 "intensity" [1] "from" [2 4 -2] "to" [0 0 0]
@LIGHTS@
  Attribute "shade" "shaderformat" ["@FORMAT@"]
  Surface "jit_specular_probe" @PARAMS@
  Sphere 1 -1 1 360
WorldEnd
