##RenderMan RIB-Structure 1.0
# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLightProbe_Facing (receiver): the receiver al_surface_matte_n keeps N = +z (away from the emitter, no faceforward):
# back-facing, so diffuse() is 0 for every sample. The estimator contributes 0, never a negative or non-finite value.
version 3.03
Option "shaderformat" "default" ["slo"]
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "arealight-probe-facing-receiver-raytrace-slo.tif" "file" "rgba"
Format 8 8 1
Projection "orthographic"
Clipping 0.1 100
WorldBegin
  AttributeBegin
    AreaLightSource "arealight" 1 "float intensity" [10]
    Surface "constant"
    Polygon "P" [3 -1 1  3 -1 3  3 1 3  3 1 1]
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Surface "al_surface_matte_n"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
