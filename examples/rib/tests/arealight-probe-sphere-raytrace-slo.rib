##RenderMan RIB-Structure 1.0
# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLightProbe_SphereIrradiance: a Lambertian plane (al_surface_matte, z = 4) under a sphere (radius 0.8, centre (3, 0, 2); the points facing away from a receiver point are cut by the light's own illuminate cone)
# running the SHIPPED arealight shader (intensity 10) with 8192 samples (Attribute "arealight" "int samples"): the renderer adds
# 1/(n p_A) and the visibility only (Decision A), so the pixel is  I * integral cos_e cos_r / r^2 dA.
# Closed form: E = I pi (r / d)^2 cos(theta_c), theta_c the angle between the receiver normal and the direction to the centre (probe_expected.py).
# Expected (probe_expected.py), the same in .rslo and .slo:
#   pixel (3, 3): expected 0.786007926, tolerance 0.059673345 (4 sigma_1 / sqrt(8192), sigma_1 = 1.350253661)
#   pixel (1, 2): expected 0.559753880, tolerance 0.041273567 (4 sigma_1 / sqrt(8192), sigma_1 = 0.933914222)
#   pixel (6, 5): expected 1.314523346, tolerance 0.105145751 (4 sigma_1 / sqrt(8192), sigma_1 = 2.379176753)
version 3.03
Option "shaderformat" "default" ["slo"]
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "arealight-probe-sphere-raytrace-slo.tif" "file" "rgba"
Format 8 8 1
Projection "orthographic"
Clipping 0.1 100
WorldBegin
  AttributeBegin
    Attribute "arealight" "int samples" [8192]
    AreaLightSource "arealight" 1 "float intensity" [10]
    Surface "constant"
    Translate 3 0 2
    Sphere 0.8 -0.8 0.8 360
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Surface "al_surface_matte"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
