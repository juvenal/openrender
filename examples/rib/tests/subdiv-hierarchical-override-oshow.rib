##RenderMan RIB-Structure 1.0
version 3.03

# T064 (spec 010-full-subdivision-support, US5): CShow ("oshow:" hider)
# targeting scene for the hierarchical-override capability. See
# examples/rib/tests/parity/motion-subdiv-translate-oshow.rib's header
# comment for why this is authored-but-not-required. Otherwise identical to
# examples/rib/tests/subdiv-hierarchical-override-raytrace.rib.
Hider "oshow:none"
PixelSamples 4 4
Display "subdiv-hierarchical-override-oshow.tif" "file" "rgba"
Projection "perspective" "fov" 45
Format 320 240 1
Translate 0 0 4

WorldBegin
  LightSource "ambientlight" 1 "intensity" [0.15]
  LightSource "distantlight" 2 "intensity" [0.9] "lightcolor" [1 .95 .9] "from" [20 30 25] "to" [0 0 0]
  LightSource "distantlight" 3 "intensity" [0.35] "lightcolor" [.7 .8 1] "from" [-25 10 -20] "to" [0 0 0]

  Sides 2
  Color [0.7 0.7 0.8]
  Surface "matte"
  HierarchicalSubdivisionMesh "catmull-clark"
  [ 4 4 4 4 4 4 4 4 4 ]
  [
    0 1 5 4
    1 2 6 5
    2 3 7 6
    4 5 9 8
    5 6 10 9
    6 7 11 10
    8 9 13 12
    9 10 14 13
    10 11 15 14
  ]
  ["interpolateboundary"] [0 0] [] []
  [4] [0] ["hole"] [0.0]
  "P" [
    -0.6  0.6 0   -0.2  0.6 0    0.2  0.6 0    0.6  0.6 0
    -0.6  0.2 0   -0.2  0.2 0    0.2  0.2 0    0.6  0.2 0
    -0.6 -0.2 0   -0.2 -0.2 0    0.2 -0.2 0    0.6 -0.2 0
    -0.6 -0.6 0   -0.2 -0.6 0    0.2 -0.6 0    0.6 -0.6 0
  ]
WorldEnd
