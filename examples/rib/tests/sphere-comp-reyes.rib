##RenderMan RIB-Structure 1.0
# GitHub issue #3 (spec 017, US1) regression: comp() silently no-ops under
# the JIT. Not raytraced/stochastic (pure indexed reads), so no
# numthreads 1 requirement, unlike the other US1 probes.
version 3.03
Hider "reyes"
Option "shaderformat" "default" ["rslo"]
Display "sphere-comp-reyes.tif" "file" "rgba"
Projection "perspective"
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  Surface "comp_probe"
  Sphere 1 -1 1 360
WorldEnd
