##RenderMan RIB-Structure 1.0
# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLightProbe_PatchIrradiance: the quad probe (a Lambertian plane z = 4 under a 2 x 2 emitter in x = 3 facing -x, the shipped arealight,
# intensity 10, n = 16) with the emitter written as RiPatch "bilinear" instead of a polygon: P00 P10 P01 P11 = the polygon's p0 p1 p3 p2, so
# dPdu x dPdv is -x as the polygon's normal is. Planar, so the exact quad sampler; the closed form is the quad's. Expected (probe_expected.py):
#   pixel (3, 3): expected 1.178695069, tolerance 0.091576564 (4 sigma_1 / sqrt(16), sigma_1 = 0.091576564)
#   pixel (1, 2): expected 0.879695774, tolerance 0.081849551 (4 sigma_1 / sqrt(16), sigma_1 = 0.081849551)
#   pixel (6, 5): expected 1.782001963, tolerance 0.318020023 (4 sigma_1 / sqrt(16), sigma_1 = 0.318020023)
version 3.03
Option "shaderformat" "default" ["slo"]
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "arealight-probe-patch-raytrace-slo.tif" "file" "rgba"
Format 8 8 1
Projection "orthographic"
Clipping 0.1 100
WorldBegin
  AttributeBegin
    AreaLightSource "arealight" 1 "float intensity" [10]
    Surface "constant"
    Patch "bilinear" "P" [3 -1 1  3 -1 3  3 1 1  3 1 3]
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Surface "al_surface_matte"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
