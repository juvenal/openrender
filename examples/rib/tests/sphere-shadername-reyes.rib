##RenderMan RIB-Structure 1.0
# GitHub issue #3 (spec 017, US5) regression: shadername() silently no-op'd
# under the JIT. Deterministic name lookup, not stochastic -- no numthreads
# requirement.
version 3.03
Hider "reyes"
Option "shaderformat" "default" ["rslo"]
Display "sphere-shadername-reyes.tif" "file" "rgba"
Projection "perspective"
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  Surface "shadername_probe"
  Sphere 1 -1 1 360
WorldEnd
