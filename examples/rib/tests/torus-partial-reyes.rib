##RenderMan RIB-Structure 1.0
version 3.03
# Partial torus (phi -45..200, thetamax 270), one-sided: parametric ranges and back-face culling
Hider "reyes"
Display "torus-partial-reyes.tif" "file" "rgba"
Format 200 200 1
PixelSamples 4 4
Projection "perspective" "fov" 40
Clipping 0.1 1000
Translate 0 0 5
Rotate -60 1 0 0
WorldBegin
    LightSource "ambientlight" 1 "intensity" [0.15]
    LightSource "distantlight" 2 "intensity" [0.9] "from" [-2 3 5] "to" [0 0 0]
    Surface "matte"
    Color [0.3 0.9 0.4]
    # thetamax 270 and a tube cut from -45 to 200 degrees, one-sided: the
    # intersector must honour every parametric range, and cull back faces as
    # the REYES dicer does
    Torus 1 0.3 -45 200 270
WorldEnd
