##RenderMan RIB-Structure 1.0
# Spec 039, Phase 6 (Sampling_ThreadSweep): a hand-written copy of
# sphere-gather-reyes.rib with the sampler option added.
# Under the sobol sampler the render must not depend on the thread count
# (-t:1 against -t:4, bit for bit); test_render_compare runs both. The Quantize
# line makes the output 32-bit float, which the driver reads.
version 3.03
Option "sampling" "sampler" ["sobol"]
Quantize "rgba" 0 0 0 0
Hider "reyes"
Display "sampling-threadsweep-sphere-gather.tif" "file" "rgba"
Projection "perspective"
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  LightSource "distantlight" 1 "intensity" [1] "from" [2 4 -2] "to" [0 0 0]
  TransformBegin
    Translate 0 -1.5 0
    Attribute "visibility" "int specular" [1]
    Color 0.8 0.8 0.8
    Surface "constant"
    Polygon "P" [-5 0 -5  5 0 -5  5 0 5  -5 0 5]
  TransformEnd
  Attribute "visibility" "int specular" [1]
  Surface "gather_named_probe"
  Sphere 1 -1 1 360
WorldEnd
