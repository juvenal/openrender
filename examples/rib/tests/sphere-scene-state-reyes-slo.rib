##RenderMan RIB-Structure 1.0
# See sphere-scene-state-reyes.rib -- no numthreads requirement (not
# stochastic).
version 3.03
Hider "reyes"
Display "sphere-scene-state-reyes-slo.tif" "file" "rgba"
Projection "perspective"
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  Attribute "shade" "shaderformat" ["slo"]
  Surface "scene_state_probe"
  Sphere 1 -1 1 360
WorldEnd
