##RenderMan RIB-Structure 1.0
# See sphere-visibility-reyes.rib for why numthreads 1 is required.
version 3.03
Hider "reyes"
# Spec 039 (T099): the one-thread pin described above was removed. Every draw is keyed by
# the sample's identity, so the render is bit-identical at any thread count.
Display "sphere-visibility-reyes-slo.tif" "file" "rgba"
Projection "perspective"
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  Attribute "shade" "shaderformat" ["slo"]
  Surface "visibility_probe"
  Sphere 1 -1 1 360
WorldEnd
