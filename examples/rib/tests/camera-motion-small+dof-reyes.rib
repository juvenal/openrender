##RenderMan RIB-Structure 1.1
version 3.03
Hider "stochastic"
Display "camera-motion-small+dof-reyes.tif" "file" "rgba"
Projection "perspective" "fov" 45
Format 800 600 1
DepthOfField 2 1 5
Shutter 0 1

MotionBegin [0 1]
  Translate 0 0 5
  Translate -0.05 0 5
MotionEnd
Rotate -110 1 0 0
Rotate 70 0 0 1

WorldBegin
  Color 0 1 0
  Cone 1.5 0.75 360

  Color 1 0 0
  Translate -4 0 0
  Cone 1.5 1 360

  Color 0 0 1
  Translate 7 1 0
  Cone 1.5 0.25 360
WorldEnd
