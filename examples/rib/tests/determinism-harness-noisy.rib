##RenderMan RIB-Structure 1.0
# Spec 039, Phase 7 (DeterminismHarness_detects_difference): a scene that is NOT thread
# independent under the Legacy sampler on purpose: random() shading, no sampler option and no
# numthreads pin, so the render varies with the thread count. The harness must report it as
# different (exit code 1).
version 3.03
Hider "reyes" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "determinism-harness-noisy.tif" "file" "rgba"
Projection "perspective"
Format 320 240 1
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  Surface "random_probe"
  Sphere 1.8 -1.8 1.8 360
WorldEnd
