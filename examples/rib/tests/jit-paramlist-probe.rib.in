##RenderMan RIB-Structure 1.0
# GitHub #55 (ShadingParity_JitPL*, ShadingParity_JitPLEngaged_*,
# ShadingParity_JitPLLabel_*): one sphere shaded by @PROBE@, whose parameter
# values are set below, running as @FORMAT@ (the light, the floor and the
# occluder always run as .rslo, so the two formats differ only in the probe).
# The floor and the occluder are shaded by @HITSURFACE@. Generated by
# tests/visual/CMakeLists.txt. Sampler "sobol", single-threaded, one centre
# sample per pixel, so the shading is the only source of difference; the
# geometry is that of sampling-jit-probe.rib.in.
version 3.03
Hider "reyes" "jitter" [0]
Option "sampling" "sampler" ["sobol"]
Option "sampling" "seed" [0]
Option "shaderformat" "default" ["rslo"]
Option "limits" "numthreads" [1]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "@OUTPUT@" "file" "rgba"
Projection "perspective"
Format 48 48 1
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  LightSource "distantlight" 1 "intensity" [1] "from" [2 4 -2] "to" [0 0 0]
  Attribute "visibility" "int diffuse" [1] "int specular" [1] "string transmission" ["opaque"]
  AttributeBegin
    Surface "@HITSURFACE@"
    Translate 1.2 0 -0.5
    Sphere 0.9 -0.9 0.9 360
  AttributeEnd
  AttributeBegin
    Surface "@HITSURFACE@"
    Translate 0 -1.5 0
    Polygon "P" [-5 0 -5  5 0 -5  5 0 5  -5 0 5]
  AttributeEnd
  Attribute "shade" "shaderformat" ["@FORMAT@"]
  Surface "@PROBE@" @PARAMS@
  Sphere 1 -1 1 360
WorldEnd
