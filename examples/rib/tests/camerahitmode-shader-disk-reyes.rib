##RenderMan RIB-Structure 1.0
# GitHub #117: camerahitmode "shader" on a disk primitive under the reyes hider.
# camerahitmode_probe returns Ci (0.2 0.4 0.6) and Oi 0.25 and the Opacity attribute is 1, so the centre pixel is
# RGBA (0.2 0.4 0.6 1) under "primitive" (the shader ran, its opacity is replaced) and (0.2 0.4 0.6 0.25) under "shader".
version 3.03
Hider "reyes" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Option "shaderformat" "default" ["rslo"]
Quantize "rgba" 0 0 0 0
Display "camerahitmode-shader-disk-reyes.tif" "file" "rgba"
Format 8 8 1
Projection "perspective" "fov" 30
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  Attribute "shade" "string camerahitmode" ["shader"]
  AttributeBegin
    Surface "camerahitmode_probe"
    Disk 0 1 360
  AttributeEnd
WorldEnd
