##RenderMan RIB-Structure 1.0
# Depth-filter determinism (fix/stochastic-depthfilter-race): the overlapping
# spheres of parity/depthfilter-mid-reyes.rib with jitter off, so sample
# positions do not depend on which thread renders a bucket. Every run, at any
# thread count, must produce the same z, and a pixel with no visible surface
# must read exactly C_INFINITY. See test_depth_determinism.cpp.
version 3.03
Hider "reyes" "jitter" [0]
Option "hider" "depthfilter" "midpoint"
Option "limits" "zthreshold" [0.4 0.4 0.4]
PixelSamples 4 4
Display "depthfilter-determinism-mid.tif" "file" "z"
Projection "perspective" "fov" 45
Format 320 240 1
Translate 0 0 6

WorldBegin
  AttributeBegin
    Color 1 0.2 0.2
    Opacity 0.7 0.7 0.7
    Translate 0.5 0.3 1.5
    Sphere 1.1 -1.1 1.1 360
  AttributeEnd

  AttributeBegin
    Color 0.2 1 0.2
    Opacity 0.5 0.5 0.5
    Translate -0.4 -0.2 0
    Sphere 1.1 -1.1 1.1 360
  AttributeEnd

  AttributeBegin
    Color 0.2 0.2 1
    Opacity 0.35 0.35 0.35
    Translate -0.1 0.1 -1.5
    Sphere 1.1 -1.1 1.1 360
  AttributeEnd
WorldEnd
