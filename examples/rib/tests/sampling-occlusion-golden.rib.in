##RenderMan RIB-Structure 1.0
# Spec 039, T076a (OcclusionGolden_*): occlusion() on a floor and a sphere resting on it, 48 x 48, under the
# sampler @SAMPLER@ with the irradiance cache's maxerror at @MAXERROR@. The render is compared bit
# for bit with a golden made before occlusion() took its directions from the sampler: under the
# Legacy sampler, and with the cache on (maxerror > 0, whose gradients need the nt x np grid),
# that code path must not change. Single-threaded, so the cache fills in a fixed order.
# Generated by tests/visual/CMakeLists.txt.
version 3.03
Hider "raytrace" "jitter" [0]
Option "sampling" "sampler" ["@SAMPLER@"]
Option "sampling" "seed" [1]
Option "shaderformat" "default" ["rslo"]
Option "limits" "numthreads" [1]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "@OUTPUT@" "file" "rgba"
Projection "perspective" "fov" 40
Format 48 48 1
Clipping 0.1 100
Translate 0 0 7
Rotate -35 1 0 0
WorldBegin
  Attribute "irradiance" "float maxerror" [@MAXERROR@]
  Attribute "visibility" "int diffuse" [1]
  Surface "sampling_occlusion_probe" "samples" [16]
  AttributeBegin
    Translate 0 -1.2 0
    Rotate -90 1 0 0
    Disk 0 6 360
  AttributeEnd
  AttributeBegin
    Translate 0 -0.1 0
    Sphere 1.1 -1.1 1.1 360
  AttributeEnd
WorldEnd
