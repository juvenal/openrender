##RenderMan RIB-Structure 1.0
version 3.03
# GitHub issue #3 (spec 017, US1) show-stopper closure: --jit copy of
# examples/rib/quadlight.rib, unchanged except for the added
# Attribute "shade" "shaderformat" ["slo"] line below. quadlight.sl uses
# visibility() for its per-sample soft-shadow test -- the exact function
# whose missing kHandledOpcodes[] entry made this scene render incorrectly
# under --jit (issue #1's original motivating repro for issue #3).
Hider "raytrace"
Display "quadlight-slo.tif" "file" "rgba"
Projection "perspective" "fov" 40
Format 320 240 1
Clipping 0.1 1000
Translate 0 0 12
WorldBegin
    Attribute "shade" "shaderformat" ["slo"]
    LightSource "quadlight" 1 "P0" [3 5 -2] "P1" [5 5 -2]
                "P2" [3 7 -2] "P3" [5 7 -2]
                "intensity" [200] "numSamples" [16]
    AttributeBegin
        Color [0.8 0.8 0.8]
        Surface "matte"
        Translate 0 0 3
        Sphere 1.5 -1.5 1.5 360
    AttributeEnd
    AttributeBegin
        Color [0.7 0.7 0.7]
        Surface "matte"
        Translate 0 -3 0
        Rotate -90 1 0 0
        Disk 0 20 360
    AttributeEnd
WorldEnd
