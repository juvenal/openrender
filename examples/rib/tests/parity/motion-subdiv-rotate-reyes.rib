##RenderMan RIB-Structure 1.0
version 3.03
Hider "reyes"
PixelSamples 4 4
Shutter 0 1
Display "motion-subdiv-rotate-reyes.tif" "file" "rgba"
Projection "perspective" "fov" 45
Format 320 240 1
Translate 0 0 5

WorldBegin
  LightSource "ambientlight" 1 "intensity" [0.3]
  LightSource "finite" 2 "location" [-4 4 -4] "intensity" [0.9]

  AttributeBegin
    Color 0.9 0.3 0.2
    Surface "matte"
    MotionBegin [0 1]
      Rotate 0  0 1 0
      Rotate 75 0 1 0
    MotionEnd
    SubdivisionMesh "catmull-clark"
    [ 4 4 4 4 4 4 ]
    [
      0 3 2 1
      4 5 6 7
      0 1 5 4
      3 7 6 2
      0 4 7 3
      1 2 6 5
    ]
    [] [] [] []
    "P" [
      -0.4 -0.4 -0.4   0.4 -0.4 -0.4   0.4  0.4 -0.4  -0.4  0.4 -0.4
      -0.4 -0.4  0.4   0.4 -0.4  0.4   0.4  0.4  0.4  -0.4  0.4  0.4
    ]
  AttributeEnd
WorldEnd
