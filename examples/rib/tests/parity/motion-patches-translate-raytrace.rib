    Patch "bicubic" "P" [
      -0.6 -0.6 0    -0.2 -0.6 0.3    0.2 -0.6 0.3    0.6 -0.6 0
      -0.6 -0.2 0.3  -0.2 -0.2 0.6    0.2 -0.2 0.6    0.6 -0.2 0.3
      -0.6  0.2 0.3  -0.2  0.2 0.6    0.2  0.2 0.6    0.6  0.2 0.3
      -0.6  0.6 0    -0.2  0.6 0.3    0.2  0.6 0.3    0.6  0.6 0
    ]
  AttributeEnd
WorldEnd
