##RenderMan RIB-Structure 1.0
version 3.03
Hider "reyes"
PixelSamples 4 4
Shutter 0 1
Display "motion-quadrics-deform-reyes.tif" "file" "rgba"
Projection "perspective" "fov" 45
Format 320 240 1
Translate 0 0 5

WorldBegin
  LightSource "ambientlight" 1 "intensity" [0.3]
  LightSource "finite" 2 "location" [-4 4 -4] "intensity" [0.9]

  AttributeBegin
    Color 0.9 0.8 0.2
    Surface "matte"
    MotionBegin [0 1]
      Sphere 0.3 -0.3 0.3 360
      Sphere 0.8 -0.8 0.8 360
    MotionEnd
  AttributeEnd
WorldEnd
