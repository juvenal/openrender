##RenderMan RIB-Structure 1.0
version 3.03
Hider "reyes"
PixelSamples 4 4
Shutter 0 1
Display "motion-polygons-translate-reyes.tif" "file" "rgba"
Projection "perspective" "fov" 45
Format 320 240 1
Translate 0 0 5

WorldBegin
  LightSource "ambientlight" 1 "intensity" [0.3]
  LightSource "finite" 2 "location" [-4 4 -4] "intensity" [0.9]

  AttributeBegin
    Sides 2
    Color 0.2 0.3 0.9
    Surface "matte"
    MotionBegin [0 1]
      Translate -0.6 0 0
      Translate  0.6 0 0
    MotionEnd
    Polygon "P" [-0.5 -0.5 0   0.5 -0.5 0   0.5 0.5 0   -0.5 0.5 0]
  AttributeEnd
WorldEnd
