##RenderMan RIB-Structure 1.0
version 3.03

# T064 (spec 010-full-subdivision-support, US1): CShow ("oshow:" hider)
# targeting scene for the motion-blur capability. Authored as a deliverable
# per FR-014/spec.md's Edge Cases, but NOT required to pass or run -- CShow
# is a separate, pre-existing non-functional gap (its OpenGL visualization
# module was removed from this fork; see src/ri/show.cpp's
# "Opengl wrapper not found" path when CView::handle is NULL). Registered
# under CMake's "not-required" label (see tests/visual/CMakeLists.txt),
# excluded from the standard `ctest -L visual` regression sweep. Otherwise
# identical to examples/rib/tests/parity/motion-subdiv-translate-raytrace.rib.
Hider "oshow:none"
PixelSamples 4 4
Shutter 0 1
Display "motion-subdiv-translate-oshow.tif" "file" "rgba"
Projection "perspective" "fov" 45
Format 320 240 1
Translate 0 0 5

WorldBegin
  LightSource "ambientlight" 1 "intensity" [0.3]
  LightSource "finite" 2 "location" [-4 4 -4] "intensity" [0.9]

  AttributeBegin
    Color 0.9 0.3 0.2
    Surface "matte"
    MotionBegin [0 1]
      Translate -0.6 0 0
      Translate  0.6 0 0
    MotionEnd
    SubdivisionMesh "catmull-clark"
    [ 4 4 4 4 4 4 ]
    [
      0 3 2 1
      4 5 6 7
      0 1 5 4
      3 7 6 2
      0 4 7 3
      1 2 6 5
    ]
    [] [] [] []
    "P" [
      -0.4 -0.4 -0.4   0.4 -0.4 -0.4   0.4  0.4 -0.4  -0.4  0.4 -0.4
      -0.4 -0.4  0.4   0.4 -0.4  0.4   0.4  0.4  0.4  -0.4  0.4  0.4
    ]
  AttributeEnd
WorldEnd
