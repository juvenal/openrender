##RenderMan RIB-Structure 1.0
# Sphere textured from a texture baked (via otexmake) from an RGBE
# (Radiance HDR) source, spec 018 (multi-format texture source decoding),
# T026. Was initially withheld from registration because RGBE (always
# exactly 3-channel RGB) unconditionally hit a pre-existing appendLayer()/
# TIFFTAG_PHOTOMETRIC gap (GitHub issue #18, fixed separately from spec 018
# on fix/texmake-photometric-tag) -- now registered via add_parity_test in
# tests/visual/CMakeLists.txt.
version 3.03
Hider "reyes"
Display "texture-rgbe-reyes.tif" "file" "rgba"
Projection "perspective"
Clipping 1 100000
Translate 0 0 4
WorldBegin
  LightSource "ambientlight" 1 "intensity" [0.3]
  LightSource "distantlight" 2 "intensity" [0.85] "from" [5 5 -5] "to" [0 0 0]
  Surface "paintedplastic" "texturename" ["texture-rgbe-source.tex"]
  Sphere 1 -1 1 360
WorldEnd
