##RenderMan RIB-Structure 1.0
version 3.03
Hider "reyes"
Option "hider" "depthfilter" "average"
Option "limits" "zthreshold" [0.4 0.4 0.4]
PixelSamples 4 4
Display "depthfilter-avg-reyes.tif" "file" "z"
Projection "perspective" "fov" 45
Format 320 240 1
Translate 0 0 6

WorldBegin
  AttributeBegin
    Color 1 0.2 0.2
    Opacity 0.7 0.7 0.7
    Translate 0.5 0.3 1.5
    Sphere 1.1 -1.1 1.1 360
  AttributeEnd

  AttributeBegin
    Color 0.2 1 0.2
    Opacity 0.5 0.5 0.5
    Translate -0.4 -0.2 0
    Sphere 1.1 -1.1 1.1 360
  AttributeEnd

  AttributeBegin
    Color 0.2 0.2 1
    Opacity 0.35 0.35 0.35
    Translate -0.1 0.1 -1.5
    Sphere 1.1 -1.1 1.1 360
  AttributeEnd
WorldEnd
