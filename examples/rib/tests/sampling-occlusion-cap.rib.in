##RenderMan RIB-Structure 1.0
# Spec 039, T076a (OcclusionSampler_*): occlusion() takes its hemisphere directions from the
# sampler by sample index. A floor point is shaded by shaders/sampling_occlusion_probe.sl, run as
# @FORMAT@. 100 units above it a disc of radius 100 tan(30 degrees) blocks the directions within
# 30 degrees of the normal. The shading rays map the sampler's point (u, v) to a direction with
# sin(theta)^2 = u, so that cap is the strip u < 1/4 of the unit square. A (0,2) net of n points
# (n a power of 4) holds exactly n/4 points in that strip, so under sobol or pmj02 the occluded
# fraction is exactly 0.25 for every n; a jittered grid or independent draws give a count that
# varies. The centre pixel looks at the floor point on the disc's axis: an orthographic camera
# over a 0.1 x 0.1 window, jitter 0, one sample per pixel (the pixel footprint, which shifts the
# ray origins, is 0.003 against the disc's 100 units). The disc is invisible to the camera; the
# irradiance cache is off, so the point samples for itself. Generated by tests/visual/CMakeLists.txt.
version 3.03
Hider "raytrace" "jitter" [0]
Option "sampling" "sampler" ["@SAMPLER@"]
Option "sampling" "seed" [@SEED@]
Option "shaderformat" "default" ["rslo"]
Option "limits" "numthreads" [1]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "@OUTPUT@" "file" "rgba"
Projection "orthographic"
ScreenWindow -0.05 0.05 -0.05 0.05
Format 33 33 1
Clipping 1 1000
Translate 0 0 200
WorldBegin
  Attribute "irradiance" "float maxerror" [0]
  AttributeBegin
    Attribute "visibility" "int camera" [0] "int diffuse" [1]
    Translate 0 0 -100
    Disk 0 57.73503 360
  AttributeEnd
  Attribute "shade" "shaderformat" ["@FORMAT@"]
  Surface "sampling_occlusion_probe" "samples" [@SAMPLES@]
  Disk 0 5 360
WorldEnd
