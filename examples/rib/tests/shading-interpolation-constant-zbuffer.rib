##RenderMan RIB-Structure 1.0
# GitHub #204: ShadingInterpolation. "constant" gives every pixel of a micropolygon the colour of its v0 corner.
# Float output, one sample per pixel and a box filter, so test_shading_interpolation can read the
# shaded values back exactly. The patch spans the image: 64 pixels wide, ShadingRate 16 dices it
# into micropolygons 4 pixels wide.
version 3.03
Hider "zbuffer"
Option "shaderformat" "default" ["rslo"]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "shading-interpolation-constant-zbuffer.tif" "file" "rgba"
Projection "orthographic"
ScreenWindow 0 1 0 1
Format 64 64 1
Clipping 0.1 100
Translate 0 0 1
WorldBegin
  ShadingInterpolation "constant"
  ShadingRate 16
  Surface "show_st"
  Patch "bilinear" "P" [0 0 0  1 0 0  0 1 0  1 1 0]
WorldEnd
