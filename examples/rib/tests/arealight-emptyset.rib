##RenderMan RIB-Structure 1.0
# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLight_EmptySet: a bound light whose scope holds no geometry: it warns once and the receiver is dark (pixel (0, 127) reads 0).
version 3.03
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "arealight-emptyset.tif" "file" "rgba"
Format 256 256 1
Projection "orthographic"
Clipping 0.1 100
WorldBegin
  AttributeBegin
    Attribute "arealight" "int samples" [64]
    AreaLightSource "arealight" 1 "float intensity" [40]
    Surface "constant"
    # (no emitter geometry)
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Surface "al_surface_matte"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
