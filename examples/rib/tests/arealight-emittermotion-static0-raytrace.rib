##RenderMan RIB-Structure 1.0
# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLight_EmitterMotion (static0, raytrace): the quad probe scene (the shipped arealight, intensity 10, 16 samples) under Shutter 0 1, 8 x 8 pixel samples; the emitter is static at its t = 0 pose.
# A8: the emitter's pose is taken at the shading sample's time, so the raytrace pixel is the time average of the closed forms of the emitter's pose (below) and is NOT the t = 0 closed form:
version 3.03
Hider "raytrace" "jitter" [0]
PixelSamples 8 8
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "arealight-emittermotion-static0-raytrace.tif" "file" "rgba"
Format 8 8 1
Projection "orthographic"
Clipping 0.1 100
Shutter 0 1
WorldBegin
  AttributeBegin
    AreaLightSource "arealight" 1 "float intensity" [10]
    Surface "constant"
    Polygon "P" [3 -1 1  3 -1 3  3 1 3  3 1 1]
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Surface "al_surface_matte"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
