##RenderMan RIB-Structure 1.0
# GitHub #230: an output variable named P is P as the surface shader sees it (camera space, the "current" space), for every
# primitive and hider. Control, raytrace.
version 3.03
Hider "raytrace"
Option "shaderformat" "default" ["rslo"]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "aov-p-space-persp-raytrace-rgba.tif" "file" "rgba"
Display "+aov-p-space-persp-raytrace.tif" "file" "P"
Projection "perspective" "fov" 90
Format 64 64 1
Clipping 0.1 100
Translate 0 0 2
WorldBegin
  Surface "constant"
  Patch "bilinear" "P" [-2 -2 0  2 -2 0  -2 2 0  2 2 0]
WorldEnd
