##RenderMan RIB-Structure 1.0
# GitHub #204: ShadingInterpolation. Depth of field with the patch on the focal plane (circle of confusion 0) takes the focal-blur rasterizer.
# Float output, one sample per pixel and a box filter, so test_shading_interpolation can read the
# shaded values back exactly. The patch spans the image: 64 pixels wide, ShadingRate 16 dices it
# into micropolygons 4 pixels wide.
version 3.03
Hider "reyes"
Option "shaderformat" "default" ["rslo"]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "shading-interpolation-dof-reyes.tif" "file" "rgba"
Projection "perspective" "fov" 90
ScreenWindow 0 1 0 1
Format 64 64 1
Clipping 0.1 100
DepthOfField 8 0.1 1
WorldBegin
  ShadingInterpolation "constant"
  ShadingRate 16
  Surface "show_st"
  Translate 0 0 1
  Patch "bilinear" "P" [0 0 0  1 0 0  0 1 0  1 1 0]
WorldEnd
