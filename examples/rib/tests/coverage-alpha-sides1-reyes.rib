##RenderMan RIB-Structure 1.0
# Coverage accuracy (fix/reyes-watertight-coverage, #50): three Sides 1
# spheres of opacity 0.5, one sample at each pixel centre. Every covered pixel's
# alpha must be 1 - 0.5^k, k counting one surface per sphere along
# the ray, as test_depth_analytic computes it from the spheres' camera-space
# positions: (0, 0, 6) r 1.5, (0.5, 0.3, 3) r 0.5 and (1.9, -1, 4.5) r 0.6. A
# sample on a micropolygon edge shared by two quads must be counted once.
# Binary dicing does not close the cracks between grids diced at different
# rates (#51), but no pixel centre of this scene lands on one, so it tests the
# edge rule alone; the coverage-alpha-sides2-tjunction*-reyes.rib scenes cover
# #51.
version 3.03
Hider "reyes" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Display "coverage-alpha-sides1-reyes.tif" "file" "a" "quantize" [0 0 0 0]
Projection "perspective" "fov" 45
Format 160 120 1
Translate 0 0 6

WorldBegin
  Attribute "dice" "binary" [1]
  Surface "constant"
  Opacity 0.5 0.5 0.5
  Sides 1
  Sphere 1.5 -1.5 1.5 360

  AttributeBegin
    Translate 0.5 0.3 -3
    Sphere 0.5 -0.5 0.5 360
  AttributeEnd

  AttributeBegin
    Translate 1.9 -1 -1.5
    Sphere 0.6 -0.6 0.6 360
  AttributeEnd
WorldEnd
