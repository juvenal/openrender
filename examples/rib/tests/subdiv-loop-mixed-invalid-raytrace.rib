##RenderMan RIB-Structure 1.0
version 3.03
Hider "raytrace"
PixelSamples 4 4
Display "subdiv-loop-mixed-invalid-raytrace.tif" "file" "rgba"
Projection "perspective" "fov" 45
Format 320 240 1
Translate 0 0 3

WorldBegin
  LightSource "ambientlight" 1 "intensity" [0.15]
  LightSource "distantlight" 2 "intensity" [0.9] "lightcolor" [1 .95 .9] "from" [20 30 25] "to" [0 0 0]
  LightSource "distantlight" 3 "intensity" [0.35] "lightcolor" [.7 .8 1] "from" [-25 10 -20] "to" [0 0 0]

  Sides 2
  Color [0.7 0.7 0.8]
  Surface "matte"
  # Deliberately mixed topology (one quad face, one triangle face) - Loop
  # subdivision requires an all-triangle mesh, so CLoopSubdivMesh::create()
  # must reject this with CODE_RANGE and fall back to an empty mesh instead
  # of crashing or silently mis-tessellating the quad.
  SubdivisionMesh "loop"
  [ 4 3 ]
  [
    0 1 4 3
    1 2 4
  ]
  [] [] [] []
  "P" [
    -0.6  0.6 0    0  0.6 0    0.6  0.6 0
    -0.6  0   0    0  0   0
  ]
WorldEnd
