##RenderMan RIB-Structure 1.0
# GitHub issue #3 (spec 017, US5) regression: attribute()/option()/
# rendererinfo() silently no-op under the JIT. Not raytraced/stochastic
# (deterministic table lookups), so no numthreads 1 requirement.
version 3.03
Hider "reyes"
Option "shaderformat" "default" ["rslo"]
Display "sphere-scene-state-reyes.tif" "file" "rgba"
Projection "perspective"
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  Surface "scene_state_probe"
  Sphere 1 -1 1 360
WorldEnd
