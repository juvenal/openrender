##RenderMan RIB-Structure 1.0
version 3.03
Hider "raytrace"
PixelSamples 4 4
Display "csg-sphere-sphere-loose-tolerance-raytrace.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" 40
Clipping 0.1 1000
Translate 0 0 5
Rotate -25 1 0 0
Rotate 30 0 1 0
WorldBegin
    LightSource "ambientlight" 1 "intensity" [0.15]
    LightSource "distantlight" 2 "intensity" [0.9] "from" [5 5 -5] "to" [0 0 0]
    Color [0.7 0.7 0.8]
    Surface "plastic"
    SolidBegin "union"
        SolidBegin "primitive"
            Sphere 1 -1 1 360
        SolidEnd
        SolidBegin "primitive"
            Attribute "solid" "float tessellationtolerance" 0.5
            Translate 0.6 0 0
            Sphere 0.8 -0.8 0.8 360
        SolidEnd
    SolidEnd
WorldEnd
