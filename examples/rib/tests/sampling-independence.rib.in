##RenderMan RIB-Structure 1.0
# Spec 039, Phase 6 (Sampling_ShaderDrawIndependence): shaders/
# sampling_independence_probe.sl with n1 = @N1@ iterations in its first trace
# loop. Generated by tests/visual/CMakeLists.txt; the scene is rendered with
# n1 = 2 and n1 = 3 and the channels are compared: R is the first loop (it
# must change), G the second trace loop and B the illuminance loop (they must
# not). Sampler "sobol", single-threaded, one centre sample per pixel.
version 3.03
Hider "reyes" "jitter" [0]
Option "sampling" "sampler" ["sobol"]
Option "limits" "numthreads" [1]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "sampling-independence-@N1@.tif" "file" "rgba"
Projection "perspective"
Format 48 48 1
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  LightSource "distantlight" 1 "intensity" [1] "from" [2 4 -2] "to" [0 0 0]
  Attribute "visibility" "int diffuse" [1] "int specular" [1] "string transmission" ["opaque"]
  AttributeBegin
    Surface "matte"
    Translate 1.2 0 -0.5
    Sphere 0.9 -0.9 0.9 360
  AttributeEnd
  AttributeBegin
    Surface "matte"
    Translate 0 -1.5 0
    Polygon "P" [-5 0 -5  5 0 -5  5 0 5  -5 0 5]
  AttributeEnd
  Surface "sampling_independence_probe" "n1" [@N1@]
  Sphere 1 -1 1 360
WorldEnd
