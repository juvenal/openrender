##RenderMan RIB-Structure 1.0
# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLight_EmitterMotion (threads, zbuffer): the moving emitter at 128 x 128 (16 buckets), 4 x 4 pixel samples: -t:1 and -t:4 give the same image.
version 3.03
Hider "zbuffer" "jitter" [0]
PixelSamples 4 4
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "arealight-emittermotion-threads-zbuffer.tif" "file" "rgba"
Format 128 128 1
Projection "orthographic"
Clipping 0.1 100
Shutter 0 1
WorldBegin
  AttributeBegin
    AreaLightSource "arealight" 1 "float intensity" [10]
    Surface "constant"
    MotionBegin [0 1]
      Translate 0 0 0
      Translate 0 2 0
    MotionEnd
    Polygon "P" [3 -1 1  3 -1 3  3 1 3  3 1 1]
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Surface "al_surface_matte"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
