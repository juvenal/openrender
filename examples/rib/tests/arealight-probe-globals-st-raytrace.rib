##RenderMan RIB-Structure 1.0
# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLightProbe_Globals (st): the emitter (x = 3, y in [1, 3], z in [1, 3], facing -x, area 4) under al_light_st;
# the receiver (al_surface_lightsum) sums Cl over the light's samples, each weighted by 1 / (n p_A) = A / n.
# Cl = (s, t, 0) with an explicit st that is mirrored and scaled: s = 0.95 - 0.1 u, t = 0.05 + 0.1 v (the per-vertex values follow the vertex order). The receiver sums A * (mean s, mean t) = A * (0.9, 0.1) = (3.6, 0.4) with small noise, blue 0. Default (u, v) would read (2, 2).
# Probed at pixel (0, 0).
version 3.03
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "arealight-probe-globals-st-raytrace.tif" "file" "rgba"
Format 8 8 1
Projection "orthographic"
Clipping 0.1 100
WorldBegin
  AttributeBegin
    AreaLightSource "al_light_st" 1 
    Surface "constant"
    Polygon "P" [3 1 1  3 1 3  3 3 3  3 3 1] "varying float[2] st" [0.95 0.05  0.85 0.05  0.85 0.15  0.95 0.15]
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Surface "al_surface_lightsum"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
