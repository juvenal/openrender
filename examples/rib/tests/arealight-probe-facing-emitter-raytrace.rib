##RenderMan RIB-Structure 1.0
# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLightProbe_Facing (emitter): the emitter's N is +x, the receivers are behind it: illuminate(P, N, PI/2) lights nothing.
# The estimator contributes 0, never a negative or non-finite value.
version 3.03
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "arealight-probe-facing-emitter-raytrace.tif" "file" "rgba"
Format 8 8 1
Projection "orthographic"
Clipping 0.1 100
WorldBegin
  AttributeBegin
    AreaLightSource "arealight" 1 "float intensity" [10]
    Surface "constant"
    Polygon "P" [3 -1 1  3 1 1  3 1 3  3 -1 3]
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Surface "al_surface_matte"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
