##RenderMan RIB-Structure 1.0
# Spec 035 (closure tree and BSDF), generated by specs/035-closure-tree-bsdf/tools/gen_scenes.py: do not edit.
# closures-bxdf-interim: the four Bxdfs and the Surface/Bxdf order in nested blocks (IR-026: with no consumer a governing Bxdf renders
# the substitute surface and warns once per Bxdf name). Frame 1 has no Surface before WorldBegin, so the substitute is the
# defaultsurface RiWorldBegin binds (A'); frame 2 gives a Surface before WorldBegin, so the substitute is the no-shader path and the
# pre-world Surface is never used.
version 3.03
Hider "reyes"
PixelSamples 2 2
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Option "shaderformat" "default" ["slo"]
FrameBegin 1
Display "closures-bxdf-interim-reyes-slo.tif" "file" "rgba"
Format 16 16 1
Projection "perspective" "fov" [45]
Clipping 0.1 1000
Translate 0 0 8
WorldBegin
  LightSource "distantlight" 1 "intensity" 1.2 "from" [0 0 0] "to" [0.3 -0.3 1]
  AttributeBegin
    Translate -2.4 1.2 0
    Color [0.9 0.3 0.2]
    Bxdf "diffuse" "float Kd" [0.9]
    Sphere 1 -1 1 360
  AttributeEnd
  AttributeBegin
    Translate 0 1.2 0
    Color [0.2 0.8 0.3]
    Bxdf "plastic" "float roughness" [0.2]
    Sphere 1 -1 1 360
  AttributeEnd
  AttributeBegin
    Translate 2.4 1.2 0
    Color [0.8 0.8 0.3]
    Bxdf "conductor"
    Sphere 1 -1 1 360
  AttributeEnd
  AttributeBegin
    Translate -2.4 -1.2 0
    Color [0.3 0.3 0.9]
    Bxdf "dielectric" "float ior" [1.4]
    Sphere 1 -1 1 360
  AttributeEnd
  AttributeBegin
    Translate 0 -1.2 0
    Color [0.8 0.5 0.2]
    Surface "matte"
    Bxdf "diffuse"
    Sphere 1 -1 1 360
  AttributeEnd
  AttributeBegin
    Translate 2.4 -1.2 0
    Color [0.5 0.2 0.8]
    Bxdf "plastic"
    Surface "plastic"
    Sphere 1 -1 1 360
  AttributeEnd
WorldEnd
FrameEnd
FrameBegin 2
Display "closures-bxdf-interim-reyes-slo-b.tif" "file" "rgba"
Format 16 16 1
Projection "perspective" "fov" [45]
Clipping 0.1 1000
Translate 0 0 8
Surface "matte"
WorldBegin
  LightSource "distantlight" 1 "intensity" 1.2 "from" [0 0 0] "to" [0.3 -0.3 1]
  AttributeBegin
    Translate -1.2 0 0
    Color [0.8 0.8 0.3]
    Bxdf "conductor"
    Sphere 1 -1 1 360
  AttributeEnd
  AttributeBegin
    Translate 1.2 0 0
    Color [0.3 0.3 0.9]
    Bxdf "dielectric"
    Sphere 1 -1 1 360
  AttributeEnd
WorldEnd
FrameEnd
