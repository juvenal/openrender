##RenderMan RIB-Structure 1.0
# Spec 035 (closure tree and BSDF), generated by specs/035-closure-tree-bsdf/tools/gen_scenes.py: do not edit.
# closures-modes: Option "shade" "closuremode" ["both"] for the scene, a nested attribute "closures" and a nested attribute "color".
# The shipped surfaces are never closure capable (FR-017): under both and closures they render as color, with one IR-017 warning per
# (shader, mode) per frame. The image is the same in the three modes.
version 3.03
Hider "raytrace" "jitter" [0]
PixelSamples 2 2
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Option "shaderformat" "default" ["slo"]
Display "closures-modes-raytrace-slo.tif" "file" "rgba"
Format 16 16 1
Projection "perspective" "fov" [40]
Clipping 0.1 1000
Translate 0 0 6
Option "shade" "closuremode" ["both"]
WorldBegin
  LightSource "distantlight" 1 "intensity" 1.2 "from" [0 0 0] "to" [0.3 -0.3 1]
  AttributeBegin
    Translate -2.2 0 0
    Color [0.9 0.3 0.2]
    Surface "plastic"
    Sphere 1 -1 1 360
  AttributeEnd
  AttributeBegin
    Translate 0 0 0
    Color [0.2 0.8 0.3]
    Attribute "shade" "closuremode" ["closures"]
    Surface "matte"
    Sphere 1 -1 1 360
  AttributeEnd
  AttributeBegin
    Translate 2.2 0 0
    Color [0.2 0.3 0.9]
    Attribute "shade" "closuremode" ["color"]
    Surface "plastic"
    Sphere 1 -1 1 360
  AttributeEnd
WorldEnd
