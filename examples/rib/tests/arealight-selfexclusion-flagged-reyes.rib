# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLight_SelfExclusion (reyes): the soft quad emitter itself carries Attribute "visibility" "int transmission" [1] and there is no occluder:
# the emitter's own surface must never occlude its samples, so the lit pixel (0, 127) reads the unoccluded closed form 0.199263576 (tolerance 0.001510353).
version 3.03
Hider "reyes" "jitter" [0]
PixelSamples 1 1
