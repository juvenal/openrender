Clipping 0.1 100
WorldBegin
  AttributeBegin
    Attribute "arealight" "int samples" [64]
    AreaLightSource "arealight" 1 "float intensity" [40]
    Surface "constant"
    Attribute "visibility" "int transmission" [1]
    Polygon "P" [3 -0.25 1.75  3 -0.25 2.25  3 0.25 2.25  3 0.25 1.75]
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Surface "al_surface_matte"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
