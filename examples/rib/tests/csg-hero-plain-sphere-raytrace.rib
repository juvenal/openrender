##RenderMan RIB-Structure 1.0
# Spec 021 (T060): the hero scene's sphere alone, as a plain Sphere outside any
# solid block, with the hero's camera, light, shader and the sphere operand's
# colour. CsgUntouchedRegion_hero compares it with csg-hero-raytrace-800 outside
# disc:400,250,64 (the near seam ring, r = 61.7 px, plus a 2 px margin): there the
# solid's surface is the untouched sphere and must match it (SC-008).
Hider "raytrace"
PixelSamples 4 4
Display "csg-hero-plain-sphere-raytrace.tif" "file" "rgba"
Format 800 500 1
Projection "perspective" "fov" [38]
Clipping 0.1 1000
Translate 0 0 9
WorldBegin
    LightSource "raydistant" 2 "intensity" [2.2]
        "lightcolor" [1.0 0.82 0.42]
        "from" [7 8 -6] "to" [0 0 0]
    Surface "plastic" "float Ks" [0.88] "float roughness" [0.05]
    Color [1 0.8 0.3]
    Sphere 1.50 -1.50 1.50 360
WorldEnd
