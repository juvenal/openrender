##RenderMan RIB-Structure 1.0
# GitHub #60 regression: Oi gets its Os default when the surface shader does
# not write it, even when another bound shader references it. min_probe writes
# Ci only, from constants; param_query_volume, bound as Interior and Exterior,
# reads and writes Oi (Oi = Oi), which used to make shade() skip the Oi
# default, so Oi kept whatever the thread's varying buffer last held. With no
# displacement shader no displacement-only pass ever fills that buffer, so the
# bug shows at any thread count: alpha 0, and the back of the sphere added to
# the front. test_pixel_probe reads one pixel: RGBA = 0.3 0.3 0.5 (min_probe's
# Ci) and Os = 1.
version 3.03
Hider "reyes" "jitter" [0]
Option "shaderformat" "default" ["rslo"]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "sphere-volume-oi-default-reyes-rslo.tif" "file" "rgba"
Projection "perspective"
Format 32 32 1
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  Interior "param_query_volume"
  Exterior "param_query_volume"
  Surface "min_probe"
  Sphere 1 -1 1 360
WorldEnd
