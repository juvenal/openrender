##RenderMan RIB-Structure 1.0
# Depth accuracy (fix/raytrace-midpoint-depth, #47, #49): three opaque
# Sides 2 spheres, one sample at each pixel centre. Every pixel's z must be
# the midpoint of the nearest sphere's front and back surfaces, as
# test_depth_analytic computes it from the spheres' camera-space positions:
# (0, 0, 6) r 1.5, (0.5, 0.3, 3) r 0.5 and (1.9, -1, 4.5) r 0.6.
# Binary dicing keeps neighbouring grids' boundary vertices nested, so this
# scene tests the edge rule alone; coverage-alpha-sides2-tjunction-reyes.rib
# covers the cracks between grids diced at different rates (#51).
version 3.03
Hider "reyes" "jitter" [0]
Option "hider" "depthfilter" "midpoint"
PixelSamples 1 1
PixelFilter "box" 1 1
Display "depth-analytic-mid-reyes.tif" "file" "z"
Projection "perspective" "fov" 45
Format 160 120 1
Translate 0 0 6

WorldBegin
  Attribute "dice" "binary" [1]
  Sides 2
  Sphere 1.5 -1.5 1.5 360

  AttributeBegin
    Translate 0.5 0.3 -3
    Sphere 0.5 -0.5 0.5 360
  AttributeEnd

  AttributeBegin
    Translate 1.9 -1 -1.5
    Sphere 0.6 -0.6 0.6 360
  AttributeEnd
WorldEnd
