##RenderMan RIB-Structure 1.0
version 3.03

# T068 (spec 010-full-subdivision-support, US6/FR-014): confirms the Loop
# subdivision scheme (CLoopSubdivMesh) integrates with the photon hider's
# generic tracePhoton() dispatch, same rationale as
# subdiv-facevarying-seam-photon.rib (T065) -- see that file's header comment
# for the two-pass structure explanation. Frame 2 is a byte-for-byte copy of
# subdiv-loop-raytrace.rib's raytrace pass, so this test reuses that scene's
# reference TIFF.
FrameBegin 1
  Hider "photon" "int emit" [2000]
  Projection "perspective" "fov" 45
  Format 320 240 1
  Translate 0 0 3

  WorldBegin
    LightSource "ambientlight" 1 "intensity" [0.15]
    LightSource "distantlight" 2 "intensity" [0.9] "lightcolor" [1 .95 .9] "from" [20 30 25] "to" [0 0 0]
    LightSource "distantlight" 3 "intensity" [0.35] "lightcolor" [.7 .8 1] "from" [-25 10 -20] "to" [0 0 0]

    Sides 2
    Color [0.7 0.7 0.8]
    AttributeBegin
      Attribute "photon" "string globalmap" ["subdiv-loop-photon.gpm"]
      Surface "matte"
      Rotate 20 1 0.4 0
      SubdivisionMesh "loop"
      [ 3 3 3 3  3 3 3 3 ]
      [
        0 2 4
        2 1 4
        1 3 4
        3 0 4
        2 0 5
        1 2 5
        3 1 5
        0 3 5
      ]
      [] [] [] []
      "P" [
         0.7  0    0
        -0.7  0    0
         0    0.7  0
         0   -0.7  0
         0    0    0.7
         0    0   -0.7
      ]
    AttributeEnd
  WorldEnd
FrameEnd

FrameBegin 2
  Hider "raytrace"
  PixelSamples 4 4
  Display "subdiv-loop-photon.tif" "file" "rgba"
  Projection "perspective" "fov" 45
  Format 320 240 1
  Translate 0 0 3

  WorldBegin
    LightSource "ambientlight" 1 "intensity" [0.15]
    LightSource "distantlight" 2 "intensity" [0.9] "lightcolor" [1 .95 .9] "from" [20 30 25] "to" [0 0 0]
    LightSource "distantlight" 3 "intensity" [0.35] "lightcolor" [.7 .8 1] "from" [-25 10 -20] "to" [0 0 0]

    Sides 2
    Color [0.7 0.7 0.8]
    Surface "matte"
    Rotate 20 1 0.4 0
    SubdivisionMesh "loop"
    [ 3 3 3 3  3 3 3 3 ]
    [
      0 2 4
      2 1 4
      1 3 4
      3 0 4
      2 0 5
      1 2 5
      3 1 5
      0 3 5
    ]
    [] [] [] []
    "P" [
       0.7  0    0
      -0.7  0    0
       0    0.7  0
       0   -0.7  0
       0    0    0.7
       0    0   -0.7
    ]
  WorldEnd
FrameEnd
