##RenderMan RIB-Structure 1.0
# Coverage accuracy (fix/reyes-watertight-coverage, #50): three Sides 2
# spheres of opacity 0.5, one sample at each pixel centre. Every covered pixel's
# alpha must be 1 - 0.5^k, k counting each sphere's front and back along
# the ray, as test_depth_analytic computes it from the spheres' camera-space
# positions: (0, 0, 6) r 1.5, (0.5, 0.3, 3) r 0.5 and (1.9, -1, 4.5) r 0.6. A
# sample on a micropolygon edge shared by two quads must be counted once.
version 3.03
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Display "coverage-alpha-sides2-raytrace.tif" "file" "a" "quantize" [0 0 0 0]
Projection "perspective" "fov" 45
Format 160 120 1
Translate 0 0 6

WorldBegin
  Surface "constant"
  Opacity 0.5 0.5 0.5
  Sides 2
  Sphere 1.5 -1.5 1.5 360

  AttributeBegin
    Translate 0.5 0.3 -3
    Sphere 0.5 -0.5 0.5 360
  AttributeEnd

  AttributeBegin
    Translate 1.9 -1 -1.5
    Sphere 0.6 -0.6 0.6 360
  AttributeEnd
WorldEnd
