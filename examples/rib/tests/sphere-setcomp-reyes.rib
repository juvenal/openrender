##RenderMan RIB-Structure 1.0
# GitHub issue #3 (spec 017, US4) regression: setcomp() silently no-op
# under the JIT. Pure math, not stochastic -- no numthreads requirement.
version 3.03
Hider "reyes"
Option "shaderformat" "default" ["rslo"]
Display "sphere-setcomp-reyes.tif" "file" "rgba"
Projection "perspective"
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  Surface "setcomp_probe"
  Sphere 1 -1 1 360
WorldEnd
