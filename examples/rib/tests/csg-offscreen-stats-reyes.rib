##RenderMan RIB-Structure 1.0
version 3.03
# Spec 021 (T010): a hero solid placed behind the camera, its sphere operand supplied by a
# DelayedReadArchive procedural, plus a plain visible sphere. Nothing may be resolved,
# classified, split or expanded for the solid (SC-006).
Hider "reyes"
PixelSamples 4 4
Display "csg-offscreen-stats-reyes.tif" "file" "rgba"
Format 800 500 1
Projection "perspective" "fov" [38]
Clipping 0.1 1000
Translate 0 0 9
Option "statistics" "endofframe" [2]
WorldBegin
    LightSource "raydistant" 2 "intensity" [2.2]
        "lightcolor" [1.0 0.82 0.42]
        "from" [7 8 -6] "to" [0 0 0]
    Surface "plastic" "float Ks" [0.88] "float roughness" [0.05]
    TransformBegin
        Translate 0 0 -20
        SolidBegin "difference"
            SolidBegin "primitive"
                Procedural "DelayedReadArchive" ["archives/csg-sphere-operand.rib"] [-1.5 1.5 -1.5 1.5 -1.5 1.5]
            SolidEnd
            SolidBegin "primitive"
                Cylinder 0.65 -2 2 360
            SolidEnd
        SolidEnd
    TransformEnd
    Sphere 1 -1 1 360
WorldEnd
