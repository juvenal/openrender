##RenderMan RIB-Structure 1.0
# Spec 039, Phase 6 (SamplingJitParity_RandomProbe_*): shaders/
# sampling_random_probe.sl on a sphere, sampler "sobol", shader format
# "@FORMAT@", hider "@HIDER@". The probe encodes its flags in the colour of the
# pixel at the centre of the sphere; test_pixel_probe reads it back exactly.
# Generated by tests/visual/CMakeLists.txt. Du()/Dv() of a draw are 0 only for
# ray-hit shading (raytrace), so the full three-channel check uses that hider and
# the reyes copy checks the distinctness and range channels only.
version 3.03
Hider "@HIDER@" "jitter" [0]
Option "sampling" "sampler" ["sobol"]
Option "shaderformat" "default" ["@FORMAT@"]
Option "limits" "numthreads" [1]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "sampling-random-probe-@HIDER@-@FORMAT@.tif" "file" "rgba"
Projection "perspective"
Format 32 32 1
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  Surface "sampling_random_probe"
  Sphere 1 -1 1 360
WorldEnd
