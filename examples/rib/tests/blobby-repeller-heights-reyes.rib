##RenderMan RIB-Structure 1.0
# One blob at three heights above an irregular ground, each with the same
# repelling ground plane. Low down the barrier term carves the underside
# away and flattens it against the ridge; higher up the field fades out at
# the cut-off height and the blob is a sphere again. The ground shown is the
# same surface blobby-ground.z was rendered from (US7 scenarios 1 and 2).
#
# Spec 015-blobby-implicit-surfaces, T085. One variant per camera hider; the
# same three files serve both the visual and the parity registrations.
#
# The depth file is examples/rib/tests/blobby-ground.z, generated by blobby-
# ground-zfile.rib in the same directory and found through the texture
# search path. The visible ground below is the same surface the depth file
# was rendered from, so the repulsion can be read against the thing it is
# repelling from.
version 3.03
Hider "reyes"
Display "blobby-repeller-heights-reyes.tif" "file" "rgba"
Format 240 160 1
Projection "perspective" "fov" 40
Clipping 0.1 1000
Translate 0 -1.2 12
Rotate -18 1 0 0
WorldBegin
    LightSource "ambientlight" 1 "intensity" [0.3]
    LightSource "distantlight" 2 "intensity" [0.9] "from" [3 9 -4] "to" [0 0 0]
    Sides 2
    Color [0.45 0.42 0.36]
    Surface "matte"
    PatchMesh "bilinear" 5 "nonperiodic" 5 "nonperiodic" "P" [
        -6 0.00 -6   -3 0.55 -6   0 0.00 -6   3 0.55 -6   6 0.00 -6
        -6 0.55 -3   -3 1.20 -3   0 0.40 -3   3 1.20 -3   6 0.55 -3
        -6 0.00  0   -3 0.40  0   0 0.00  0   3 0.40  0   6 0.00  0
        -6 0.55  3   -3 1.20  3   0 0.40  3   3 1.20  3   6 0.55  3
        -6 0.00  6   -3 0.55  6   0 0.00  6   3 0.55  6   6 0.00  6
    ]
    Color [0.72 0.74 0.85]
    TransformBegin
        Translate -2.7 0.61 0
        Attribute "blobby" "float tolerance" [ 0.04 ]
        Blobby 2 [
            1001 0
            1003 0 16
            0 2 0 1
        ] [
            1.4 0 0 0  0 1.4 0 0  0 0 1.4 0  0 0 0 1
            1.5 0.25 0.5 0.6
        ] [ "blobby-ground.z" ]
    TransformEnd
    TransformBegin
        Translate 0 0.8 0
        Attribute "blobby" "float tolerance" [ 0.04 ]
        Blobby 2 [
            1001 0
            1003 0 16
            0 2 0 1
        ] [
            1.4 0 0 0  0 1.4 0 0  0 0 1.4 0  0 0 0 1
            1.5 0.25 0.5 0.6
        ] [ "blobby-ground.z" ]
    TransformEnd
    TransformBegin
        Translate 2.7 2.16 0
        Attribute "blobby" "float tolerance" [ 0.04 ]
        Blobby 2 [
            1001 0
            1003 0 16
            0 2 0 1
        ] [
            1.4 0 0 0  0 1.4 0 0  0 0 1.4 0  0 0 0 1
            1.5 0.25 0.5 0.6
        ] [ "blobby-ground.z" ]
    TransformEnd
WorldEnd
