##RenderMan RIB-Structure 1.0
# Spec 035 (closure tree and BSDF), generated by specs/035-closure-tree-bsdf/tools/gen_scenes.py: do not edit.
# closures-arealight: a bound area light (AreaLightSource) over two receivers, one in mode color and one in mode closures, side by side and
# not seen by each other's shadow or reflection rays. The shipped receiver surface is not closure capable, so both render as color
# and the closures one warns once (IR-017).
version 3.03
Hider "raytrace" "jitter" [0]
PixelSamples 2 2
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Option "shaderformat" "default" ["slo"]
Display "closures-arealight-raytrace-slo.tif" "file" "rgba"
Format 16 16 1
Projection "perspective" "fov" [50]
Clipping 0.1 1000
Translate 0 0 9
WorldBegin
  AttributeBegin
    AreaLightSource "arealight" 1 "float intensity" [8]
    Surface "constant"
    Polygon "P" [-1 3 -1  1 3 -1  1 3 1  -1 3 1]
  AttributeEnd
  AttributeBegin
    Translate -2.5 0 0
    Color [0.9 0.9 0.9]
    Attribute "shade" "closuremode" ["color"]
    Surface "matte"
    Sphere 1 -1 1 360
  AttributeEnd
  AttributeBegin
    Translate 2.5 0 0
    Color [0.9 0.9 0.9]
    Attribute "shade" "closuremode" ["closures"]
    Surface "matte"
    Sphere 1 -1 1 360
  AttributeEnd
WorldEnd
