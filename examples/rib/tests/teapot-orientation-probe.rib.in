##RenderMan RIB-Structure 1.0
# GitHub #228 (TeapotOrientation_*): the teapot seen from the @VIEW@ under the @HIDER@ hider, shaded by
# orient_probe: green where Ng faces the camera, red where it faces away. The sphere is a control (a closed
# surface wound outward, always green). Generated by tests/visual/CMakeLists.txt.
version 3.03
Hider "@HIDER@"
Option "sampling" "seed" [7]
Option "limits" "numthreads" [1]
PixelSamples 4 4
Quantize "rgba" 0 0 0 0
Display "@OUTPUT@" "file" "rgba"
Format 400 300 1
Projection "perspective" "fov" [30]
WorldBegin
  Translate 0 -1.2 12
  Rotate @TILT@ 1 0 0
  Rotate -90 1 0 0
  Rotate 30 0 0 1
  Surface "orient_probe"
  Geometry "teapot"
  AttributeBegin
    Translate 3.5 -1 1
    Sphere 0.8 -0.8 0.8 360
  AttributeEnd
WorldEnd
