##RenderMan RIB-Structure 1.0
# Spec 039, Phase 7 (DeterminismHarness_multiple_outputs): a scene with two displays, colour
# and depth, both 32-bit float. Under the sobol sampler (the harness prepends the option) the
# random() shading is thread independent, so both outputs are identical across configurations.
version 3.03
Hider "reyes" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Quantize "z" 0 0 0 0
Display "determinism-harness-two-outputs.tif" "file" "rgba"
Display "+determinism-harness-two-outputs-z.tif" "file" "z"
Projection "perspective"
Format 160 120 1
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  Surface "random_probe"
  Sphere 1.8 -1.8 1.8 360
WorldEnd
