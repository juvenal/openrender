##RenderMan RIB-Structure 1.0
# A blobby whose *field parameters* change across the shutter -- the blob
# grows rather than moving. No transform is animated, so this is motion a
# transform-only path could not express at all: each vertex is advected onto
# the shutter-close level set along the gradient, so it ends up where that
# part of the surface actually went (US8 scenario 3).
#
# Spec 015-blobby-implicit-surfaces, T093. One variant per camera hider; the
# same three files serve both the visual and the parity registrations.
version 3.03
Hider "zbuffer"
Display "blobby-motion-grow-zbuffer.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" 40
Clipping 0.1 1000
Shutter 0 1
PixelSamples 6 6
Translate 0 0 6
WorldBegin
    LightSource "ambientlight" 1 "intensity" [0.2]
    LightSource "distantlight" 2 "intensity" [0.9] "from" [5 5 -5] "to" [0 0 0]
    Color [0.72 0.74 0.85]
    Surface "matte"
    TransformBegin
        Translate 0 0 0
        MotionBegin [ 0 1 ]
            Blobby 1 [
                1001 0
            ] [
                0.7 0 0 0  0 0.7 0 0  0 0 0.7 0  0 0 0 1
            ] [ "" ]
            Blobby 1 [
                1001 0
            ] [
                1.6 0 0 0  0 1.6 0 0  0 0 1.6 0  0 0 0 1
            ] [ "" ]
        MotionEnd
    TransformEnd
WorldEnd
