##RenderMan RIB-Structure 1.0
# Spec 039, Phase 6 (SamplingJitParity_*, SamplingJitEngaged_*): one sphere
# shaded by shaders/sampling_jit_probe.sl, which fills Ci with the value of
# channel @CHANNEL@. Sampler "sobol", seed @SEED@; the probe runs as @FORMAT@ (the
# light, the floor and the occluder always run as .rslo, so the two formats
# differ only in the probe). Generated by tests/visual/CMakeLists.txt: the same
# scene is rendered under both formats and, for the engaged control, under two
# seeds. Single-threaded, one centre sample per pixel, so the shading is the
# only source of difference. The occluder and the floor are there for the rays
# of occlusion(), indirectdiffuse(), gather(), trace() and transmission().
version 3.03
Hider "reyes" "jitter" [0]
Option "sampling" "sampler" ["sobol"]
Option "sampling" "seed" [@SEED@]
Option "shaderformat" "default" ["rslo"]
Option "limits" "numthreads" [1]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "@OUTPUT@" "file" "rgba"
Projection "perspective"
Format 48 48 1
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  LightSource "distantlight" 1 "intensity" [1] "from" [2 4 -2] "to" [0 0 0]
  Attribute "visibility" "int diffuse" [1] "int specular" [1] "string transmission" ["opaque"]
  AttributeBegin
    Surface "matte"
    Translate 1.2 0 -0.5
    Sphere 0.9 -0.9 0.9 360
  AttributeEnd
  AttributeBegin
    Surface "matte"
    Translate 0 -1.5 0
    Polygon "P" [-5 0 -5  5 0 -5  5 0 5  -5 0 5]
  AttributeEnd
  Attribute "shade" "shaderformat" ["@FORMAT@"]
  Surface "sampling_jit_probe" "channel" [@CHANNEL@]
  Sphere 1 -1 1 360
WorldEnd
