##RenderMan RIB-Structure 1.1
##Frames 1
##Shaders somewood
##CapabilitiesNeeded ShadingLanguage
version 3.03
Sides 1

Projection "perspective" "fov" 30
Translate 0 0 4
Rotate 25 -1 0 0

WorldBegin

  LightSource "ambientlight" 0 "intensity" [0.7]
  LightSource "distantlight" 1 "intensity" [0.9] "from" [4 4 -3] "to" [0 0 0]

  AttributeBegin
    Attribute "identifier" "name" "bowl"
    Translate 0 -1.0 0
    Rotate 90 -1 0 0
    Color 1 .73 .41
    AttributeBegin
      Attribute "identifier" "shadinggroup" "bowlsurf"
      Surface "somewood"
      Paraboloid 1.0 0.5 1.5 360
      ReverseOrientation
      Paraboloid 0.96 0.5 1.5 360
      ReverseOrientation
      Translate 0 0 1.5
      Torus 0.98 0.02 0 180 360
    AttributeEnd
  AttributeEnd

WorldEnd
