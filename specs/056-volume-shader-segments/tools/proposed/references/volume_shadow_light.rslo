#!version 2.0.0
#!name "volume_shadow_light"
light
#!parameters:
uniform	float	intensity	=	1
uniform	color	lightcolor	=	1
uniform	float	reach	=	3
#!variables:
varying	vector	temporary_0
varying	vector	temporary_1
uniform	vector	temporary_2
varying	vector	vis
varying	vector	temporary_3
#!Init:
	return            
#!Code:
	vfromf  temporary_2 0 0 reach
	vuvector  temporary_1 temporary_2
	subvv  temporary_0 Ps temporary_1
	illuminate temporary_0 #!Label2
	negv  N N
	vfromf  temporary_2 1
	vuvector  temporary_1 temporary_2
	shadow	("c=SFp")  temporary_3 "raytrace" 0 Ps 0
	subvv  vis temporary_1 temporary_3
	vfromf  temporary_2 intensity
	vuvector  temporary_3 temporary_2
	mulvv  temporary_1 vis temporary_3
	vuvector  temporary_3 lightcolor
	mulvv  Cl temporary_1 temporary_3
#!Label2:
	endilluminate
	return
