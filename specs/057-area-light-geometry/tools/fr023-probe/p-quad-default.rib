##RenderMan RIB-Structure 1.0
version 3.03
Hider "raytrace"
Display "p-quad-default.tif" "file" "rgba"
Projection "perspective" "fov" 50
Format 256 256 1
PixelSamples 2 2
Clipping 0.1 1000
Translate 0 0 9
Rotate -40 1 0 0
WorldBegin
    LightSource "quadlight" 1 "P0" [-1 4 -1] "P1" [1 4 -1] "P2" [-1 4 1] "P3" [1 4 1] "intensity" [8] "numSamples" [16]
    AttributeBegin

        Color [0.8 0.2 0.2]
        Surface "matte"
        Translate 0 2 0
        Rotate 90 1 0 0
        Disk 0 0.8 360
    AttributeEnd
    AttributeBegin
        Color [0.7 0.7 0.7]
        Surface "matte"
        Polygon "P" [-6 0 -6  6 0 -6  6 0 6  -6 0 6]
    AttributeEnd
WorldEnd
