# Phase 8, T109a (PAUSE 8a): the DRAFT of the four pinned-test edits (amendment F1, 2026-11-09) and of the test-only setter they use.
# NOT applied. Part 1: the setter (src/ri/render/rendererTransport.{h,cpp}, Core). Part 2: the four tests: only the lines that switch
# the illumination hook on and off and their save/restore, one added include each, and (a separate, labelled hunk of
# test_illumination_hook.cpp) the header comment that names HIDER_ILLUMINATIONHOOK. Every assertion, scene, expected value and loop is
# untouched. Alternative to the setter, if the maintainer prefers: none that keeps frameTransport() read-only without a test-visible
# writer (a public mutable slot, or a frame begun by the test).
#
#### Part 1: the test-only setter
--- a/src/ri/render/rendererTransport.h
+++ b/src/ri/render/rendererTransport.h
@@ -62,4 +62,9 @@
 void finishFrameTransport();                           // (Phase 9) start of endFrame
 void endFrameTransport();                              // clears the slot, end of endFrame, after endDisplays
 
+// Test-only: sets the slot's illuminationHook trait outside a frame and returns the previous value, so a test that drives
+// the illumination hook with no renderer (the shading_parity probes) can switch it on and off and restore it. Writes the
+// slot only where no render thread exists. Not part of any installed header (this file is not in OPENRENDER_PUBLIC_HEADERS).
+bool setFrameIlluminationHookForTest(bool on);
+
 #endif

--- a/src/ri/render/rendererTransport.cpp
+++ b/src/ri/render/rendererTransport.cpp
@@ -74,3 +74,9 @@
 void endFrameTransport() {
     slot = SFrameTransport();
 }
+
+bool setFrameIlluminationHookForTest(bool on) {
+    const bool previous = slot.traits.illuminationHook;
+    slot.traits.illuminationHook = on;
+    return previous;
+}

