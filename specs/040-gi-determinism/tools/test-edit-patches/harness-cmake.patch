         message(FATAL_ERROR "add_determinism_sweep(${NAME}): no outputs listed")
     endif()
+    set(_extra "")
+    if(ARG_FLOAT)
+        list(APPEND _extra --float)
+    endif()
+    if(ARG_DEPTH)
