+static inline bool isDisplayLine(const std::string &line) {
+    const size_t at = line.find_first_not_of(" \t");
+    return at != std::string::npos && line.compare(at, 7, "Display") == 0 && line.size() > at + 7 &&
+           (line[at + 7] == ' ' || line[at + 7] == '\t');
+}
