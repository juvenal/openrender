##RenderMan RIB-Structure 1.0
# Spec 040 FR-006 (GitHub #163): the photon frame of Registry_IntegratorImageIdentity (registry_testing.h, photonFrameText(1,
# "", "identity.gpm")), as a file, so that measure_gi.py can render it as separate processes. One thread, 2000 photons, one
# point light, a floor and a sphere; the only output is identity.gpm.
version 3.03
FrameBegin 1
  Option "limits" "numthreads" [1]
  Hider "photon" "int emit" [2000]
  Projection "perspective" "fov" 45
  Format 32 24 1
  Translate 0 -1 5
  WorldBegin
    LightSource "pointlight" 1 "intensity" [4] "from" [0 2.2 0.5]
    Attribute "photon" "string globalmap" ["identity.gpm"]
    Surface "matte"
    Polygon "P" [-3 0 -3  -3 0 3  3 0 3  3 0 -3]
    Sphere 0.6 -0.6 0.6 360
  WorldEnd
FrameEnd
