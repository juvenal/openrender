##RenderMan RIB-Structure 1.0
# Spec 040 sweep scene (T026), not a visual test and without a reference image: a cache written in frame 1 and read and extended in frame 2 (filemode rw: CACHE_READ | CACHE_WRITE | CACHE_SAMPLE), shader format rslo.
# The extended cache is written back under the same handle (the renderer reads and writes one file name), so the sweep lists one .icache.
# The determinism harness (tests/visual/test_depth_determinism.cpp, --float --depth --files) renders it under every thread and
# process configuration and compares colour, alpha, depth and the cache or map files byte for byte. The sphere pair is
# examples/rib/tests/sphere-occlusion-reyes.rib's (the occluder needs `Attribute "visibility" "diffuse" [1]`).
version 3.03
FrameBegin 1
  Hider "reyes"
  Option "shaderformat" "default" ["rslo"]
  Format 64 48 1
  PixelSamples 1 1
  Projection "perspective"
  Clipping 0.1 100
  Translate 0 0 5
  WorldBegin
    Attribute "irradiance" "string handle" ["gi-cache-extend-reyes.icache"]
    Attribute "irradiance" "string filemode" ["w"]
    Attribute "irradiance" "float maxerror" [0.6]
    Surface "occlusion_probe"
    Sphere 1 -1 1 360
    AttributeBegin
      Attribute "visibility" "diffuse" [1]
      Surface "matte"
      Translate 1.2 0 -0.5
      Sphere 0.9 -0.9 0.9 360
    AttributeEnd
  WorldEnd
FrameEnd
FrameBegin 2
  Hider "reyes"
  Option "shaderformat" "default" ["rslo"]
  Format 64 48 1
  PixelSamples 1 1
  Projection "perspective"
  Clipping 0.1 100
  Display "gi-cache-extend-reyes.tif" "file" "rgba"
  Translate 0.4 0.2 5
  WorldBegin
    Attribute "irradiance" "string handle" ["gi-cache-extend-reyes.icache"]
    Attribute "irradiance" "string filemode" ["rw"]
    Attribute "irradiance" "float maxerror" [0.6]
    Surface "occlusion_probe"
    Sphere 1 -1 1 360
    AttributeBegin
      Attribute "visibility" "diffuse" [1]
      Surface "matte"
      Translate 1.2 0 -0.5
      Sphere 0.9 -0.9 0.9 360
    AttributeEnd
  WorldEnd
FrameEnd
