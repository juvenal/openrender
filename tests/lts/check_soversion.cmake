# Fail when a shared library's SONAME / compatibility version is not the
# configured OPENRENDER_COMPAT_SOVERSION. An LTS line keeps that number for
# the whole support window; bumping one library and not the others is a break.
if(NOT DEFINED SOVERSION OR SOVERSION STREQUAL "")
    message(FATAL_ERROR "Lts_SoVersion: SOVERSION is not set")
endif()
if(NOT DEFINED LIBRARIES OR LIBRARIES STREQUAL "")
    message(FATAL_ERROR "Lts_SoVersion: LIBRARIES is not set")
endif()

string(REPLACE "|" ";" _libs "${LIBRARIES}")
set(_failures 0)
foreach(_lib IN LISTS _libs)
    if(NOT EXISTS "${_lib}")
        message(SEND_ERROR "Lts_SoVersion: missing ${_lib}")
        math(EXPR _failures "${_failures} + 1")
        continue()
    endif()
    get_filename_component(_name "${_lib}" NAME)
    set(_soname "")
    if(APPLE)
        execute_process(COMMAND otool -D "${_lib}"
            RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
        if(NOT _rc EQUAL 0)
            message(SEND_ERROR "Lts_SoVersion: otool failed for ${_lib}: ${_err}")
            math(EXPR _failures "${_failures} + 1")
            continue()
        endif()
        string(REGEX MATCH "[^ \t\r\n]*\\.${SOVERSION}\\.dylib" _soname "${_out}")
        if(_soname STREQUAL "")
            message(SEND_ERROR "Lts_SoVersion: ${_name} install name does not end in .${SOVERSION}.dylib:\n${_out}")
            math(EXPR _failures "${_failures} + 1")
        else()
            message(STATUS "Lts_SoVersion: ${_name} -> ${_soname}")
        endif()
    else()
        execute_process(COMMAND readelf -d "${_lib}"
            RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
        if(NOT _rc EQUAL 0)
            message(SEND_ERROR "Lts_SoVersion: readelf failed for ${_lib}: ${_err}")
            math(EXPR _failures "${_failures} + 1")
            continue()
        endif()
        # There are many [NEEDED] brackets. Take the SONAME one only:
        #   0x000000000000000e (SONAME) Library soname: [libRIBRender.so.1]
        if(_out MATCHES "SONAME[^\n]*\\[([^]]+)\\]")
            set(_soname "${CMAKE_MATCH_1}")
        endif()
        if(NOT _soname MATCHES "\\.so\\.${SOVERSION}$")
            message(SEND_ERROR "Lts_SoVersion: ${_name} SONAME '${_soname}' is not *.so.${SOVERSION}")
            math(EXPR _failures "${_failures} + 1")
        else()
            message(STATUS "Lts_SoVersion: ${_name} -> ${_soname}")
        endif()
    endif()
endforeach()

if(_failures GREATER 0)
    message(FATAL_ERROR "Lts_SoVersion: ${_failures} library(ies) failed the SOVERSION ${SOVERSION} check")
endif()
