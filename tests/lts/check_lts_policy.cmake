# The tracked support record must describe a two-year window and stay internally consistent.
if(NOT DEFINED LTS_JSON)
    message(FATAL_ERROR "Lts_PolicyFile: LTS_JSON is not set")
endif()
if(NOT EXISTS "${LTS_JSON}")
    message(FATAL_ERROR "Lts_PolicyFile: ${LTS_JSON} does not exist")
endif()

file(READ "${LTS_JSON}" _text)
string(JSON _years ERROR_VARIABLE _err GET "${_text}" policy support_years)
if(_err)
    message(FATAL_ERROR "Lts_PolicyFile: policy.support_years is missing (${_err})")
endif()
if(NOT _years EQUAL 2)
    message(FATAL_ERROR "Lts_PolicyFile: support window is ${_years} years, the policy is 2")
endif()

string(JSON _n ERROR_VARIABLE _err LENGTH "${_text}" lines)
if(_err)
    message(FATAL_ERROR "Lts_PolicyFile: lines is missing (${_err})")
endif()

if(_n EQUAL 0)
    message(STATUS "Lts_PolicyFile: no LTS lines recorded yet")
    return()
endif()

math(EXPR _last "${_n} - 1")
foreach(_i RANGE ${_last})
    string(JSON _ver GET "${_text}" lines ${_i} version)
    string(JSON _branch GET "${_text}" lines ${_i} branch)
    string(JSON _cut GET "${_text}" lines ${_i} cut_date)
    string(JSON _eol GET "${_text}" lines ${_i} eol_date)
    string(JSON _tag GET "${_text}" lines ${_i} first_tag)
    if(NOT _branch STREQUAL "release/${_ver}")
        message(FATAL_ERROR "Lts_PolicyFile: ${_ver} records branch '${_branch}', expected release/${_ver}")
    endif()
    if(NOT _tag STREQUAL "v${_ver}.0")
        message(FATAL_ERROR "Lts_PolicyFile: ${_ver} first tag is '${_tag}', expected v${_ver}.0")
    endif()
    if(NOT _cut MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$" OR
       NOT _eol MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$")
        message(FATAL_ERROR "Lts_PolicyFile: ${_ver} has unparseable dates cut=${_cut} eol=${_eol}")
    endif()
    string(SUBSTRING "${_cut}" 0 4 _cy)
    string(SUBSTRING "${_eol}" 0 4 _ey)
    math(EXPR _span "${_ey} - ${_cy}")
    if(NOT _span EQUAL 2)
        message(FATAL_ERROR "Lts_PolicyFile: ${_ver} EOL ${_eol} is not two years after ${_cut}")
    endif()
    string(SUBSTRING "${_cut}" 4 -1 _crest)
    string(SUBSTRING "${_eol}" 4 -1 _erest)
    # 29 February plus two years lands on 28 February.
    if(NOT _crest STREQUAL _erest AND NOT (_crest STREQUAL "-02-29" AND _erest STREQUAL "-02-28"))
        message(FATAL_ERROR "Lts_PolicyFile: ${_ver} month-day moved from ${_cut} to ${_eol}")
    endif()
    message(STATUS "Lts_PolicyFile: ${_branch} cut ${_cut} EOL ${_eol}")
endforeach()
