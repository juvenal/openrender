# Every name in required-symbols.txt must be a defined export of the named library.
if(NOT DEFINED LIBRARIES)
    message(FATAL_ERROR "Lts_ExportedSymbols: LIBRARIES is not set")
endif()
if(NOT DEFINED SYMBOL_LIST)
    message(FATAL_ERROR "Lts_ExportedSymbols: SYMBOL_LIST is not set")
endif()

string(REPLACE "|" ";" _libs "${LIBRARIES}")
file(STRINGS "${SYMBOL_LIST}" _rows)
set(_failures 0)
set(_checked 0)

function(_library_symbols lib outvar)
    if(APPLE)
        execute_process(COMMAND nm -gU "${lib}"
            RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    else()
        execute_process(COMMAND nm -D --defined-only "${lib}"
            RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    endif()
    if(NOT rc EQUAL 0)
        set(${outvar} "" PARENT_SCOPE)
        message(SEND_ERROR "Lts_ExportedSymbols: nm failed for ${lib}: ${err}")
        return()
    endif()
    set(${outvar} "${out}" PARENT_SCOPE)
endfunction()

foreach(_row IN LISTS _rows)
    string(STRIP "${_row}" _row)
    if(_row STREQUAL "" OR _row MATCHES "^#")
        continue()
    endif()
    string(REGEX MATCH "^([^ ]+)[ ]+([^ ]+)$" _ok "${_row}")
    if(NOT _ok)
        message(SEND_ERROR "Lts_ExportedSymbols: bad row '${_row}'")
        math(EXPR _failures "${_failures} + 1")
        continue()
    endif()
    set(_which "${CMAKE_MATCH_1}")
    set(_symbol "${CMAKE_MATCH_2}")
    set(_found_lib "")
    foreach(_lib IN LISTS _libs)
        if(_lib MATCHES "${_which}")
            set(_found_lib "${_lib}")
            break()
        endif()
    endforeach()
    if(_found_lib STREQUAL "")
        message(SEND_ERROR "Lts_ExportedSymbols: no library path contains '${_which}' for ${_symbol}")
        math(EXPR _failures "${_failures} + 1")
        continue()
    endif()
    _library_symbols("${_found_lib}" _syms)
    if(_syms STREQUAL "")
        math(EXPR _failures "${_failures} + 1")
        continue()
    endif()
    # Mach-O prints _RiBegin; ELF prints RiBegin. Match a whole token, either way.
    string(REGEX MATCH "(^|[^A-Za-z0-9_])_?${_symbol}([^A-Za-z0-9_]|$)" _hit "${_syms}")
    if(_hit STREQUAL "")
        message(SEND_ERROR "Lts_ExportedSymbols: ${_symbol} is not exported by ${_found_lib}")
        math(EXPR _failures "${_failures} + 1")
    else()
        math(EXPR _checked "${_checked} + 1")
        message(STATUS "Lts_ExportedSymbols: ${_symbol} in ${_found_lib}")
    endif()
endforeach()

if(_checked EQUAL 0)
    message(FATAL_ERROR "Lts_ExportedSymbols: no symbols were checked")
endif()
if(_failures GREATER 0)
    message(FATAL_ERROR "Lts_ExportedSymbols: ${_failures} failure(s)")
endif()
