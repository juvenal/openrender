# Dump the ABI of libRIBRender and libRIBCommon with abi-dumper when it is
# installed. The dump must mention the stable C symbols. A checked-in baseline
# under tests/lts/abi/baselines/<name>.dump is compared with
# abi-compliance-checker when both the baseline and the tool exist.
#
# Set OR_LTS_REQUIRE_ABI_TOOLS=1 (the release/* lts-verify job does) to fail
# instead of skipping when the tools or debug info are absent.
if(NOT DEFINED LIBRARIES OR NOT DEFINED SYMBOL_LIST)
    message(FATAL_ERROR "Lts_AbiDump: LIBRARIES and SYMBOL_LIST are required")
endif()

set(_require OFF)
if(DEFINED ENV{OR_LTS_REQUIRE_ABI_TOOLS} AND NOT "$ENV{OR_LTS_REQUIRE_ABI_TOOLS}" STREQUAL ""
   AND NOT "$ENV{OR_LTS_REQUIRE_ABI_TOOLS}" STREQUAL "false" AND NOT "$ENV{OR_LTS_REQUIRE_ABI_TOOLS}" STREQUAL "0")
    set(_require ON)
endif()

find_program(_READELF readelf)
if(NOT _READELF)
    if(_require)
        message(FATAL_ERROR "Lts_AbiDump: readelf is not installed")
    endif()
    message(STATUS "Lts_AbiDump: readelf not installed; skipping")
    return()
endif()

find_program(ABI_DUMPER abi-dumper)
if(NOT ABI_DUMPER)
    if(_require)
        message(FATAL_ERROR "Lts_AbiDump: abi-dumper is not installed")
    endif()
    message(STATUS "Lts_AbiDump: abi-dumper not installed; skipping (set OR_LTS_REQUIRE_ABI_TOOLS=1 to require it)")
    return()
endif()

string(REPLACE "|" ";" _libs "${LIBRARIES}")
file(STRINGS "${SYMBOL_LIST}" _rows)
set(_want "")
foreach(_row IN LISTS _rows)
    string(STRIP "${_row}" _row)
    if(_row STREQUAL "" OR _row MATCHES "^#")
        continue()
    endif()
    string(REGEX MATCH "^([^ ]+)[ ]+([^ ]+)$" _ok "${_row}")
    if(_ok)
        list(APPEND _want "${CMAKE_MATCH_1}|${CMAKE_MATCH_2}")
    endif()
endforeach()

set(_dumps "")
foreach(_lib IN LISTS _libs)
    get_filename_component(_name "${_lib}" NAME)
    # Only the two libraries the symbol list names. Skip the rest.
    if(NOT _name MATCHES "RIBRender" AND NOT _name MATCHES "RIBCommon")
        continue()
    endif()
    execute_process(COMMAND readelf -S "${_lib}" OUTPUT_VARIABLE _sections ERROR_QUIET)
    if(NOT _sections MATCHES "debug_")
        if(_require)
            message(FATAL_ERROR "Lts_AbiDump: ${_name} has no DWARF debug info; build with -g")
        endif()
        message(STATUS "Lts_AbiDump: ${_name} has no debug info; skipping dump")
        continue()
    endif()
    execute_process(COMMAND pwd OUTPUT_VARIABLE _cwd OUTPUT_STRIP_TRAILING_WHITESPACE)
    set(_out "${_cwd}/${_name}.abi.dump")
    execute_process(
        COMMAND "${ABI_DUMPER}" "${_lib}" -o "${_out}" -lver 1
        RESULT_VARIABLE _rc OUTPUT_VARIABLE _log ERROR_VARIABLE _err)
    if(NOT _rc EQUAL 0 OR NOT EXISTS "${_out}")
        message(FATAL_ERROR "Lts_AbiDump: abi-dumper failed for ${_name} (${_rc})\n${_log}\n${_err}")
    endif()
    file(READ "${_out}" _dump)
    foreach(_pair IN LISTS _want)
        string(REPLACE "|" ";" _parts "${_pair}")
        list(GET _parts 0 _which)
        list(GET _parts 1 _symbol)
        if(NOT _name MATCHES "${_which}")
            continue()
        endif()
        if(NOT _dump MATCHES "${_symbol}")
            message(FATAL_ERROR "Lts_AbiDump: ${_name} dump does not mention ${_symbol}")
        endif()
        message(STATUS "Lts_AbiDump: ${_symbol} present in ${_name}")
    endforeach()
    list(APPEND _dumps "${_out}")

    get_filename_component(_here "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
    set(_base "${_here}/abi/baselines/${_name}.dump")
    if(EXISTS "${_base}")
        find_program(ABI_CHECKER abi-compliance-checker)
        if(NOT ABI_CHECKER)
            if(_require)
                message(FATAL_ERROR "Lts_AbiDump: baseline ${_base} exists but abi-compliance-checker is not installed")
            endif()
            message(STATUS "Lts_AbiDump: baseline present, abi-compliance-checker absent; not compared")
        else()
            set(_report "${_cwd}/${_name}.abi-report")
            execute_process(
                COMMAND "${ABI_CHECKER}" -l "${_name}" -old "${_base}" -new "${_out}" -report-path "${_report}"
                RESULT_VARIABLE _rc OUTPUT_VARIABLE _log ERROR_VARIABLE _err)
            if(NOT _rc EQUAL 0)
                message(FATAL_ERROR "Lts_AbiDump: abi-compliance-checker reported an incompatible change in ${_name} (${_rc})\n${_log}\n${_err}")
            endif()
            message(STATUS "Lts_AbiDump: ${_name} is compatible with ${ _base}")
        endif()
    else()
        message(STATUS "Lts_AbiDump: no baseline ${_base} (dump only)")
    endif()
endforeach()

if(_require AND _dumps STREQUAL "")
    message(FATAL_ERROR "Lts_AbiDump: required ABI dump produced nothing")
endif()
message(STATUS "Lts_AbiDump: done")
