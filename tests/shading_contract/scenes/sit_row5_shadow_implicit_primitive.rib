##RenderMan RIB-Structure 1.0
# Spec 029 Situations scene (tests/shading_contract): row 6 meets row 5: an implicit-surface (0-D) shadow hit, transmissionhitmode "primitive"
# (the default). The occluder above the sphere is the implicit plug-in fixture of tests/plugins/implicit (a unit sphere field). The case
# that renders this scene sets Option "searchpath" "procedural" to SHADING_CONTRACT_IMPLICIT_DIR (the directory of good.dsply) first.
version 3.03
Hider "raytrace"
Option "shaderformat" "default" ["rslo"]
Option "sampling" "sampler" ["sobol"]
Option "sampling" "seed" [1]
Option "limits" "numthreads" [1]
PixelSamples 1 1
Format 8 8 1
Projection "perspective" "fov" 30
Clipping 0.1 100
Translate 0 0 5
WorldBegin
  Attribute "visibility" "int transmission" [1]
  AttributeBegin
    Surface "sit_transmit"
    Sphere 1 -1 1 360
  AttributeEnd
  AttributeBegin
    Surface "sit_marker"
    Translate 0 2.6 0
    Scale 0.7 0.7 0.7
    Geometry "implicit" "string file" ["good.dsply"]
  AttributeEnd
WorldEnd
