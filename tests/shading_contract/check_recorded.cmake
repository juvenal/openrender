# Spec 033 (Phase 1): a characterisation recorded on the unchanged tree and compared as text.
#
#   cmake -DEXE=<program> -DMODES=rslo,slo -DREF=<reference file> [-DREF_PLATFORM=<file>] [-DPATHS=<dir>,<dir>] -P check_recorded.cmake
#
# Runs EXE once per mode (a mode may carry more arguments, separated by ':'; one RiBegin session per process, GitHub #2) with the environment ctest set, records
# "### <mode>" followed by the program's standard output (each directory of PATHS replaced by <dir1>, <dir2>, ...) and
# compares the whole with REF. The standard error is printed on failure and is not part of the record. A missing REF is
# written on the first run and never overwritten: this script has no mode that replaces an existing reference.

foreach(_v EXE MODES REF)
    if(NOT DEFINED ${_v})
        message(FATAL_ERROR "check_recorded.cmake: ${_v} is not set")
    endif()
endforeach()
# A platform whose output differs bit for bit keeps a copy of its own (REF_PLATFORM), which is preferred when it exists
if(DEFINED REF_PLATFORM AND EXISTS "${REF_PLATFORM}")
    set(REF "${REF_PLATFORM}")
endif()
string(REPLACE "," ";" _modes "${MODES}")
set(_paths "")
if(DEFINED PATHS)
    string(REPLACE "," ";" _paths "${PATHS}")
endif()

set(_record "")
foreach(_mode IN LISTS _modes)
    string(REPLACE ":" ";" _args "${_mode}")
    execute_process(COMMAND "${EXE}" ${_args} RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 300)
    if(NOT _rc EQUAL 0)
        message(FATAL_ERROR "${EXE} ${_mode} exited ${_rc}\n--- stdout\n${_out}\n--- stderr\n${_err}")
    endif()
    set(_i 0)
    foreach(_p IN LISTS _paths)
        math(EXPR _i "${_i} + 1")
        string(REPLACE "${_p}" "<dir${_i}>" _out "${_out}")
    endforeach()
    string(APPEND _record "### ${_mode}\n${_out}")
endforeach()

get_filename_component(_name "${REF}" NAME)
if(NOT EXISTS "${REF}")
    get_filename_component(_d "${REF}" DIRECTORY)
    file(MAKE_DIRECTORY "${_d}")
    file(WRITE "${REF}" "${_record}")
    message(STATUS "${_name}: recorded ${REF}")
    return()
endif()
file(READ "${REF}" _ref)
if(_ref STREQUAL _record)
    message(STATUS "${_name}: identical to ${REF}")
    return()
endif()
string(REPLACE "\n" ";" _a "${_ref}")
string(REPLACE "\n" ";" _b "${_record}")
list(LENGTH _a _na)
list(LENGTH _b _nb)
set(_i 0)
while(_i LESS _na AND _i LESS _nb)
    list(GET _a ${_i} _la)
    list(GET _b ${_i} _lb)
    if(NOT _la STREQUAL _lb)
        break()
    endif()
    math(EXPR _i "${_i} + 1")
endwhile()
set(_la "<end>")
set(_lb "<end>")
if(_i LESS _na)
    list(GET _a ${_i} _la)
endif()
if(_i LESS _nb)
    list(GET _b ${_i} _lb)
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${_name}.fresh" "${_record}")
message(FATAL_ERROR "${_name}: the output differs from ${REF} at line ${_i}:\n  reference: ${_la}\n  fresh:     ${_lb}\nThe fresh record is ${CMAKE_CURRENT_BINARY_DIR}/${_name}.fresh")
