# Runs the registries static consumer (Link_StaticConsumerRegistries, spec 030) once per shader format.
# -DEXE=<test_link_static_consumer_registries> -DFORMATS=<rslo[;slo]>
# The environment (SHADERS, ORENDERHOME, DISPLAYS) is the test's. Modelled on run_static_consumer.cmake, which stays as it is.
foreach(_v EXE FORMATS)
    if(NOT DEFINED ${_v})
        message(FATAL_ERROR "run_static_consumer_registries: -D${_v}= is required")
    endif()
endforeach()
set(_bad 0)
foreach(_fmt IN LISTS FORMATS)
    message(STATUS "Link_StaticConsumerRegistries: shader format ${_fmt}")
    execute_process(COMMAND "${EXE}" ${_fmt} RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    message(STATUS "${_out}${_err}")
    # The expected names, exactly and in order (research R13).
    if(NOT _out MATCHES "hiders: raytrace reyes zbuffer photon\n")
        message(STATUS "FAIL: the hider registry does not list raytrace reyes zbuffer photon for ${_fmt}")
        math(EXPR _bad "${_bad} + 1")
    endif()
    if(NOT _out MATCHES "integrators: classic\n")
        message(STATUS "FAIL: the integrator registry does not list exactly classic for ${_fmt}")
        math(EXPR _bad "${_bad} + 1")
    endif()
    if(NOT _rc EQUAL 0)
        message(STATUS "FAIL: the consumer exited with ${_rc} for ${_fmt}")
        math(EXPR _bad "${_bad} + 1")
    endif()
endforeach()
if(_bad GREATER 0)
    message(FATAL_ERROR "Link_StaticConsumerRegistries: ${_bad} check(s) failed")
endif()
