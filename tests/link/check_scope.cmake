# T-S1 ShadingScope_Greps (spec 029, FR-006, FR-008, FR-024).
#
# The scope of Shading and the hiders, one sub-check per phase, each enabled in the phase that makes it true:
#   S1a  no #include of a src/ri/hiders header under src/libshader, and src/ri/hiders is not on the shading library's include path
#   S1b  no include of photonMap.h (Core's since spec 032) or irradianceCache.h (the concrete cache; irradiance.h before spec 032)
#        under src/libshader, and bundles.h only as the Shading-local
#        src/libshader/shading/bundles.h (src/ri/hiders/bundles.h absent)
#   S1c  CShadingContext's class body in shading.h (from `class CShadingContext` to its closing `};`; CRayBundle's virtuals
#        are its protocol and stay) has no `virtual` and no `friend` other than CProgrammableShaderInstance; the class is
#        `final`; no `public CShadingContext` anywhere under src/ and tests/ outside tests/link/
#   S1d  no trace(, traceEx or traceAny member in that body; no frameTracer or CHiderTracer anywhere under src/ and tests/
#        outside tests/link/; src/ri/hiders/hiderTracer.{h,cpp} absent
#   S1e  no #include of a src/ri/geometry header and no object.h under src/libshader; src/ri/geometry is not on the
#        shading library's include path
#   S1f  no `friend class C(PhotonHider|SphereLight|QuadLight)` under src/libshader
# Every scan of src/ and tests/ skips tests/link/ (this script's own patterns appear there verbatim); specs/ is never scanned.
#
#   -DSOURCE_DIR=<repository root> -DBUILD_DIR=<build tree> -DCHECKS=<S1a;S1b;...>
# An empty CHECKS list is an error, so the registered test cannot pass vacuously.

foreach(_v SOURCE_DIR BUILD_DIR)
    if(NOT DEFINED ${_v})
        message(FATAL_ERROR "check_scope: -D${_v}= is required")
    endif()
endforeach()
if(NOT DEFINED CHECKS OR "${CHECKS}" STREQUAL "")
    message(FATAL_ERROR "check_scope: CHECKS is empty: no sub-check is enabled yet (a scope test with nothing to check must not pass)")
endif()
foreach(_c IN LISTS CHECKS)
    if(NOT _c MATCHES "^S1[a-f]$")
        message(FATAL_ERROR "check_scope: unknown sub-check '${_c}'")
    endif()
endforeach()

set(_src "${SOURCE_DIR}/src")
set(_exts "h" "hpp" "cpp" "cc" "mm" "inl" "y" "l")

# ---- helpers ----------------------------------------------------------------------------------------------------
function(_collect VAR)   # _collect(VAR <dir> ...): source files below the directories
    set(_all "")
    foreach(_d IN LISTS ARGN)
        foreach(_e IN LISTS _exts)
            file(GLOB_RECURSE _g "${_d}/*.${_e}")
            list(APPEND _all ${_g})
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES _all)
    set(${VAR} "${_all}" PARENT_SCOPE)
endfunction()

function(_basenames VAR)   # _basenames(VAR <dir>): the *.h names of a directory
    file(GLOB _h RELATIVE "${ARGV1}" "${ARGV1}/*.h")
    set(${VAR} "${_h}" PARENT_SCOPE)
endfunction()

# the lines of a file that match a regular expression, as a list safe from CMake's list syntax (a ';' inside a line must
# not split it): ';' '[' ']' are replaced by placeholders in the returned elements
function(_lines_matching FILE REGEX OUTVAR)
    file(READ "${FILE}" _text)
    string(REPLACE ";" "@SEMI@" _text "${_text}")
    string(REPLACE "[" "@LB@" _text "${_text}")
    string(REPLACE "]" "@RB@" _text "${_text}")
    string(REPLACE "\n" ";" _ls "${_text}")
    set(_r "")
    foreach(_l IN LISTS _ls)
        if(_l MATCHES "${REGEX}")
            list(APPEND _r "${_l}")
        endif()
    endforeach()
    set(${OUTVAR} "${_r}" PARENT_SCOPE)
endfunction()

# include lines of a file as `line:header`
function(_includes_of FILE OUTVAR)
    file(STRINGS "${FILE}" _lines REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"]")
    set(_r "")
    foreach(_l IN LISTS _lines)
        if(_l MATCHES "#[ \t]*include[ \t]*[<\"]([^>\"]+)[>\"]")
            list(APPEND _r "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    set(${OUTVAR} "${_r}" PARENT_SCOPE)
endfunction()

# The -I directories of the shading library's compile line (flags.make of its target)
set(_flags "${BUILD_DIR}/src/libshader/shading/CMakeFiles/libshader_shading.dir/flags.make")
set(_include_dirs "")
if(EXISTS "${_flags}")
    file(STRINGS "${_flags}" _inc REGEX "^CXX_INCLUDES")
    string(REGEX REPLACE "^CXX_INCLUDES = " "" _inc "${_inc}")
    string(REPLACE " " ";" _inc "${_inc}")
    foreach(_t IN LISTS _inc)
        if(_t MATCHES "^-I(.*)$" OR _t MATCHES "^-isystem(.*)$")
            string(REGEX REPLACE "/\\.$" "" _d "${CMAKE_MATCH_1}")
            string(REGEX REPLACE "/+$" "" _d "${_d}")
            list(APPEND _include_dirs "${_d}")
        endif()
    endforeach()
endif()

set(_failed "")
function(_fail ID TEXT)
    string(REPLACE "@SEMI@" ";" TEXT "${TEXT}")
    string(REPLACE "@LB@" "[" TEXT "${TEXT}")
    string(REPLACE "@RB@" "]" TEXT "${TEXT}")
    message(STATUS "FAIL ${ID}: ${TEXT}")
    set(_failed "${_failed};${ID}" PARENT_SCOPE)
endfunction()

set(_shading_files "")
_collect(_shading_files "${_src}/libshader")
set(_hider_headers "")
_basenames(_hider_headers "${_src}/ri/hiders")
set(_geometry_headers "")
_basenames(_geometry_headers "${_src}/ri/geometry")
set(_local_headers "")
_basenames(_local_headers "${_src}/libshader/shading")

# an include of one of the Hiders' (or Geometry's) headers: its basename names a header of that directory and no header of
# the same name sits in Shading's own directory (the local one wins)
function(_scan_foreign_includes ID DIRNAME NAMES OUTVAR)
    set(_hit "")
    foreach(_f IN LISTS _shading_files)
        _includes_of("${_f}" _incs)
        foreach(_i IN LISTS _incs)
            string(REGEX REPLACE "^.*/" "" _b "${_i}")
            list(FIND ${NAMES} "${_b}" _idx)
            list(FIND _local_headers "${_b}" _lidx)
            set(_by_path FALSE)
            if(_i MATCHES "(^|/)${DIRNAME}/")
                set(_by_path TRUE)
            endif()
            if((NOT _idx EQUAL -1 AND _lidx EQUAL -1) OR _by_path)
                file(RELATIVE_PATH _rel "${SOURCE_DIR}" "${_f}")
                list(APPEND _hit "${_rel} includes ${_i}")
            endif()
        endforeach()
    endforeach()
    set(${OUTVAR} "${_hit}" PARENT_SCOPE)
endfunction()

function(_on_include_path DIR OUTVAR)
    foreach(_d IN LISTS _include_dirs)
        if(_d STREQUAL "${DIR}")
            set(${OUTVAR} TRUE PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(${OUTVAR} FALSE PARENT_SCOPE)
endfunction()

# lines (file:line) of the sources and tests outside tests/link/ that match a regular expression
function(_grep_tree REGEX OUTVAR)
    _collect(_files "${_src}" "${SOURCE_DIR}/tests")
    set(_hit "")
    foreach(_f IN LISTS _files)
        if(_f MATCHES "/tests/link/")
            continue()
        endif()
        _lines_matching("${_f}" "${REGEX}" _lines)
        foreach(_l IN LISTS _lines)
            file(RELATIVE_PATH _rel "${SOURCE_DIR}" "${_f}")
            string(STRIP "${_l}" _l)
            list(APPEND _hit "${_rel}: ${_l}")
        endforeach()
    endforeach()
    set(${OUTVAR} "${_hit}" PARENT_SCOPE)
endfunction()

# CShadingContext's class body, comments removed: from `class CShadingContext` to the first `};` at column 0
function(_context_body OUTVAR)
    file(READ "${_src}/libshader/shading/shading.h" _all)
    string(FIND "${_all}" "\nclass CShadingContext" _start)
    if(_start EQUAL -1)
        message(FATAL_ERROR "check_scope: no 'class CShadingContext' in shading.h")
    endif()
    string(SUBSTRING "${_all}" ${_start} -1 _rest)
    string(FIND "${_rest}" "\n};" _end)
    string(SUBSTRING "${_rest}" 0 ${_end} _body)
    # /* ... */ and // ... comments
    string(REGEX REPLACE "/\\*[^*]*\\*+([^/*][^*]*\\*+)*/" "" _body "${_body}")
    string(REGEX REPLACE "//[^\n]*" "" _body "${_body}")
    string(REPLACE ";" "@SEMI@" _body "${_body}")
    string(REPLACE "[" "@LB@" _body "${_body}")
    string(REPLACE "]" "@RB@" _body "${_body}")
    set(${OUTVAR} "${_body}" PARENT_SCOPE)
endfunction()

# ---- the sub-checks -----------------------------------------------------------------------------------------------
foreach(_c IN LISTS CHECKS)
    if(_c STREQUAL "S1a")
        _scan_foreign_includes(S1a hiders _hider_headers _hits)
        foreach(_h IN LISTS _hits)
            _fail(S1a "${_h}")
        endforeach()
        _on_include_path("${_src}/ri/hiders" _on)
        if(NOT EXISTS "${_flags}")
            _fail(S1a "cannot read the shading library's include path: ${_flags} does not exist")
        elseif(_on)
            _fail(S1a "src/ri/hiders is on the shading library's include path")
        endif()
    elseif(_c STREQUAL "S1b")
        foreach(_f IN LISTS _shading_files)
            _includes_of("${_f}" _incs)
            foreach(_i IN LISTS _incs)
                string(REGEX REPLACE "^.*/" "" _b "${_i}")
                if(_b STREQUAL "photonMap.h" OR _b STREQUAL "irradianceCache.h")
                    file(RELATIVE_PATH _rel "${SOURCE_DIR}" "${_f}")
                    _fail(S1b "${_rel} includes ${_i}")
                endif()
            endforeach()
        endforeach()
        if(NOT EXISTS "${_src}/libshader/shading/bundles.h")
            _fail(S1b "src/libshader/shading/bundles.h does not exist (bundles.h is still the Hiders' header)")
        endif()
        if(EXISTS "${_src}/ri/hiders/bundles.h")
            _fail(S1b "src/ri/hiders/bundles.h still exists")
        endif()
    elseif(_c STREQUAL "S1c")
        _context_body(_body)
        string(REGEX MATCHALL "virtual[^\n]*" _virtuals "${_body}")
        foreach(_v IN LISTS _virtuals)
            string(STRIP "${_v}" _v)
            _fail(S1c "virtual member in CShadingContext: ${_v}")
        endforeach()
        string(REGEX MATCHALL "friend[ \t]+[^\n@]*" _friends "${_body}")
        foreach(_fr IN LISTS _friends)
            string(STRIP "${_fr}" _fr)
            if(NOT _fr STREQUAL "friend class CProgrammableShaderInstance")
                _fail(S1c "friend in CShadingContext: ${_fr}")
            endif()
        endforeach()
        file(READ "${_src}/libshader/shading/shading.h" _all)
        if(NOT _all MATCHES "\nclass CShadingContext final")
            _fail(S1c "CShadingContext is not final")
        endif()
        _grep_tree("public[ \t]+CShadingContext" _subs)
        foreach(_s IN LISTS _subs)
            _fail(S1c "a subclass of CShadingContext: ${_s}")
        endforeach()
    elseif(_c STREQUAL "S1d")
        _context_body(_body)
        string(REGEX MATCHALL "[A-Za-z_:<>*& ]*[ *&](trace|traceEx|traceAny)\\(" _traces "${_body}")
        foreach(_t IN LISTS _traces)
            string(STRIP "${_t}" _t)
            _fail(S1d "trace member in CShadingContext: ${_t}")
        endforeach()
        _grep_tree("frameTracer|CHiderTracer" _ft)
        foreach(_s IN LISTS _ft)
            _fail(S1d "${_s}")
        endforeach()
        foreach(_h hiderTracer.h hiderTracer.cpp)
            if(EXISTS "${_src}/ri/hiders/${_h}")
                _fail(S1d "src/ri/hiders/${_h} exists")
            endif()
        endforeach()
    elseif(_c STREQUAL "S1e")
        _scan_foreign_includes(S1e geometry _geometry_headers _hits)
        foreach(_h IN LISTS _hits)
            _fail(S1e "${_h}")
        endforeach()
        foreach(_f IN LISTS _shading_files)
            _includes_of("${_f}" _incs)
            foreach(_i IN LISTS _incs)
                string(REGEX REPLACE "^.*/" "" _b "${_i}")
                if(_b STREQUAL "object.h")
                    file(RELATIVE_PATH _rel "${SOURCE_DIR}" "${_f}")
                    _fail(S1e "${_rel} includes ${_i}")
                endif()
            endforeach()
        endforeach()
        _on_include_path("${_src}/ri/geometry" _on)
        if(NOT EXISTS "${_flags}")
            _fail(S1e "cannot read the shading library's include path: ${_flags} does not exist")
        elseif(_on)
            _fail(S1e "src/ri/geometry is on the shading library's include path")
        endif()
    elseif(_c STREQUAL "S1f")
        foreach(_f IN LISTS _shading_files)
            _lines_matching("${_f}" "friend[ \t]+class[ \t]+C(PhotonHider|SphereLight|QuadLight)" _lines)
            foreach(_l IN LISTS _lines)
                file(RELATIVE_PATH _rel "${SOURCE_DIR}" "${_f}")
                string(STRIP "${_l}" _l)
                _fail(S1f "${_rel}: ${_l}")
            endforeach()
        endforeach()
    endif()
endforeach()

# which sub-checks failed
set(_ids "")
foreach(_c IN LISTS CHECKS)
    list(FIND _failed "${_c}" _idx)
    if(_idx EQUAL -1)
        message(STATUS "PASS ${_c}")
    else()
        list(APPEND _ids "${_c}")
    endif()
endforeach()
if(_ids)
    message(FATAL_ERROR "ShadingScope_Greps: failing sub-check(s): ${_ids}")
endif()
