# Runs the static consumer (T-L2) once per shader format. -DEXE=<test_link_static_consumer> -DFORMATS=<rslo[;slo]>
# The environment (SHADERS, ORENDERHOME, DISPLAYS) is the test's.
foreach(_v EXE FORMATS)
    if(NOT DEFINED ${_v})
        message(FATAL_ERROR "run_static_consumer: -D${_v}= is required")
    endif()
endforeach()
set(_bad 0)
foreach(_fmt IN LISTS FORMATS)
    message(STATUS "Link_StaticConsumer: shader format ${_fmt}")
    execute_process(COMMAND "${EXE}" ${_fmt} RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    message(STATUS "${_out}${_err}")
    if(NOT _rc EQUAL 0)
        message(STATUS "FAIL: the consumer exited with ${_rc} for ${_fmt}")
        math(EXPR _bad "${_bad} + 1")
    endif()
endforeach()
if(_bad GREATER 0)
    message(FATAL_ERROR "Link_StaticConsumer: ${_bad} format(s) failed")
endif()
