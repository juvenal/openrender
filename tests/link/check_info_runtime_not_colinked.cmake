# Link_InfoRuntimeNotCoLinked (spec 033, DEP-4; contracts/checks-and-tests.md): no program or library is linked with two owners of the
# flex/bison "rslo*" globals. The shading engine's loader parser (libRSLRuntime), the inspection parser (libRSLInfo) and the compiler's
# own parser (libshader_compiler) share the prefix "rslo" and define the same globals. On ELF the first image loaded interposes the
# others' parser (macOS two-level namespaces hide it), so today the three are kept apart by convention only; this check makes it a rule.
#
#   cmake -DBUILD_DIR=<build tree> [-DEXTRA_LINK_DIR=<dir of extra link.txt files>] [-DEXTRA_DEPS=<file>] -P check_info_runtime_not_colinked.cmake
#
# The owners are named in one list below; spec 043 renames libshader_compiler to libRSLCompile, which is a one-word change of that list.
# Two passes:
#   1. Link lines: every CMakeFiles/<target>.dir/link.txt under BUILD_DIR fails, naming its target directory, if it names two owners.
#   2. Resolved dependencies: for every executable and shared library the build produces (the outputs of those link lines), the
#      direct dependents are read with otool -L (macOS) or readelf -d NEEDED (Linux), resolved to files of the build tree and followed;
#      the closure of an image must hold at most one owner (this catches a transitive co-link: a library that links libRSLInfo
#      linked by a program that links libRSLRuntime).
# The two options exist for the mutation checks (scratch copies, never left in the tree): EXTRA_LINK_DIR adds link.txt files to
# pass 1; EXTRA_DEPS adds lines "<image> : <dependency> ..." to pass 2.
if(NOT DEFINED BUILD_DIR)
    message(FATAL_ERROR "check_info_runtime_not_colinked: -DBUILD_DIR= is required")
endif()
cmake_policy(SET CMP0057 NEW) # if(<x> IN_LIST <list>), the floor is 3.19

# <owner name>=<the library file base the owner is recognised by>
set(OWNER_NAMES RSLRuntime RSLInfo shader_compiler)
set(OWNER_BASES libRSLRuntime libRSLInfo libshader_compiler)

# the owner a file name belongs to ("" for none): libRSLInfo.1.dylib, libRSLInfo.so.1, libRSLInfo.a, -lRSLInfo ...
function(owner_of NAME OUT)
    get_filename_component(_n "${NAME}" NAME)
    set(_r "")
    list(LENGTH OWNER_NAMES _count)
    math(EXPR _last "${_count} - 1")
    foreach(_i RANGE ${_last})
        list(GET OWNER_BASES ${_i} _base)
        if(_n MATCHES "^${_base}(\\.|$|_static)" OR _n STREQUAL "${_base}")
            list(GET OWNER_NAMES ${_i} _r)
        endif()
    endforeach()
    set(${OUT} "${_r}" PARENT_SCOPE)
endfunction()

set(_problems "")

# ---- pass 1: link lines ----
file(GLOB_RECURSE _all_txt "${BUILD_DIR}/*link.txt")
set(_links "")
foreach(_f IN LISTS _all_txt)
    # the sub-builds of the install-layout and package tests are copies of the same targets, made and removed while other tests run:
    # they are not read
    if(_f MATCHES "/CMakeFiles/[^/]+\\.dir/link\\.txt$" AND NOT _f MATCHES "/(install_layouts|package_work)/")
        list(APPEND _links "${_f}")
    endif()
endforeach()
if(DEFINED EXTRA_LINK_DIR)
    file(GLOB _extra "${EXTRA_LINK_DIR}/*.txt")
    list(APPEND _links ${_extra})
endif()
set(_outputs "")
set(_checked 0)
foreach(_file IN LISTS _links)
    file(READ "${_file}" _line)
    string(REPLACE "\n" " " _line "${_line}")
    string(REPLACE "\"" "" _line "${_line}")
    separate_arguments(_tokens UNIX_COMMAND "${_line}")
    set(_owners "")
    set(_output "")
    set(_skip FALSE)
    foreach(_t IN LISTS _tokens)
        if(_skip)
            if(_skip STREQUAL "OUT")
                set(_output "${_t}")
            endif()
            set(_skip FALSE)
            continue()
        endif()
        if(_t STREQUAL "-o")
            set(_skip "OUT")
            continue()
        endif()
        if(_t STREQUAL "-install_name" OR _t STREQUAL "-soname")
            set(_skip TRUE)
            continue()
        endif()
        if(_t MATCHES "^-Wl,-soname" OR _t MATCHES "^-Wl,-install_name")
            continue()
        endif()
        if(_t MATCHES "^-l(.+)$")
            owner_of("lib${CMAKE_MATCH_1}" _o)
        else()
            owner_of("${_t}" _o)
        endif()
        if(_o)
            list(APPEND _owners "${_o}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _owners)
    list(LENGTH _owners _n)
    math(EXPR _checked "${_checked} + 1")
    if(_n GREATER 1)
        get_filename_component(_d "${_file}" DIRECTORY)
        get_filename_component(_d "${_d}" NAME)
        string(REPLACE ";" " and " _text "${_owners}")
        string(APPEND _problems "\n  ${_d}: the link line names ${_text}")
    endif()
    if(_output AND NOT _output MATCHES "\\.a$")
        get_filename_component(_dir "${_file}" DIRECTORY)   # <dir>/CMakeFiles/<t>.dir
        get_filename_component(_dir "${_dir}" DIRECTORY)    # <dir>/CMakeFiles
        get_filename_component(_dir "${_dir}" DIRECTORY)    # <dir>: the link command runs there
        get_filename_component(_abs "${_output}" ABSOLUTE BASE_DIR "${_dir}")
        list(APPEND _outputs "${_abs}")
    endif()
endforeach()
list(LENGTH _links _nlinks)
message(STATUS "Link_InfoRuntimeNotCoLinked: pass 1 read ${_nlinks} link lines")

# ---- pass 2: resolved dependencies ----
# the images of the build tree by file name, so a dependency name resolves to a file of the tree
set(_index_names "")
foreach(_o IN LISTS _outputs)
    get_filename_component(_n "${_o}" NAME)
    list(APPEND _index_names "${_n}")
    set(_where_${_n} "${_o}")
endforeach()
# a versioned name (libRSLInfo.1.dylib, libRSLInfo.so.1) is a symlink beside the real file: index those too
foreach(_o IN LISTS _outputs)
    get_filename_component(_dir "${_o}" DIRECTORY)
    get_filename_component(_n "${_o}" NAME_WE)
    file(GLOB _siblings "${_dir}/${_n}*")
    foreach(_s IN LISTS _siblings)
        get_filename_component(_sn "${_s}" NAME)
        if(NOT DEFINED _where_${_sn})
            set(_where_${_sn} "${_o}")
            list(APPEND _index_names "${_sn}")
        endif()
    endforeach()
endforeach()

# the dependency names of one image
function(deps_of IMAGE OUT)
    set(_list "")
    if(APPLE)
        execute_process(COMMAND otool -L "${IMAGE}" OUTPUT_VARIABLE _txt ERROR_QUIET)
        string(REPLACE "\n" ";" _lines "${_txt}")
        foreach(_l IN LISTS _lines)
            if(_l MATCHES "^[ \t]+([^ ]+) \\(")
                get_filename_component(_n "${CMAKE_MATCH_1}" NAME)
                list(APPEND _list "${_n}")
            endif()
        endforeach()
    else()
        execute_process(COMMAND readelf -d "${IMAGE}" OUTPUT_VARIABLE _txt ERROR_QUIET)
        string(REPLACE "\n" ";" _lines "${_txt}")
        foreach(_l IN LISTS _lines)
            if(_l MATCHES "\\(NEEDED\\)[ \t]+Shared library: \\[([^]]+)\\]")
                list(APPEND _list "${CMAKE_MATCH_1}")
            endif()
        endforeach()
    endif()
    set(${OUT} "${_list}" PARENT_SCOPE)
endfunction()

# the extra dependency lines of the mutation check: "<image name> : <dependency> ..."
set(_extra_names "")
if(DEFINED EXTRA_DEPS)
    file(STRINGS "${EXTRA_DEPS}" _elines)
    foreach(_l IN LISTS _elines)
        if(_l MATCHES "^([^ :]+)[ \t]*:[ \t]*(.*)$")
            set(_e_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
            list(APPEND _extra_names "${CMAKE_MATCH_1}")
        endif()
    endforeach()
endif()

set(_image_count 0)
set(_roots ${_outputs} ${_extra_names})
list(REMOVE_DUPLICATES _roots)
foreach(_root IN LISTS _roots)
    get_filename_component(_root_name "${_root}" NAME)
    # the root is read from its own file: several copies of one name exist (the install-layout trees), the index holds one of them
    if(EXISTS "${_root}")
        set(_where_${_root_name} "${_root}")
        unset(_depcache_${_root_name})
    endif()
    # breadth-first closure of the image over names resolved in the build tree
    set(_queue "${_root_name}")
    set(_seen "")
    set(_owners "")
    set(_owner_chain "")
    while(_queue)
        list(POP_FRONT _queue _name)
        if(_name IN_LIST _seen)
            continue()
        endif()
        list(APPEND _seen "${_name}")
        owner_of("${_name}" _o)
        if(_o)
            list(APPEND _owners "${_o}")
        endif()
        set(_d "")
        if(DEFINED _where_${_name})
            if(NOT DEFINED _depcache_${_name})
                deps_of("${_where_${_name}}" _dd)
                set(_depcache_${_name} "${_dd}")
            endif()
            set(_d "${_depcache_${_name}}")
        endif()
        if(DEFINED _e_${_name})
            separate_arguments(_extra_d UNIX_COMMAND "${_e_${_name}}")
            list(APPEND _d ${_extra_d})
        endif()
        foreach(_x IN LISTS _d)
            if(DEFINED _where_${_x} OR DEFINED _e_${_x})
                list(APPEND _queue "${_x}")
            else()
                # not in the tree (a system library, LLVM, ...): still an owner if it is named like one
                owner_of("${_x}" _xo)
                if(_xo)
                    list(APPEND _owners "${_xo}")
                endif()
            endif()
        endforeach()
    endwhile()
    list(REMOVE_DUPLICATES _owners)
    list(LENGTH _owners _n)
    math(EXPR _image_count "${_image_count} + 1")
    if(_n GREATER 1)
        string(REPLACE ";" " and " _text "${_owners}")
        string(APPEND _problems "\n  ${_root_name}: its dependencies hold ${_text}")
    endif()
endforeach()
message(STATUS "Link_InfoRuntimeNotCoLinked: pass 2 followed the dependencies of ${_image_count} images")

if(NOT "${_problems}" STREQUAL "")
    message(FATAL_ERROR "Link_InfoRuntimeNotCoLinked: two owners of the rslo parser globals in one program:${_problems}")
endif()
message(STATUS "Link_InfoRuntimeNotCoLinked: no program names two of ${OWNER_NAMES} (${_nlinks} link lines, ${_image_count} images)")
