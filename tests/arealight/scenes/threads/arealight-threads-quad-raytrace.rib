##RenderMan RIB-Structure 1.0
# Spec 057 (proposed): the quad probe scene at 128 x 128 (64 buckets), rendered at -t:1 and -t:4 by AreaLight_ThreadsIdentical
# Spec 057 (area-light geometry), generated by specs/057-area-light-geometry/tools/gen_scenes.py: do not edit.
# AreaLightProbe_QuadIrradiance: a Lambertian plane (al_surface_matte, z = 4) under one quad (x = 3, facing -x, 2 x 2)
# running the SHIPPED arealight shader (intensity 10): Cl = I N.normalize(L) / (L.L). The renderer adds 1/(n p_A) and the
# visibility only (Decision A), so the pixel is  I * integral cos_e cos_r / r^2 dA  of the closed form. n = 16 (the default).
# Expected (probe_expected.py), the same on every hider and in .rslo and .slo:
#   pixel (3, 3): expected 1.178695069, tolerance 0.091576564 (4 sigma_1 / sqrt(16), sigma_1 = 0.091576564)
#   pixel (1, 2): expected 0.879695774, tolerance 0.081849551 (4 sigma_1 / sqrt(16), sigma_1 = 0.081849551)
#   pixel (6, 5): expected 1.782001963, tolerance 0.318020023 (4 sigma_1 / sqrt(16), sigma_1 = 0.318020023)
version 3.03
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "arealight-threads-quad-raytrace.tif" "file" "rgba"
Format 128 128 1
Projection "orthographic"
Clipping 0.1 100
WorldBegin
  AttributeBegin
    AreaLightSource "arealight" 1 "float intensity" [10]
    Surface "constant"
    Polygon "P" [3 -1 1  3 -1 3  3 1 3  3 1 1]
  AttributeEnd
  Illuminate 1 1
  AttributeBegin
    Surface "al_surface_matte"
    Polygon "P" [-1 -1 4  1 -1 4  1 1 4  -1 1 4]
  AttributeEnd
WorldEnd
