#!version 1.0.0
#!name "ptlined_probe"
surface
#!parameters:
#!variables:
varying	vector	a
varying	vector	b
varying	float	d1
varying	float	d2
varying	float	d3
uniform	vector	temporary_0
varying	vector	temporary_1
uniform	float	temporary_2
varying	float	temporary_3
varying	float	temporary_4
varying	float	temporary_5
#!Init:
	return            
#!Code:
	vfromf  temporary_0 0 0 0
	vuvector  a temporary_0
	vfromf  temporary_0 1 0 0
	vuvector  b temporary_0
	vfromf  temporary_0 0.5 1 0
	vuvector  temporary_1 temporary_0
	ptlined	("f=ppp")  d1 temporary_1 a b
	vufloat  temporary_2 -1
	vfromf  temporary_0 temporary_2 0 0
	vuvector  temporary_1 temporary_0
	ptlined	("f=ppp")  d2 temporary_1 a b
	vfromf  temporary_0 2 0 0
	vuvector  temporary_1 temporary_0
	ptlined	("f=ppp")  d3 temporary_1 a b
	vufloat  temporary_4 2
	divff  temporary_3 d2 temporary_4
	moveff  temporary_5 temporary_4
	divff  temporary_4 d3 temporary_5
	vfromf  Ci d1 temporary_3 temporary_4
	return
