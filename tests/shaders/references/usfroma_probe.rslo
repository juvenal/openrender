#!version 1.0.0
#!name "usfroma_probe"
surface
#!parameters:
#!variables:
uniform	string	usarr[3]
varying	float	findex
varying	float	matchFlag
varying	float	temporary_0
varying	float	temporary_1
varying	string	temporary_2
varying	string	temporary_3
#!Init:
	return            
#!Code:
	stoa  usarr 0 "a"
	stoa  usarr 1 "b"
	stoa  usarr 2 "c"
	vufloat  temporary_1 3
	mulff  temporary_0 u temporary_1
	vufloat  temporary_1 3
	mod	("f=ff")  findex temporary_0 temporary_1
	vufloat  matchFlag 0
	usfroma  temporary_2 usarr findex
	vustring  temporary_3 "a"
	seql  temporary_0 temporary_2 temporary_3
	if temporary_0 #!Label6
	vufloat  matchFlag 1
#!Label6:
	else #!Label5
	usfroma  temporary_2 usarr findex
	vustring  temporary_3 "b"
	seql  temporary_1 temporary_2 temporary_3
	if temporary_1 #!Label8
	vufloat  matchFlag 0.5
#!Label8:
	else #!Label7
	vufloat  matchFlag 0
#!Label7:
	endif
#!Label5:
	endif
	vfromf  Ci matchFlag matchFlag matchFlag
	return
