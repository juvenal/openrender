#!version 1.0.0
#!name "spherelight"
light
#!parameters:
uniform	point	from	=	"shader"  [ 0 0 0 ]
uniform	float	radius	=	0
uniform	color	lightcolor	=	1
uniform	float	intensity	=	1
uniform	float	numSamples	=	1
#!variables:
uniform	vector	temporary_0
varying	float	worldRadius
varying	float	i
varying	float	u1
varying	float	u2
varying	float	theta
varying	float	z
varying	float	r
varying	vector	dir
varying	vector	toSample
varying	vector	Psample
varying	float	vis
uniform	float	temporary_1
uniform	vector	temporary_2
varying	float	temporary_3
varying	float	temporary_4
varying	float	temporary_5
varying	float	temporary_6
varying	float	temporary_7
varying	vector	temporary_8
varying	vector	temporary_9
varying	vector	temporary_10
#!Init:
	vfromf  temporary_0 0 0 0
	pfrom  from "shader" temporary_0
	return            
#!Code:
	vfromf  temporary_2 radius 0 0
	vtransform	("v=Sv")  temporary_0 "shader" temporary_2
	length	("f=v")  temporary_1 temporary_0
	vufloat  worldRadius temporary_1
	illuminate from #!Label5
	vufloat  vis 0
	moveff  i vis
	forbegin #!Label6 #!Label7 #!Label8
#!Label6:
	vufloat  temporary_4 numSamples
	flt  temporary_3 i temporary_4
	for temporary_3
	random	("f=")  u1
	random	("f=")  u2
	vufloat  temporary_1 6.2831853080000002
	vufloat  temporary_3 temporary_1
	mulff  theta temporary_3 u1
	vufloat  temporary_3 1
	vufloat  temporary_5 2
	mulff  temporary_4 temporary_5 u2
	subff  z temporary_3 temporary_4
	vufloat  temporary_4 0
	moveff  temporary_6 temporary_3
	mulff  temporary_7 z z
	subff  temporary_5 temporary_6 temporary_7
	max	("f=ff")  temporary_3 temporary_4 temporary_5
	sqrt	("f=f")  r temporary_3
	cos	("f=f")  temporary_4 theta
	mulff  temporary_3 r temporary_4
	sin	("f=f")  temporary_5 theta
	mulff  temporary_4 r temporary_5
	vfromf  dir temporary_3 temporary_4 z
	vuvector  temporary_8 from
	vfromf  temporary_10 worldRadius
	mulvv  temporary_9 temporary_10 dir
	addvv  Psample temporary_8 temporary_9
	subvv  toSample Psample Ps
	visibility	("f=pp")  temporary_4 Ps Psample
	dot  temporary_5 toSample toSample
	divff  temporary_3 temporary_4 temporary_5
	addff  vis vis temporary_3
#!Label7:
	vufloat  temporary_3 1
	addff  i i temporary_3
#!Label8:
	forend
	vufloat  temporary_3 numSamples
	divff  vis vis temporary_3
	vufloat  temporary_4 intensity
	mulff  temporary_3 vis temporary_4
	vfromf  temporary_8 temporary_3
	vuvector  temporary_9 lightcolor
	mulvv  Cl temporary_8 temporary_9
#!Label5:
	endilluminate
	return
