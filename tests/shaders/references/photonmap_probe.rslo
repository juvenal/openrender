#!version 1.0.0
#!name "photonmap_probe"
surface
#!parameters:
#!variables:
uniform	string	missing
varying	vector	c2
varying	vector	c3
varying	float	sameResult
uniform	vector	temporary_0
varying	float	temporary_1
#!Init:
	return            
#!Code:
	movess  missing "017_photonmap_probe_does_not_exist.pm"
	vfromf  temporary_0 0.1 0.2 0.3
	vuvector  c2 temporary_0
	photonmap	("c=Sp")  c2 missing P
	vfromf  temporary_0 0.4 0.5 0.6
	vuvector  c3 temporary_0
	photonmap	("c=Spn")  c3 missing P N
	vufloat  sameResult 0
	veql  temporary_1 c2 c3
	if temporary_1 #!Label3
	vufloat  sameResult 1
#!Label3:
	endif
	vufloat  temporary_1 0.5
	vfromf  Ci sameResult sameResult temporary_1
	return
