#!version 2.0.0
#!name "char_occlusion_probe"
surface
#!parameters:
uniform	string	envmap	=	""
uniform	string	filename	=	""
uniform	float	pointbased	=	0
uniform	float	maxsolidangle	=	0.05
uniform	float	samples	=	16
#!variables:
varying	vector	Nf
varying	float	occ
varying	vector	temporary_0
varying	float	temporary_1
uniform	vector	temporary_2
#!Init:
	return            
#!Code:
	normalize	("v=v")  temporary_0 N
	faceforward	("v=vv")  Nf temporary_0 I
	vufloat  temporary_1 samples
	occlusion	("f=pnfSssfsssf")  occ P Nf temporary_1 "environmentmap" envmap "pointbased" pointbased "filename" filename "maxsolidangle" maxsolidangle 0
	vfromf  Ci occ occ occ
	vfromf  temporary_2 1
	vuvector  Oi temporary_2
	return
