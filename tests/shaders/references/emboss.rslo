#!version 1.0.0
#!name "emboss"
displacement
#!parameters:
uniform	string	texturename	=	""
uniform	string	dispspace	=	"shader"
uniform	float	Km	=	1
uniform	float	truedisp	=	1
uniform	float	sstart	=	0
uniform	float	sscale	=	1
uniform	float	tstart	=	0
uniform	float	tscale	=	1
uniform	float	blur	=	0
#!variables:
varying	float	temporary_0
uniform	float	temporary_1
varying	float	ss
varying	float	tt
varying	float	amp
varying	float	temporary_2
varying	float	temporary_3
varying	vector	temporary_4
varying	float	temporary_5
varying	float	spacescale
varying	vector	Ndisp
varying	vector	temporary_6
varying	vector	temporary_7
varying	vector	temporary_8
varying	vector	temporary_9
varying	float	temporary_10
#!Init:
	return            
#!Code:
	sneql  temporary_1 texturename ""
	vufloat  temporary_0 temporary_1
	if temporary_0 #!Label3
	vufloat  temporary_3 sstart
	subff  temporary_2 s temporary_3
	vufloat  temporary_3 sscale
	divff  ss temporary_2 temporary_3
	vufloat  temporary_3 tstart
	subff  temporary_2 t temporary_3
	vufloat  temporary_3 tscale
	divff  tt temporary_2 temporary_3
	texture	("f=SFffSf")  amp texturename 0 ss tt "blur" blur
	normalize	("v=v")  temporary_4 N
	vufloat  temporary_5 Km
	mulff  temporary_3 temporary_5 amp
	negf  temporary_2 temporary_3
	vufloat  temporary_3 truedisp
	vtransform	("v=Sv")  temporary_6 dispspace temporary_4
	length	("f=v")  spacescale temporary_6
	divff  temporary_5 temporary_2 spacescale
	vfromf  temporary_6 temporary_5
	mulvv  Ndisp temporary_4 temporary_6
	vfromf  temporary_7 temporary_3
	mulvv  temporary_6 temporary_7 Ndisp
	addvv  P P temporary_6
	vufloat  temporary_10 1
	subff  temporary_5 temporary_10 temporary_3
	vfromf  temporary_9 temporary_5
	mulvv  temporary_8 temporary_9 Ndisp
	addvv  temporary_7 P temporary_8
	calculatenormal	("p=p")  temporary_6 temporary_7
	normalize	("v=v")  N temporary_6
#!Label3:
	endif
	return
