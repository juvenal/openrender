#!version 1.0.0
#!name "arealight"
light
#!parameters:
uniform	float	intensity	=	1
uniform	color	lightcolor	=	1
#!variables:
uniform	float	temporary_0
varying	vector	temporary_1
varying	vector	temporary_2
uniform	vector	temporary_3
uniform	vector	temporary_4
varying	vector	temporary_5
varying	float	temporary_6
varying	vector	temporary_7
#!Init:
	return            
#!Code:
	normalize	("v=v")  N N
	vufloat  temporary_0 1.570796327
	illuminate P N temporary_0 #!Label2
	vfromf  temporary_4 intensity
	mulvv  temporary_3 temporary_4 lightcolor
	vuvector  temporary_2 temporary_3
	normalize	("v=v")  temporary_7 L
	dot  temporary_6 N temporary_7
	vfromf  temporary_5 temporary_6
	mulvv  temporary_1 temporary_2 temporary_5
	dot  temporary_6 L L
	vfromf  temporary_2 temporary_6
	divvv  Cl temporary_1 temporary_2
#!Label2:
	endilluminate
	return
