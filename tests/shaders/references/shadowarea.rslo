#!version 2.0.0
#!name "shadowarea"
light
#!parameters:
uniform	float	intensity	=	1
uniform	color	lightcolor	=	1
#!variables:
uniform	float	temporary_0
varying	vector	temporary_1
varying	vector	temporary_2
varying	vector	temporary_3
varying	float	temporary_4
varying	float	temporary_5
varying	float	temporary_6
varying	vector	temporary_7
#!Init:
	return            
#!Code:
	normalize	("v=v")  N N
	vufloat  temporary_0 1.570796327
	illuminate P N temporary_0 #!Label2
	visibility	("f=pp")  temporary_5 Ps P 0
	vufloat  temporary_6 intensity
	mulff  temporary_4 temporary_5 temporary_6
	vfromf  temporary_3 temporary_4
	vuvector  temporary_7 lightcolor
	mulvv  temporary_2 temporary_3 temporary_7
	normalize	("v=v")  temporary_7 L
	dot  temporary_4 N temporary_7
	vfromf  temporary_3 temporary_4
	mulvv  temporary_1 temporary_2 temporary_3
	dot  temporary_4 L L
	vfromf  temporary_2 temporary_4
	divvv  Cl temporary_1 temporary_2
#!Label2:
	endilluminate
	return
