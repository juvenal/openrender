#!version 1.0.0
#!name "comp_probe"
surface
#!parameters:
#!variables:
varying	vector	v_1
varying	float	ix
varying	float	vComp
varying	matrix	m
varying	float	row
varying	float	col
varying	float	mComp
varying	float	temporary_0
varying	float	temporary_1
varying	float	temporary_2
varying	float	temporary_3
varying	float	temporary_4
uniform	matrix	temporary_5
#!Init:
	return            
#!Code:
	vufloat  temporary_1 0
	comp	("f=cf")  temporary_0 P temporary_1
	vufloat  temporary_3 1
	comp	("f=cf")  temporary_2 P temporary_3
	vufloat  temporary_3 2
	mulff  temporary_1 temporary_2 temporary_3
	moveff  temporary_4 temporary_3
	comp	("f=cf")  temporary_3 P temporary_4
	vufloat  temporary_4 3
	mulff  temporary_2 temporary_3 temporary_4
	vfromf  v_1 temporary_0 temporary_1 temporary_2
	vufloat  temporary_4 0
	comp	("f=cf")  temporary_3 P temporary_4
	vufloat  temporary_4 10
	mulff  temporary_2 temporary_3 temporary_4
	vufloat  temporary_3 100
	addff  temporary_1 temporary_2 temporary_3
	floor	("f=f")  temporary_0 temporary_1
	vufloat  temporary_1 3
	mod	("f=ff")  ix temporary_0 temporary_1
	comp	("f=cf")  vComp v_1 ix
	mfromf  temporary_5 1
	vumatrix  m temporary_5
	vufloat  temporary_4 1
	comp	("f=cf")  temporary_3 P temporary_4
	vufloat  temporary_4 10
	mulff  temporary_2 temporary_3 temporary_4
	vufloat  temporary_3 100
	addff  temporary_1 temporary_2 temporary_3
	floor	("f=f")  temporary_0 temporary_1
	vufloat  temporary_1 4
	mod	("f=ff")  row temporary_0 temporary_1
	vufloat  temporary_4 2
	comp	("f=cf")  temporary_3 P temporary_4
	vufloat  temporary_4 10
	mulff  temporary_2 temporary_3 temporary_4
	vufloat  temporary_3 100
	addff  temporary_1 temporary_2 temporary_3
	floor	("f=f")  temporary_0 temporary_1
	vufloat  temporary_1 4
	mod	("f=ff")  col temporary_0 temporary_1
	comp	("f=mff")  mComp m row col
	subff  temporary_0 vComp mComp
	vfromf  Ci vComp mComp temporary_0
	return
