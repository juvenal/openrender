#!version 2.0.0
#!name "volume_transmission_probe"
surface
#!parameters:
uniform	float	dz	=	3
#!variables:
varying	vector	q
varying	vector	temporary_0
uniform	vector	temporary_1
#!Init:
	return            
#!Code:
	vfromf  temporary_1 0 0 dz
	vuvector  temporary_0 temporary_1
	addvv  q P temporary_0
	transmission	("c=pp")  Ci P q 0
	vfromf  temporary_1 1
	vuvector  Oi temporary_1
	return
