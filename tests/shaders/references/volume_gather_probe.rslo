#!version 2.0.0
#!name "volume_gather_probe"
surface
#!parameters:
uniform	float	tiltx	=	0.5
#!variables:
varying	vector	In
varying	vector	Nt
varying	vector	R
varying	vector	c
varying	vector	tot
uniform	vector	temporary_0
uniform	float	temporary_1
uniform	float	temporary_2
uniform	float	temporary_3
uniform	float	temporary_4
varying	string	temporary_5
varying	float	temporary_6
varying	float	temporary_7
varying	vector	temporary_8
#!Init:
	return            
#!Code:
	normalize	("v=v")  In I
	mulff  temporary_4 tiltx tiltx
	subff  temporary_3 1 temporary_4
	sqrt	("f=f")  temporary_2 temporary_3
	negf  temporary_1 temporary_2
	vfromf  temporary_0 tiltx 0 temporary_1
	vuvector  Nt temporary_0
	reflect	("v=vv")  R In Nt
	vfromf  temporary_0 0
	vuvector  c temporary_0
	vfromf  temporary_0 0
	vuvector  tot temporary_0
	vustring  temporary_5 "illuminance"
	vufloat  temporary_6 0
	vufloat  temporary_7 1
	gatherHeader	("o=spnffsfsfsc") temporary_5 P R temporary_6 temporary_7 "bias" 0.02 "maxdist" 100 "surface:Ci" c 0
#!Label4:
	gather #!Label6
	addvv  tot tot c
#!Label6:
	gatherElse #!Label5
	vfromf  temporary_0 0
	vuvector  temporary_8 temporary_0
	addvv  tot tot temporary_8
#!Label5:
	gatherEnd #!Label4
	movevv  Ci tot
	vfromf  temporary_0 1
	vuvector  Oi temporary_0
	return
