#!version 1.0.0
#!name "round"
displacement
#!parameters:
uniform	float	radius	=	0.10
#!variables:
varying	float	uu
varying	float	vv
varying	float	lu
varying	float	lv
varying	vector	center
varying	vector	dpdu
varying	vector	dpdv
