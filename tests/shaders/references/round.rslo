varying	float	temporary_4
varying	float	temporary_5
uniform	vector	temporary_6
varying	vector	temporary_7
varying	vector	temporary_8
#!Init:
	return            
#!Code:
	vufloat  temporary_1 .5
	flt  temporary_0 u temporary_1
	if temporary_0 #!Label12
	moveff  uu u
	movevv  dpdu dPdu
#!Label12:
	else #!Label11
	vufloat  temporary_1 1
	subff  uu temporary_1 u
	negv  dpdu dPdu
#!Label11:
	endif
	vufloat  temporary_1 .5
	flt  temporary_0 v temporary_1
	if temporary_0 #!Label14
	moveff  vv v
	movevv  dpdv dPdv
#!Label14:
	else #!Label13
	vufloat  temporary_1 1
	subff  vv temporary_1 v
	negv  dpdv dPdv
#!Label13:
	endif
	vfromf  temporary_3 uu
	mulvv  temporary_2 dPdu temporary_3
	length	("f=v")  lu temporary_2
	vfromf  temporary_3 vv
	mulvv  temporary_2 dPdv temporary_3
	length	("f=v")  lv temporary_2
	vufloat  temporary_4 radius
	flt  temporary_1 lu temporary_4
	moveff  temporary_5 temporary_4
	flt  temporary_4 lv temporary_5
	or  temporary_0 temporary_1 temporary_4
	if temporary_0 #!Label15
	vfromf  temporary_6 0 0 0
	vuvector  center temporary_6
	vufloat  temporary_4 radius
	flt  temporary_1 lu temporary_4
	if temporary_1 #!Label17
	moveff  temporary_5 temporary_4
	subff  temporary_4 temporary_5 lu
	vfromf  temporary_2 temporary_4
	normalize	("v=v")  temporary_3 dpdu
	mulvv  center temporary_2 temporary_3
#!Label17:
	endif
	vufloat  temporary_4 radius
	flt  temporary_1 lv temporary_4
	if temporary_1 #!Label19
	moveff  temporary_5 temporary_4
	subff  temporary_4 temporary_5 lv
	vfromf  temporary_3 temporary_4
	normalize	("v=v")  temporary_7 dpdv
	mulvv  temporary_2 temporary_3 temporary_7
	addvv  center center temporary_2
#!Label19:
	endif
	vfromf  temporary_6 radius
	vuvector  temporary_7 temporary_6
	normalize	("v=v")  temporary_8 N
	mulvv  temporary_3 temporary_7 temporary_8
	subvv  temporary_2 P temporary_3
	addvv  center center temporary_2
	vfromf  temporary_6 radius
	vuvector  temporary_3 temporary_6
	subvv  temporary_8 P center
	normalize	("v=v")  temporary_7 temporary_8
	mulvv  temporary_2 temporary_3 temporary_7
	addvv  P center temporary_2
#!Label15:
	endif
	calculatenormal	("p=p")  N P
	return
