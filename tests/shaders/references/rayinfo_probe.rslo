#!version 1.0.0
#!name "rayinfo_probe"
surface
#!parameters:
#!variables:
uniform	string	labelOut
uniform	float	labelFound
varying	float	labelOk
uniform	float	depthOut
uniform	float	depthFound
varying	float	depthOk
uniform	vector	originOut
uniform	float	originFound
uniform	vector	directionOut
uniform	float	directionFound
uniform	float	directionLen
varying	float	directionOk
uniform	float	lengthOut
uniform	float	lengthFound
varying	float	lengthOk
uniform	float	allFound
varying	float	allFoundOk
varying	float	allOk
varying	float	temporary_0
uniform	float	temporary_1
uniform	float	temporary_2
uniform	float	temporary_3
varying	float	temporary_4
varying	float	temporary_5
#!Init:
	return            
#!Code:
	movess  labelOut ""
	rayinfo	("f=ss")  labelFound "label" labelOut
	vufloat  labelOk 0
	seql  temporary_1 labelOut "camera"
	vufloat  temporary_0 temporary_1
	if temporary_0 #!Label11
	vufloat  labelOk 1
#!Label11:
	endif
	vufloat  depthOut -1
	rayinfo	("f=sf")  depthFound "depth" depthOut
	vufloat  depthOk 0
	feql  temporary_1 depthOut 0
	vufloat  temporary_0 temporary_1
	if temporary_0 #!Label13
	vufloat  depthOk 1
#!Label13:
	endif
	vfromf  originOut 0 0 0
	rayinfo	("f=sv")  originFound "origin" originOut
	movevv  directionOut originOut
	rayinfo	("f=sv")  directionFound "direction" directionOut
	length	("f=v")  directionLen directionOut
	vufloat  directionOk 0
	fgt  temporary_2 directionLen 0.99
	flt  temporary_3 directionLen 1.01
	and  temporary_1 temporary_2 temporary_3
	vufloat  temporary_0 temporary_1
	if temporary_0 #!Label15
	vufloat  directionOk 1
#!Label15:
	endif
	moveff  lengthOut 0
	rayinfo	("f=sf")  lengthFound "length" lengthOut
	vufloat  lengthOk 0
	fgt  temporary_1 lengthOut 0
	vufloat  temporary_0 temporary_1
	if temporary_0 #!Label17
	vufloat  lengthOk 1
#!Label17:
	endif
	addff  temporary_3 labelFound depthFound
	addff  temporary_2 temporary_3 originFound
	addff  temporary_1 temporary_2 directionFound
	addff  allFound temporary_1 lengthFound
	vufloat  allFoundOk 0
	feql  temporary_1 allFound 5
	vufloat  temporary_0 temporary_1
	if temporary_0 #!Label19
	vufloat  allFoundOk 1
#!Label19:
	endif
	addff  temporary_5 labelOk depthOk
	addff  temporary_4 temporary_5 directionOk
	addff  temporary_0 temporary_4 lengthOk
	addff  allOk temporary_0 allFoundOk
	vufloat  temporary_4 5
	divff  temporary_0 allOk temporary_4
	vufloat  temporary_4 originFound
	vufloat  temporary_5 0.5
	vfromf  Ci temporary_0 temporary_4 temporary_5
	return
