#!version 1.0.0
#!name "indirectdiffuse_probe"
surface
#!parameters:
#!variables:
varying	vector	Nf
varying	vector	temporary_0
varying	float	temporary_1
#!Init:
	return            
#!Code:
	normalize	("v=v")  temporary_0 N
	faceforward	("v=vv")  Nf temporary_0 I
	vufloat  temporary_1 12
	indirectdiffuse	("c=pnf")  Ci P Nf temporary_1
