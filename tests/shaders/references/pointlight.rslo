#!version 2.0.0
#!name "pointlight"
light
#!parameters:
uniform	float	intensity	=	1
uniform	color	lightcolor	=	1
uniform	point	from	=	"shader"  [ 0 0 0 ]
#!variables:
uniform	vector	temporary_0
varying	vector	temporary_1
uniform	vector	temporary_2
varying	vector	temporary_3
varying	float	temporary_4
#!Init:
	vfromf  temporary_0 0 0 0
	pfrom  from "shader" temporary_0
	return            
#!Code:
	illuminate from #!Label2
	vfromf  temporary_2 intensity
	mulvv  temporary_0 temporary_2 lightcolor
	vuvector  temporary_1 temporary_0
	dot  temporary_4 L L
	vfromf  temporary_3 temporary_4
	divvv  Cl temporary_1 temporary_3
#!Label2:
	endilluminate
	return
