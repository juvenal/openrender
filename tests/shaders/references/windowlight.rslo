#!version 2.0.0
#!name "windowlight"
light
#!parameters:
uniform	point	from
uniform	point	to	=	"world"  [ 0 0 0 ]
uniform	point	center
uniform	point	in	=	"world"  [ 0 0 1 ]
uniform	point	up	=	"world"  [ 0 1 0 ]
uniform	color	lightcolor	=	 [ 1 0.9 0.6 ]
uniform	color	darkcolor	=	 [ 0.05 0.2 0.1 ]
uniform	float	intensity	=	1
uniform	float	xorder	=	2
uniform	float	yorder	=	3
uniform	float	panewidth	=	6
uniform	float	paneheight	=	6
uniform	float	framewidth	=	1
uniform	float	fuzz	=	0.1
#!variables:
uniform	vector	temporary_0
uniform	float	temporary_1
uniform	vector	in2
uniform	vector	right
uniform	vector	up2
uniform	vector	corner
uniform	vector	path
varying	vector	PtoC
varying	vector	PtoF
varying	float	offset
varying	float	modulus
varying	float	yfract
varying	float	xfract
varying	vector	Nf
uniform	vector	temporary_2
uniform	vector	temporary_3
uniform	vector	temporary_4
uniform	vector	temporary_5
varying	vector	temporary_6
varying	float	temporary_7
varying	float	temporary_8
varying	float	temporary_9
varying	vector	temporary_10
varying	vector	temporary_11
varying	vector	temporary_12
varying	float	temporary_13
varying	float	temporary_14
varying	float	temporary_15
uniform	float	temporary_16
uniform	float	temporary_17
#!Init:
	vufloat  temporary_1 -20
	vfromf  temporary_0 0 0 temporary_1
	pfrom  from "world" temporary_0
	vfromf  temporary_0 0 0 0
	pfrom  to "world" temporary_0
	vufloat  temporary_1 -4
	vfromf  temporary_0 0 0 temporary_1
	pfrom  center "world" temporary_0
	vfromf  temporary_0 0 0 1
	pfrom  in "world" temporary_0
	vfromf  temporary_0 0 1 0
	pfrom  up "world" temporary_0
	return            
#!Code:
	faceforward	("v=vv")  Nf N I
	subvv  path from to
	normalize	("v=v")  temporary_0 in
	faceforward	("v=vv")  in2 temporary_0 path
	cross  right up in2
	cross  temporary_0 in2 right
	normalize	("v=v")  up2 temporary_0
	cross  right up2 in2
	vfromf  temporary_5 xorder
	mulvv  temporary_4 right temporary_5
	vfromf  temporary_5 panewidth
	mulvv  temporary_3 temporary_4 temporary_5
	vfromf  temporary_4 2
	divvv  temporary_2 temporary_3 temporary_4
	subvv  temporary_0 center temporary_2
	vfromf  temporary_5 yorder
	mulvv  temporary_4 up2 temporary_5
	vfromf  temporary_5 paneheight
	mulvv  temporary_3 temporary_4 temporary_5
	vfromf  temporary_4 2
	divvv  temporary_2 temporary_3 temporary_4
	subvv  corner temporary_0 temporary_2
	negv  temporary_0 path
	vfromf  temporary_2 0.0
	solar temporary_0 temporary_2 #!Label12
	vuvector  temporary_6 corner
	subvv  PtoC temporary_6 Ps
	vuvector  temporary_6 path
	dot  temporary_8 temporary_6 PtoC
	vufloat  temporary_9 0
	felt  temporary_7 temporary_8 temporary_9
	if temporary_7 #!Label14
	vufloat  yfract 1
	moveff  xfract yfract
#!Label14:
	else #!Label13
	vuvector  temporary_10 path
	vuvector  temporary_12 in2
	dot  temporary_8 PtoC temporary_12
	vfromf  temporary_11 temporary_8
	mulvv  temporary_6 temporary_10 temporary_11
	dot  temporary_1 path in2
	vfromf  temporary_3 temporary_1
	vuvector  temporary_10 temporary_3
	divvv  PtoF temporary_6 temporary_10
	subvv  temporary_6 PtoF PtoC
	vuvector  temporary_10 up2
	dot  offset temporary_6 temporary_10
	vufloat  temporary_8 paneheight
	mod	("f=ff")  modulus offset temporary_8
	vufloat  temporary_13 0
	fgt  temporary_9 offset temporary_13
	moveff  temporary_15 temporary_8
	divff  temporary_14 offset temporary_15
	vufloat  temporary_15 yorder
	flt  temporary_13 temporary_14 temporary_15
	and  temporary_8 temporary_9 temporary_13
	if temporary_8 #!Label16
	divff  temporary_1 paneheight 2
	vufloat  temporary_13 temporary_1
	fgt  temporary_9 modulus temporary_13
	if temporary_9 #!Label17
	vufloat  temporary_13 paneheight
	subff  modulus temporary_13 modulus
#!Label17:
	endif
	divff  temporary_16 framewidth 2
	divff  temporary_17 fuzz 2
	subff  temporary_1 temporary_16 temporary_17
	vufloat  temporary_9 temporary_1
	divff  temporary_16 framewidth 2
	divff  temporary_17 fuzz 2
	addff  temporary_1 temporary_16 temporary_17
	vufloat  temporary_13 temporary_1
	smoothstep	("f=fff")  yfract temporary_9 temporary_13 modulus
#!Label16:
	else #!Label15
	vufloat  yfract 0
#!Label15:
	endif
	subvv  temporary_6 PtoF PtoC
	vuvector  temporary_10 right
	dot  offset temporary_6 temporary_10
	vufloat  temporary_8 panewidth
	mod	("f=ff")  modulus offset temporary_8
	vufloat  temporary_13 0
	fgt  temporary_9 offset temporary_13
	moveff  temporary_15 temporary_8
	divff  temporary_14 offset temporary_15
	vufloat  temporary_15 xorder
	flt  temporary_13 temporary_14 temporary_15
	and  temporary_8 temporary_9 temporary_13
	if temporary_8 #!Label20
	divff  temporary_1 panewidth 2
	vufloat  temporary_13 temporary_1
	fgt  temporary_9 modulus temporary_13
	if temporary_9 #!Label21
	vufloat  temporary_13 panewidth
	subff  modulus temporary_13 modulus
#!Label21:
	endif
	divff  temporary_16 framewidth 2
	divff  temporary_17 fuzz 2
	subff  temporary_1 temporary_16 temporary_17
	vufloat  temporary_9 temporary_1
	divff  temporary_16 framewidth 2
	divff  temporary_17 fuzz 2
	addff  temporary_1 temporary_16 temporary_17
	vufloat  temporary_13 temporary_1
	smoothstep	("f=fff")  xfract temporary_9 temporary_13 modulus
#!Label20:
	else #!Label19
	vufloat  xfract 0
#!Label19:
	endif
#!Label13:
	endif
	vfromf  temporary_3 intensity
	vuvector  temporary_6 temporary_3
	vuvector  temporary_11 darkcolor
	vuvector  temporary_12 lightcolor
	mulff  temporary_7 yfract xfract
	mix	("v=vvf")  temporary_10 temporary_11 temporary_12 temporary_7
	mulvv  Cl temporary_6 temporary_10
#!Label12:
	endsolar
	return
