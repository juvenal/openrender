#!version 2.0.0
#!name "volume_reflect_probe"
surface
#!parameters:
uniform	float	tiltx	=	0.5
uniform	string	via	=	"trace"
#!variables:
varying	vector	In
varying	vector	Nt
varying	vector	R
uniform	vector	temporary_0
uniform	float	temporary_1
uniform	float	temporary_2
uniform	float	temporary_3
uniform	float	temporary_4
varying	float	temporary_5
#!Init:
	return            
#!Code:
	normalize	("v=v")  In I
	mulff  temporary_4 tiltx tiltx
	subff  temporary_3 1 temporary_4
	sqrt	("f=f")  temporary_2 temporary_3
	negf  temporary_1 temporary_2
	vfromf  temporary_0 tiltx 0 temporary_1
	vuvector  Nt temporary_0
	reflect	("v=vv")  R In Nt
	seql  temporary_1 via "environment"
	vufloat  temporary_5 temporary_1
	if temporary_5 #!Label4
	environment	("c=SFv")  Ci "raytrace" 0 R 0
#!Label4:
	else #!Label3
	trace	("c=pv")  Ci P R 1
#!Label3:
	endif
	vfromf  temporary_0 1
	vuvector  Oi temporary_0
	return
