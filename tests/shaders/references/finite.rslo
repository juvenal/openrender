#!version 1.0.0
light
#!parameters:
uniform	float	intensity	=	1
uniform	color	lightcolor	=	1
uniform	point	location	=	"shader"  [ 0 0 0 ]
#!variables:
uniform	vector	temporary_0
varying	vector	temporary_1
uniform	vector	temporary_2
#!Init:
	vfromf  temporary_0 0 0 0
	pfrom  location "shader" temporary_0
	return            
#!Code:
	vuvector  temporary_1 location
	illuminate temporary_1 #!Label2
	vfromf  temporary_2 intensity
	mulvv  temporary_0 temporary_2 lightcolor
	vuvector  Cl temporary_0
#!Label2:
	endilluminate
	return
