#!version 2.0.0
#!name "finite"
light
#!parameters:
uniform	float	intensity	=	1
uniform	color	lightcolor	=	1
uniform	point	location	=	"shader"  [ 0 0 0 ]
#!variables:
uniform	vector	temporary_0
uniform	vector	temporary_1
#!Init:
	vfromf  temporary_0 0 0 0
	pfrom  location "shader" temporary_0
	return            
#!Code:
	illuminate location #!Label2
	vfromf  temporary_1 intensity
	mulvv  temporary_0 temporary_1 lightcolor
	vuvector  Cl temporary_0
#!Label2:
	endilluminate
	return
