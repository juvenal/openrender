#!version 2.0.0
#!name "sampling_instance_light"
light
#!parameters:
uniform	float	id	=	1
#!variables:
uniform	vector	temporary_0
uniform	float	temporary_1
varying	float	temporary_2
varying	float	temporary_3
varying	float	temporary_4
#!Init:
	return            
#!Code:
	vufloat  temporary_1 -4
	vfromf  temporary_0 0 0 temporary_1
	illuminate temporary_0 #!Label2
	random	("f=")  temporary_2 0
	vufloat  temporary_3 id
	vufloat  temporary_4 0
	vfromf  Cl temporary_2 temporary_3 temporary_4
#!Label2:
	endilluminate
	return
