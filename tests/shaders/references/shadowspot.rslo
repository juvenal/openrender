#!version 2.0.0
#!name "shadowspot"
light
#!parameters:
uniform	float	intensity	=	1
uniform	color	lightcolor	=	1
uniform	point	to	=	"shader"  [ 0 0 1 ]
uniform	point	from	=	"shader"  [ 0 0 0 ]
uniform	string	shadowname	=	""
uniform	float	coneangle
uniform	float	conedeltaangle
uniform	float	beamdistribution	=	2
#!variables:
uniform	vector	temporary_0
uniform	vector	axis
uniform	float	cosoutside
uniform	float	cosinside
uniform	float	temporary_1
varying	float	cosangle
varying	float	atten
varying	float	temporary_2
varying	vector	temporary_3
varying	float	temporary_4
varying	float	temporary_5
varying	float	temporary_6
varying	vector	temporary_7
#!Init:
	vfromf  temporary_0 0 0 1
	pfrom  to "shader" temporary_0
	vfromf  temporary_0 0 0 0
	pfrom  from "shader" temporary_0
	radians	("f=f")  coneangle 30
	radians	("f=f")  conedeltaangle 5
	return            
#!Code:
	subvv  temporary_0 to from
	normalize	("v=v")  axis temporary_0
	cos	("f=f")  cosoutside coneangle
	subff  temporary_1 coneangle conedeltaangle
	cos	("f=f")  cosinside temporary_1
	illuminate from axis coneangle #!Label4
	vuvector  temporary_3 axis
	dot  temporary_2 L temporary_3
	length	("f=v")  temporary_4 L
	divff  cosangle temporary_2 temporary_4
	vufloat  temporary_4 beamdistribution
	pow	("f=ff")  temporary_2 cosangle temporary_4
	dot  temporary_4 L L
	divff  atten temporary_2 temporary_4
	vufloat  temporary_4 cosoutside
	vufloat  temporary_5 cosinside
	smoothstep	("f=fff")  temporary_2 temporary_4 temporary_5 cosangle
	mulff  atten atten temporary_2
	sneql  temporary_1 shadowname ""
	vufloat  temporary_2 temporary_1
	if temporary_2 #!Label5
	vufloat  temporary_5 1
	shadow	("f=SFp")  temporary_6 shadowname 0 Ps 0
	subff  temporary_4 temporary_5 temporary_6
	mulff  atten atten temporary_4
#!Label5:
	endif
	vufloat  temporary_4 intensity
	mulff  temporary_2 atten temporary_4
	vfromf  temporary_3 temporary_2
	vuvector  temporary_7 lightcolor
	mulvv  Cl temporary_3 temporary_7
#!Label4:
	endilluminate
	return
