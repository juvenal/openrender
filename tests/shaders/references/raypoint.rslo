#!version 2.0.0
#!name "raypoint"
light
#!parameters:
uniform	float	intensity	=	1
uniform	color	lightcolor	=	1
uniform	float	blur	=	0
uniform	float	numSamples	=	1
uniform	point	from	=	"shader"  [ 0 0 0 ]
#!variables:
uniform	vector	temporary_0
varying	vector	temporary_1
varying	vector	temporary_2
varying	float	temporary_3
varying	float	temporary_4
varying	vector	temporary_5
varying	float	temporary_6
#!Init:
	vfromf  temporary_0 0 0 0
	pfrom  from "shader" temporary_0
	return            
#!Code:
	illuminate from #!Label2
	vuvector  temporary_5 from
	visibility	("f=pp")  temporary_4 Ps temporary_5 0
	vufloat  temporary_6 intensity
	mulff  temporary_3 temporary_4 temporary_6
	vfromf  temporary_2 temporary_3
	vuvector  temporary_5 lightcolor
	mulvv  temporary_1 temporary_2 temporary_5
	dot  temporary_3 L L
	vfromf  temporary_2 temporary_3
	divvv  Cl temporary_1 temporary_2
#!Label2:
	endilluminate
	return
