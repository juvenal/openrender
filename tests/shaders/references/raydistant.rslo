#!version 2.0.0
#!name "raydistant"
light
#!parameters:
uniform	float	intensity	=	1
uniform	color	lightcolor	=	1
uniform	point	from	=	"shader"  [ 0 0 0 ]
uniform	point	to	=	"shader"  [ 0 0 1 ]
#!variables:
uniform	vector	temporary_0
varying	vector	dir
varying	vector	temporary_1
varying	vector	temporary_2
varying	vector	temporary_3
uniform	vector	temporary_4
#!Init:
	vfromf  temporary_0 0 0 0
	pfrom  from "shader" temporary_0
	vfromf  temporary_0 0 0 1
	pfrom  to "shader" temporary_0
	return            
#!Code:
	subvv  temporary_0 to from
	vuvector  dir temporary_0
	vfromf  temporary_0 0
	solar dir temporary_0 #!Label2
	subvv  temporary_3 Ps dir
	transmission	("c=pp")  temporary_2 Ps temporary_3 0
	vfromf  temporary_4 intensity
	vuvector  temporary_3 temporary_4
	mulvv  temporary_1 temporary_2 temporary_3
	vuvector  temporary_2 lightcolor
	mulvv  Cl temporary_1 temporary_2
#!Label2:
	endsolar
	return
