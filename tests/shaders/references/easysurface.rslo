#!version 1.0.0
#!name "easysurface"
surface
#!parameters:
uniform	float	Kd	=	0.8
uniform	float	Ka	=	0.2
uniform	float	falloff	=	2.0
#!variables:
varying	float	diffuse
varying	float	temporary_0
varying	float	temporary_1
varying	float	temporary_2
varying	float	temporary_3
varying	vector	temporary_4
#!Init:
	return            
#!Code:
	dot  temporary_0 I N
	dot  temporary_2 I I
	dot  temporary_3 N N
	mulff  temporary_1 temporary_2 temporary_3
	divff  diffuse temporary_0 temporary_1
	vufloat  temporary_0 falloff
	pow	("f=ff")  diffuse diffuse temporary_0
	vufloat  temporary_1 Ka
	vufloat  temporary_3 Kd
	mulff  temporary_2 temporary_3 diffuse
	addff  temporary_0 temporary_1 temporary_2
	vfromf  temporary_4 temporary_0
	mulvv  Ci Cs temporary_4
	return
