#!version 1.0.0
light
#!parameters:
uniform	float	intensity	=	1
uniform	color	lightcolor	=	1
uniform	point	from	=	"shader"  [ 0 0 0 ]
uniform	point	to	=	"shader"  [ 0 0 1 ]
uniform	float	coneangle
uniform	float	conedeltaangle
uniform	float	beamdistribution	=	2
#!variables:
uniform	vector	temporary_0
uniform	vector	axis
uniform	float	cosoutside
uniform	float	cosinside
uniform	float	temporary_1
varying	vector	temporary_2
varying	vector	temporary_3
varying	float	temporary_4
varying	float	cosangle
varying	float	atten
varying	float	temporary_5
varying	vector	temporary_6
varying	float	temporary_7
varying	float	temporary_8
varying	vector	temporary_9
#!Init:
	vfromf  temporary_0 0 0 0
	pfrom  from "shader" temporary_0
	vfromf  temporary_0 0 0 1
	pfrom  to "shader" temporary_0
	radians	("f=f")  coneangle 30
	radians	("f=f")  conedeltaangle 5
	return            
#!Code:
	subvv  temporary_0 to from
	normalize	("v=v")  axis temporary_0
	cos	("f=f")  cosoutside coneangle
	subff  temporary_1 coneangle conedeltaangle
	cos	("f=f")  cosinside temporary_1
	vuvector  temporary_2 from
	vuvector  temporary_3 axis
	vufloat  temporary_4 coneangle
	illuminate temporary_2 temporary_3 temporary_4 #!Label2
	movevv  temporary_6 temporary_3
	dot  temporary_5 L temporary_6
	length	("f=v")  temporary_7 L
	divff  cosangle temporary_5 temporary_7
	vufloat  temporary_7 beamdistribution
	pow	("f=ff")  temporary_5 cosangle temporary_7
	dot  temporary_7 L L
	divff  atten temporary_5 temporary_7
	vufloat  temporary_7 cosoutside
	vufloat  temporary_8 cosinside
	smoothstep	("f=fff")  temporary_5 temporary_7 temporary_8 cosangle
	mulff  atten atten temporary_5
	vufloat  temporary_7 intensity
	mulff  temporary_5 atten temporary_7
	vfromf  temporary_6 temporary_5
	vuvector  temporary_9 lightcolor
	mulvv  Cl temporary_6 temporary_9
#!Label2:
	endilluminate
	return
