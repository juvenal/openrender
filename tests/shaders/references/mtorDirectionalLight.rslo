#!version 2.0.0
#!name "mtorDirectionalLight"
light
#!parameters:
uniform	float	intensity	=	1
uniform	color	lightcolor	=	 [ 1 1 1 ]
uniform	vector	direction	=	 [ 0 0 1 ]
uniform	string	shadowname	=	""
uniform	color	shadowcolor	=	 [ 0 0 0 ]
uniform	float	decayRate	=	0
#!variables:
varying	float	temporary_0
uniform	float	temporary_1
uniform	vector	temporary_2
uniform	vector	temporary_3
uniform	vector	temporary_4
varying	vector	temporary_5
varying	vector	temporary_6
varying	float	temporary_7
#!Init:
	return            
#!Code:
	seql  temporary_1 shadowname ""
	vufloat  temporary_0 temporary_1
	if temporary_0 #!Label6
	vfromf  temporary_2 0
	solar direction temporary_2 #!Label7
	vfromf  temporary_4 intensity
	mulvv  temporary_3 temporary_4 lightcolor
	vuvector  Cl temporary_3
#!Label7:
	endsolar
#!Label6:
	else #!Label5
	vfromf  temporary_2 0
	solar direction temporary_2 #!Label8
	vuvector  temporary_5 shadowcolor
	vfromf  temporary_4 intensity
	mulvv  temporary_3 temporary_4 lightcolor
	vuvector  temporary_6 temporary_3
	shadow	("f=SFp")  temporary_7 shadowname 0 Ps 0
	mix	("v=vvf")  Cl temporary_5 temporary_6 temporary_7
#!Label8:
	endsolar
#!Label5:
	endif
	return
