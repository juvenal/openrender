#!version 1.0.0
#!name "occlusion_probe"
surface
#!parameters:
#!variables:
varying	vector	Nf
varying	float	occ
varying	vector	temporary_0
varying	float	temporary_1
#!Init:
	return            
#!Code:
	normalize	("v=v")  temporary_0 N
	faceforward	("v=vv")  Nf temporary_0 I
	vufloat  temporary_1 12
	occlusion	("f=pnf")  occ P Nf temporary_1
	vfromf  Ci occ occ occ
	return
