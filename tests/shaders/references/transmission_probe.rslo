#!version 1.0.0
#!name "transmission_probe"
surface
#!parameters:
#!variables:
varying	vector	Psample
varying	vector	temporary_0
uniform	vector	temporary_1
#!Init:
	return            
#!Code:
	vfromf  temporary_1 0.3 0.2 0.1
	vuvector  temporary_0 temporary_1
	addvv  Psample P temporary_0
	transmission	("c=pp")  Ci P Psample
	return
