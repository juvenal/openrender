#!version 2.0.0
#!name "quadlight"
light
#!parameters:
uniform	point	P0
uniform	point	P1
uniform	point	P2
uniform	point	P3	=	"shader"  [ 1 1 0 ]
uniform	vector	direction	=	 [ 0 0 0 ]
uniform	float	useDirection	=	0
uniform	color	lightcolor	=	1
uniform	float	intensity	=	1
uniform	float	numSamples	=	1
uniform	float	reverse	=	0
#!variables:
uniform	vector	temporary_0
uniform	float	temporary_1
uniform	float	temporary_2
varying	vector	center
varying	float	i
varying	float	u_1
varying	float	v_1
varying	float	vis
varying	vector	edge0
varying	vector	edge1
varying	vector	Psample
varying	vector	toSample
uniform	vector	temporary_3
uniform	vector	temporary_4
uniform	vector	temporary_5
varying	float	temporary_6
varying	vector	temporary_7
varying	float	temporary_8
varying	vector	temporary_9
varying	vector	temporary_10
varying	vector	temporary_11
varying	float	temporary_12
#!Init:
	vufloat  temporary_1 -1
	moveff  temporary_2 temporary_1
	vfromf  temporary_0 temporary_1 temporary_2 0
	pfrom  P0 "shader" temporary_0
	vufloat  temporary_1 -1
	vfromf  temporary_0 1 temporary_1 0
	pfrom  P1 "shader" temporary_0
	vufloat  temporary_1 -1
	vfromf  temporary_0 temporary_1 1 0
	pfrom  P2 "shader" temporary_0
	vfromf  temporary_0 1 1 0
	pfrom  P3 "shader" temporary_0
	return            
#!Code:
	addvv  temporary_5 P0 P1
	addvv  temporary_4 temporary_5 P2
	addvv  temporary_3 temporary_4 P3
	vfromf  temporary_4 4
	divvv  temporary_0 temporary_3 temporary_4
	vuvector  center temporary_0
	fneql  temporary_1 useDirection 0
	vufloat  temporary_6 temporary_1
	if temporary_6 #!Label10
	normalize	("v=v")  temporary_0 direction
	vuvector  N temporary_0
#!Label10:
	else #!Label9
	subvv  temporary_4 P1 P0
	subvv  temporary_5 P2 P0
	cross  temporary_3 temporary_4 temporary_5
	normalize	("v=v")  temporary_0 temporary_3
	vuvector  N temporary_0
#!Label9:
	endif
	fneql  temporary_1 reverse 0
	vufloat  temporary_6 temporary_1
	if temporary_6 #!Label11
	vufloat  temporary_1 -1
	vfromf  temporary_0 temporary_1
	vuvector  temporary_7 temporary_0
	mulvv  N N temporary_7
#!Label11:
	endif
	vufloat  temporary_1 1.570796327
	illuminate center N temporary_1 #!Label13
	vufloat  vis 0
	moveff  i vis
	forbegin #!Label14 #!Label15 #!Label16
#!Label14:
	vufloat  temporary_8 numSamples
	flt  temporary_6 i temporary_8
	for temporary_6
	random	("f=")  u_1 0
	random	("f=")  v_1 1
	vuvector  temporary_7 P0
	vfromf  temporary_10 u_1
	subvv  temporary_0 P1 P0
	vuvector  temporary_11 temporary_0
	mulvv  temporary_9 temporary_10 temporary_11
	addvv  edge0 temporary_7 temporary_9
	vuvector  temporary_7 P2
	vfromf  temporary_10 u_1
	subvv  temporary_0 P3 P2
	vuvector  temporary_11 temporary_0
	mulvv  temporary_9 temporary_10 temporary_11
	addvv  edge1 temporary_7 temporary_9
	vfromf  temporary_9 v_1
	subvv  temporary_10 edge1 edge0
	mulvv  temporary_7 temporary_9 temporary_10
	addvv  Psample edge0 temporary_7
	subvv  toSample Psample Ps
	visibility	("f=pp")  temporary_8 Ps Psample 2
	dot  temporary_12 toSample toSample
	divff  temporary_6 temporary_8 temporary_12
	addff  vis vis temporary_6
#!Label15:
	vufloat  temporary_6 1
	addff  i i temporary_6
#!Label16:
	forend
	vufloat  temporary_6 numSamples
	divff  vis vis temporary_6
	vufloat  temporary_8 intensity
	mulff  temporary_6 vis temporary_8
	vfromf  temporary_9 temporary_6
	vuvector  temporary_10 lightcolor
	mulvv  temporary_7 temporary_9 temporary_10
	normalize	("v=v")  temporary_10 L
	dot  temporary_6 N temporary_10
	vfromf  temporary_9 temporary_6
	mulvv  Cl temporary_7 temporary_9
#!Label13:
	endilluminate
	return
