# ImageIO_VcpkgManifest (spec 048, T036, FR-002): asserts only the `oiio` feature of vcpkg.json and that nothing
# else of OIIO leaks into the always-on manifest. It does not pin the other dependencies (spec 033 also edits
# vcpkg.json). Needs string(JSON), CMake >= 3.19.
#
#   cmake -DMANIFEST=<vcpkg.json> -P check_vcpkg_manifest.cmake
if(NOT MANIFEST OR NOT EXISTS "${MANIFEST}")
    message(FATAL_ERROR "ImageIO_VcpkgManifest: manifest not found: '${MANIFEST}'")
endif()
file(READ "${MANIFEST}" json)
set(failures 0)

function(fail what)
    message(STATUS "FAIL: ${what}")
    math(EXPR n "${failures}+1")
    set(failures ${n} PARENT_SCOPE)
endfunction()

# builtin-baseline unchanged (a bump would rebuild LLVM).
string(JSON baseline ERROR_VARIABLE err GET "${json}" "builtin-baseline")
if(err OR NOT baseline STREQUAL "319504a5326aa870edde46438c5455fa76305a56")
    fail("builtin-baseline is '${baseline}', expected 319504a5326aa870edde46438c5455fa76305a56")
else()
    message(STATUS "ok:   builtin-baseline unchanged")
endif()

# features.oiio.dependencies is exactly [ { name: openimageio, default-features: false } ].
string(JSON deps ERROR_VARIABLE err GET "${json}" "features" "oiio" "dependencies")
if(err)
    fail("vcpkg.json has no features.oiio.dependencies (${err})")
else()
    string(JSON count LENGTH "${deps}")
    if(NOT count EQUAL 1)
        fail("features.oiio.dependencies has ${count} entries, expected exactly 1")
    else()
        string(JSON type TYPE "${deps}" 0)
        if(NOT type STREQUAL "OBJECT")
            fail("features.oiio.dependencies[0] is ${type}, expected an object")
        else()
            string(JSON name GET "${deps}" 0 "name")
            string(JSON defaults ERROR_VARIABLE derr GET "${deps}" 0 "default-features")
            if(NOT name STREQUAL "openimageio")
                fail("features.oiio.dependencies[0].name is '${name}', expected openimageio")
            elseif(derr OR NOT defaults STREQUAL "OFF")
                fail("features.oiio.dependencies[0] must set default-features to false")
            else()
                message(STATUS "ok:   features.oiio is exactly openimageio with default-features false")
            endif()
        endif()
    endif()
endif()

# openimageio is not a top-level dependency (OIIO off must not install it).
string(JSON top ERROR_VARIABLE err GET "${json}" "dependencies")
if(err)
    fail("vcpkg.json has no dependencies array")
else()
    string(JSON n LENGTH "${top}")
    set(found FALSE)
    if(n GREATER 0)
        math(EXPR last "${n}-1")
        foreach(i RANGE ${last})
            string(JSON type TYPE "${top}" ${i})
            if(type STREQUAL "STRING")
                string(JSON dep GET "${top}" ${i})
            else()
                string(JSON dep GET "${top}" ${i} "name")
            endif()
            if(dep STREQUAL "openimageio")
                set(found TRUE)
            endif()
        endforeach()
    endif()
    if(found)
        fail("openimageio is a top-level dependency; it must live only in features.oiio")
    else()
        message(STATUS "ok:   openimageio is not a top-level dependency")
    endif()
endif()

if(failures GREATER 0)
    message(FATAL_ERROR "ImageIO_VcpkgManifest: ${failures} check(s) failed")
endif()
