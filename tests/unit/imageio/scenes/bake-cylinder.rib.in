##RenderMan RIB-Structure 1.0
# ImageIO_BakeRender (spec 048, US3-3): a sphere reflecting a baked cylindrical (lat-long) environment map, legacy-baked and
# OIIO-baked (@TEXTURE@). See bake-plain.rib.in.
version 3.03
Hider "reyes"
Display "bake-cylinder.tif" "file" "rgba"
Format 64 64 1
PixelSamples 2 2
Projection "perspective" "fov" 40
Translate 0 0 4
WorldBegin
  LightSource "ambientlight" 1 "intensity" [0.2]
  Surface "mirror" "texname" ["@TEXTURE@"] "Kr" [1] "Ks" [0]
  Sphere 1 -1 1 360
WorldEnd
