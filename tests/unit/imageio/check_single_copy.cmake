# ImageIO_SingleCopy (spec 048, T116, V9, SC-005, FR-004): exactly one image of the install tree carries OpenImageIO.
#
#   cmake -DPREFIX=<install prefix> -DNM=<nm> -DSYSTEM=<Darwin|Linux> -P check_single_copy.cmake
#
# The prefix is an UNSTRIPPED install (a stripped one drops the local symbols this test reads: the OIIO code that is linked into libRIBImageIO
# from static archives is hidden, i.e. local, and would not be seen). Every Mach-O, ELF and static archive file under the prefix is read with
# `nm -a`. OIIO's symbols are recognised by the namespace that every one of them is mangled with: `OpenImageIO` (the library's namespace; the
# mangled form is ...11OpenImageIO4v3_1..., so the string "OpenImageIO_v3" does NOT occur in a mangled name and would match nothing).
#
#   - with static OIIO (vcpkg) exactly one file, libRIBImageIO, DEFINES OpenImageIO symbols and no other file defines or references one;
#   - with shared OIIO no project file defines one: the only definers are OIIO's own libraries (libOpenImageIO*, which the self-contained install
#     bundles into the prefix when OIIO is a shared library, or none at all when it stays in the system), libRIBImageIO REFERENCES them and
#     defines no GLOBAL one (it may hold local copies of the inline code of OIIO's headers: nm types in lower case), and no other file defines
#     or references one;
#   - libRIBImageIO EXPORTS no OpenImageIO or OpenColorIO symbol (`nm -g` on macOS, `nm -D` on Linux: only the orimageio:: interface leaves);
#   - the display module (oiio.dsply) and libRIBRender do reference orimageio:: symbols (the test is not vacuous: the edge exists).
foreach(var PREFIX NM SYSTEM)
    if(NOT ${var})
        message(FATAL_ERROR "ImageIO_SingleCopy: pass -D${var}=...")
    endif()
endforeach()
if(NOT IS_DIRECTORY "${PREFIX}")
    message(FATAL_ERROR "ImageIO_SingleCopy: ${PREFIX} does not exist (the install fixture did not run)")
endif()

set(failures 0)
function(fail what)
    message(STATUS "FAIL: ${what}")
    set_property(GLOBAL APPEND PROPERTY SINGLE_COPY_FAILURES "${what}")
endfunction()
set_property(GLOBAL PROPERTY SINGLE_COPY_FAILURES "")

# every regular file whose first bytes say Mach-O (thin or fat), ELF or a static archive
file(GLOB_RECURSE all_files LIST_DIRECTORIES false "${PREFIX}/*")
set(binaries "")
foreach(f IN LISTS all_files)
    if(IS_SYMLINK "${f}")
        continue()
    endif()
    file(READ "${f}" magic HEX LIMIT 5)
    if(magic MATCHES "^(7f454c46|cffaedfe|cefaedfe|feedfacf|feedface|cafebabe|bebafeca)" OR magic MATCHES "^213c617263")
        list(APPEND binaries "${f}")
    endif()
endforeach()
list(LENGTH binaries n_binaries)
if(n_binaries EQUAL 0)
    fail("no binary found under ${PREFIX}")
endif()

# the OIIO symbols of one file: the number of defined, of globally defined (an upper case nm type other than U, V, W) and of undefined lines of `nm -a` that name OpenImageIO
function(oiio_counts file out_defined out_global out_undefined)
    set(dump "${CMAKE_CURRENT_BINARY_DIR}/single_copy_nm.txt")
    execute_process(COMMAND "${NM}" -a "${file}" OUTPUT_FILE "${dump}" ERROR_QUIET RESULT_VARIABLE rc)
    # defined symbols start with an address, undefined ones with blanks; hidden code linked in from a static archive is local (lower case type)
    file(STRINGS "${dump}" defined REGEX "^[0-9a-fA-F]+ .*OpenImageIO")
    file(STRINGS "${dump}" global REGEX "^[0-9a-fA-F]+ [A-TXYZ] .*OpenImageIO")
    file(STRINGS "${dump}" undefined REGEX "^ +[Uuwv] .*OpenImageIO")
    list(LENGTH defined nd)
    list(LENGTH global ng)
    list(LENGTH undefined nu)
    set(${out_defined} ${nd} PARENT_SCOPE)
    set(${out_global} ${ng} PARENT_SCOPE)
    set(${out_undefined} ${nu} PARENT_SCOPE)
endfunction()

set(is_library "^libRIBImageIO[.0-9]*(\\.dylib|\\.so[.0-9]*)?$")
set(is_oiio_library "^libOpenImageIO")
set(oiio_definers "")       # OIIO's own libraries that define OpenImageIO symbols
set(other_definers "")      # a definer that is neither libRIBImageIO nor an OIIO library
set(other_referencers "")   # a referencer that is neither libRIBImageIO nor an OIIO library
foreach(f IN LISTS binaries)
    oiio_counts("${f}" nd ng nu)
    get_filename_component(name "${f}" NAME)
    if(nd GREATER 0)
        message(STATUS "${name}: defines ${nd} OpenImageIO symbols (${ng} global)")
    endif()
    if(nu GREATER 0)
        message(STATUS "${name}: references ${nu} OpenImageIO symbols")
    endif()
    if(name MATCHES "${is_oiio_library}")
        if(nd GREATER 0)
            list(APPEND oiio_definers "${name}")
        endif()
    elseif(NOT name MATCHES "${is_library}")
        if(nd GREATER 0)
            list(APPEND other_definers "${name}")
        endif()
        if(nu GREATER 0)
            list(APPEND other_referencers "${name}")
        endif()
    endif()
endforeach()
if(other_definers)
    fail("a second copy of OpenImageIO: defined in ${other_definers}")
endif()
if(other_referencers)
    fail("OpenImageIO reached other than through orimageio::: referenced by ${other_referencers}")
endif()

# the one copy: libRIBImageIO (the real file, not a symlink) defines it with static OIIO and references it with shared OIIO
file(GLOB_RECURSE library_files "${PREFIX}/*libRIBImageIO*")
set(real_library "")
foreach(f IN LISTS library_files)
    if(NOT IS_SYMLINK "${f}")
        list(APPEND real_library "${f}")
    endif()
endforeach()
list(LENGTH real_library n_library)
if(NOT n_library EQUAL 1)
    fail("expected exactly one libRIBImageIO file under the prefix, found ${n_library}: ${real_library}")
else()
    oiio_counts("${real_library}" lib_defined lib_global lib_undefined)
    if(oiio_definers)
        # shared OIIO bundled into the prefix: its own libraries are the definers; ours references them and exports none of its own
        if(lib_global GREATER 0)
            fail("libRIBImageIO defines ${lib_global} global OpenImageIO symbols although OpenImageIO is a bundled shared library (${oiio_definers})")
        elseif(lib_undefined EQUAL 0)
            fail("libRIBImageIO references no OpenImageIO symbol although OpenImageIO is bundled (${oiio_definers})")
        else()
            message(STATUS "shared OpenImageIO (bundled: ${oiio_definers}): libRIBImageIO references ${lib_undefined} symbols and holds ${lib_defined} local inline ones")
        endif()
    elseif(lib_undefined EQUAL 0 AND lib_defined GREATER 0)
        message(STATUS "static OpenImageIO: libRIBImageIO defines ${lib_defined} symbols and is the only definer")
    elseif(lib_undefined GREATER 0 AND lib_global EQUAL 0)
        message(STATUS "shared OpenImageIO (not bundled): no project file defines one; libRIBImageIO references ${lib_undefined}")
    else()
        fail("libRIBImageIO neither carries OpenImageIO (static) nor references it (shared): defined ${lib_defined} (${lib_global} global), referenced ${lib_undefined}")
    endif()

    # nothing of OIIO or OCIO leaves the library
    if(SYSTEM STREQUAL "Darwin")
        execute_process(COMMAND "${NM}" -g --defined-only "${real_library}" OUTPUT_VARIABLE exported ERROR_QUIET)
    else()
        execute_process(COMMAND "${NM}" -D --defined-only "${real_library}" OUTPUT_VARIABLE exported ERROR_QUIET)
    endif()
    string(REGEX MATCHALL "[^\n]*(OpenImageIO|OpenColorIO)[^\n]*" leaked "${exported}")
    list(LENGTH leaked n_leaked)
    if(n_leaked GREATER 0)
        list(GET leaked 0 first)
        fail("libRIBImageIO exports ${n_leaked} OpenImageIO/OpenColorIO symbols, e.g. ${first}")
    endif()
    string(REGEX MATCHALL "[^\n]*orimageio[^\n]*" ours "${exported}")
    list(LENGTH ours n_ours)
    if(n_ours EQUAL 0)
        fail("libRIBImageIO exports no orimageio:: symbol (the interface is not exported)")
    endif()
endif()

# the edges exist: the display module and libRIBRender reference orimageio:: symbols
foreach(pattern "oiio.dsply" "libRIBRender*")
    file(GLOB_RECURSE targets "${PREFIX}/${pattern}")
    set(real "")
    foreach(f IN LISTS targets)
        if(NOT IS_SYMLINK "${f}")
            list(APPEND real "${f}")
        endif()
    endforeach()
    list(LENGTH real n_real)
    if(n_real EQUAL 0)
        fail("${pattern} is not under the prefix")
        continue()
    endif()
    foreach(f IN LISTS real)
        execute_process(COMMAND "${NM}" -u "${f}" OUTPUT_VARIABLE undefined ERROR_QUIET)
        string(REGEX MATCHALL "[^\n]*orimageio[^\n]*" edges "${undefined}")
        list(LENGTH edges n_edges)
        get_filename_component(name "${f}" NAME)
        if(n_edges EQUAL 0)
            fail("${name} references no orimageio:: symbol (the OIIO edge it should have is missing)")
        else()
            message(STATUS "ok: ${name} references ${n_edges} orimageio:: symbols and no OpenImageIO symbol")
        endif()
    endforeach()
endforeach()

get_property(all_failures GLOBAL PROPERTY SINGLE_COPY_FAILURES)
if(all_failures)
    list(LENGTH all_failures n)
    message(FATAL_ERROR "ImageIO_SingleCopy: ${n} check(s) failed")
endif()
message(STATUS "ImageIO_SingleCopy: ${n_binaries} binaries read, one copy of OpenImageIO")
