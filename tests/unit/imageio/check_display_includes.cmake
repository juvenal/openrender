# ImageIO_DisplayLoad, the include boundary (spec 048, T104, FR-008): the source of oiio.dsply includes dsply.h, file/file_base.h (in-tree
# helper), orImageIO.h and common/diagnostics.h (the one other header: error()) from the project, and standard headers; no renderer-core
# header and no OpenImageIO, OpenEXR, Imath, libtiff or libpng header.
#
#   cmake -DSOURCE=<src/display/oiio/oiio.cpp> -P check_display_includes.cmake
if(NOT SOURCE)
    message(FATAL_ERROR "ImageIO_DisplayLoad (includes): pass -DSOURCE=...")
endif()
if(NOT EXISTS "${SOURCE}")
    message(FATAL_ERROR "ImageIO_DisplayLoad (includes): ${SOURCE} does not exist (the oiio display driver is not written yet)")
endif()
file(STRINGS "${SOURCE}" lines REGEX "^[ \t]*#[ \t]*include")
set(bad "")
set(seen "")
foreach(line IN LISTS lines)
    if(line MATCHES "#[ \t]*include[ \t]*\"([^\"]+)\"")
        set(inc "${CMAKE_MATCH_1}")
        list(APPEND seen "${inc}")
        if(NOT (inc STREQUAL "dsply.h" OR inc STREQUAL "file/file_base.h" OR inc STREQUAL "orImageIO.h" OR inc STREQUAL "common/diagnostics.h"))
            list(APPEND bad "\"${inc}\"")
        endif()
    elseif(line MATCHES "#[ \t]*include[ \t]*<([^>]+)>")
        set(inc "${CMAKE_MATCH_1}")
        list(APPEND seen "${inc}")
        # a standard header has no directory and no .h of a third-party library
        if(inc MATCHES "/" OR inc MATCHES "^(png|tiff|tiffio|zlib|half|Imf[A-Za-z]*)\\.h$")
            list(APPEND bad "<${inc}>")
        endif()
    endif()
endforeach()
foreach(required dsply.h file/file_base.h orImageIO.h)
    list(FIND seen "${required}" at)
    if(at EQUAL -1)
        list(APPEND bad "(missing) \"${required}\"")
    endif()
endforeach()
if(bad)
    list(JOIN bad ", " joined)
    message(FATAL_ERROR "ImageIO_DisplayLoad (includes): ${SOURCE}: not allowed or missing: ${joined}")
endif()
message(STATUS "ok: ${SOURCE} includes only the allowed headers")
