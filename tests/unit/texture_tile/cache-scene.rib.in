##RenderMan RIB-Structure 1.0
# Opt-in disk-cache test scene template, spec 020 (020-runtime-tile-paging),
# T018b/T019/T020/T021. A sphere textured directly from an unbaked PNG
# source (no otexmake bake step), with "Option \"texturecache\"" enabled --
# unlike examples/rib/tests/parity/unbaked-png-*.rib (which deliberately
# stay cache-agnostic, since they exist to test the in-memory
# CSynthesizedTileSource path specifically), these tests need the cache
# statement present.
#
# Two placeholders, substituted by each test script before rendering:
#   @TEXTURE_PATH@  -- absolute path to the (possibly test-private-copy)
#                      source PNG, since locateFile() resolves any path
#                      containing a directory separator directly, bypassing
#                      the TEXTURES search path entirely (no need to touch
#                      that search path per test run).
#   @CACHE_OPTION@  -- the full "Option \"texturecache\" ..." statement
#                      (varies per test: with/without an explicit
#                      "directory" token).
version 3.03
@CACHE_OPTION@
Hider "raytrace"
Display "cache-scene.tif" "file" "rgba"
Projection "perspective"
Clipping 1 100000
Translate 0 0 4
WorldBegin
  LightSource "ambientlight" 1 "intensity" [0.3]
  LightSource "distantlight" 2 "intensity" [0.85] "from" [5 5 -5] "to" [0 0 0]
  Surface "paintedplastic" "texturename" ["@TEXTURE_PATH@"]
  Sphere 1 -1 1 360
WorldEnd
