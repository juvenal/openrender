# Spec 037 procedure scene "@SCENE_NAME@" (FR-030, SC-004: loading a procedure module changes no pixel).
# Deterministic: box filter, one sample per pixel, 32 x 32. Modules are named by absolute path or by
# the explicit search paths below; the compiled-in defaults (the gitignored deploy tree) are never used.
Option "searchpath" "display" ["@OR_DISPLAY_PATH@"]
Option "searchpath" "procedural" ["@PROC_SEARCHPATH@"]
Format 32 32 1
PixelSamples 1 1
PixelFilter "box" 1 1
ShadingRate 1
@PROC_PRE@
Display "@SCENE_FILE@" "file" "rgba"
Projection "perspective" "fov" 30
Translate 0 0 4

WorldBegin
    Surface "constant"
    Color [0.9 0.5 0.3]
@PROC_BODY@
WorldEnd
