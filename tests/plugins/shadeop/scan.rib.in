# Spec 037, ShadeopAbi_MissingExec (FR-033): the shader calls probe_add. The first procedural
# directory holds a module whose table names the operand but whose exec symbol is absent; the
# second holds a module with the full operand. The scan must skip the first and go on.
# The shader format is .rslo in this template.
Option "shaderformat" "default" ["rslo"]
Option "searchpath" "shader" ["@SHADEOP_SHADER_DIR@:@SHADEOP_SHADER_DEFAULT_DIR@"]
Option "searchpath" "display" ["@OR_DISPLAY_PATH@"]
Option "searchpath" "procedural" ["@SHADEOP_DIR_A@:@SHADEOP_DIR_B@"]
Format 8 8 1
PixelSamples 1 1
PixelFilter "box" 1 1
Projection "perspective" "fov" 30
Translate 0 0 4

Display "scan.tif" "file" "rgba"
WorldBegin
    Surface "probe"
    Sphere 1 -1 1 360
WorldEnd
