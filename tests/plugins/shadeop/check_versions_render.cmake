# ShadeopAbi_Versions_Render (SC-001, SC-002, FR-003, FR-004, FR-011, FR-013). Run as
#   cmake -DORENDER=<orender> -DRIBDIR=<dir of <case>.rib> -DWORKROOT=<dir> -DCOMMON=<dir> -P this
#
# The render-level half of the shadeop version cases, driven by .rslo renders of probe.sl / probe_two.sl
# (the shader format is .rslo in these cases). It needs no new API, so it is enabled and red on the
# starting tree, where the renderer calls no version check and never looks at a per-thread table. Each
# case is two frames on four shading threads (fixtures: shadeop_fixture.cpp):
#
#   good, hidden     current interface (hidden: hidden symbol visibility), 1.1 per-thread table:
#                    loaded, no version diagnostic; threadInit lazily, once per thread index across
#                    both frames; threadCleanup after the last exec, then cleanup, then the unload
#                    (FR-011). good_f1, hidden_f1: the same in ONE frame, where each exec gets the data
#                    its own OS thread's threadInit returned (FR-011 b)
#   newer 1.9.0      loaded, exactly one warning, exec ran
#   v2 2.0.0 alone   exactly one error that names the file, the interface, both versions and the
#                    remedy; no entry point of the module is ever called (SC-001)
#   v2 then good     the scan skips the rejected module and the later one serves the operand
#   legacy           no version symbol: loaded, and across the TWO operands (probe_add, probe_mul)
#                    of the one module exactly one warning (SC-002)
include(${COMMON}/render.cmake)
set(_or_failures 0)

# Runs one case: sets _rc, _out and _lines (the fixture log) for it.
macro(run_case name)
    or_render(ORENDER "${ORENDER}" RIB "${RIBDIR}/${name}.rib" WORKDIR "${WORKROOT}/${name}"
              LOG "${WORKROOT}/${name}.log" RESULT _rc OUTPUT _out)
    or_log_read("${WORKROOT}/${name}.log" _lines)
    or_rc_is_status("${_rc}" _is_status)
    if(NOT _is_status)
        or_fail("${name}: orender crashed ('${_rc}')")
    endif()
endmacro()

# The diagnostics of this family in the render output: one per match.
macro(count_version_messages out)
    string(REGEX MATCHALL "the shadeop plug-in" _matches "${_out}")
    list(LENGTH _matches ${out})
endmacro()

macro(expect_exit_zero name)
    if(_is_status AND NOT _rc EQUAL 0)
        or_fail("${name}: orender exited with status ${_rc}, expected 0\n${_out}")
    endif()
endmacro()

# good and hidden: the full current interface.
foreach(_tag good hidden)
    run_case(${_tag})
    expect_exit_zero(${_tag})
    count_version_messages(_n)
    if(NOT _n EQUAL 0)
        or_fail("${_tag}: ${_n} version diagnostic(s) for a current-interface module, expected none:\n${_out}")
    endif()
    or_log_count(_inits "${_tag}:init data=" ${_lines})
    or_log_count(_execs "${_tag}:exec data=" ${_lines})
    if(_inits EQUAL 0 OR _execs EQUAL 0)
        or_fail("${_tag}: the operand did not run (init ${_inits}, exec ${_execs})")
    endif()

    # threadInit: lazily and once per thread index, over both frames.
    set(_tinit_idx "")
    foreach(_line IN LISTS _lines)
        if(_line MATCHES "^[0-9]+ ${_tag}:threadInit idx=([0-9]+) data=([0-9a-f]+) initdata=([0-9a-f]+) ([0-9]+)$")
            list(APPEND _tinit_idx ${CMAKE_MATCH_1})
        endif()
    endforeach()
    list(LENGTH _tinit_idx _tinits)
    if(_tinits EQUAL 0)
        or_fail("${_tag}: the module's per-thread init (probe_add_shadeop_threads) was never called (FR-011)")
    else()
        set(_unique ${_tinit_idx})
        list(REMOVE_DUPLICATES _unique)
        list(LENGTH _unique _distinct)
        if(NOT _distinct EQUAL _tinits)
            or_fail("${_tag}: threadInit ran ${_tinits} times for ${_distinct} thread index(es); it must run once per index across both frames (FR-011 b, c)")
        endif()
        # the order of the end of life: last exec, threadCleanup, cleanup, unload
        or_log_count(_tcleans "${_tag}:threadCleanup" ${_lines})
        if(NOT _tcleans EQUAL _tinits)
            or_fail("${_tag}: ${_tinits} threadInit call(s) but ${_tcleans} threadCleanup call(s) (FR-011 d)")
        endif()
        set(_last_exec -1)
        set(_first_tclean -1)
        set(_last_tclean -1)
        set(_cleanup -1)
        set(_unload -1)
        set(_i 0)
        foreach(_line IN LISTS _lines)
            if(_line MATCHES "^[0-9]+ ${_tag}:exec data=")
                set(_last_exec ${_i})
            elseif(_line MATCHES "^[0-9]+ ${_tag}:threadCleanup ")
                if(_first_tclean EQUAL -1)
                    set(_first_tclean ${_i})
                endif()
                set(_last_tclean ${_i})
            elseif(_line MATCHES "^[0-9]+ ${_tag}:cleanup ")
                set(_cleanup ${_i})
            elseif(_line MATCHES "^[0-9]+ ${_tag}:unload ")
                set(_unload ${_i})
            endif()
            math(EXPR _i "${_i} + 1")
        endforeach()
        if(_first_tclean EQUAL -1 OR NOT (_last_exec LESS _first_tclean AND _last_tclean LESS _cleanup AND _cleanup LESS _unload))
            or_fail("${_tag}: expected last exec < threadCleanup < cleanup < unload, got last exec ${_last_exec}, threadCleanup ${_first_tclean}..${_last_tclean}, cleanup ${_cleanup}, unload ${_unload} (FR-011 d, FR-034)")
        endif()
    endif()
endforeach()

# good and hidden, one frame: each exec gets the data of the OS thread that ran its threadInit. One frame,
# because a second frame starts new threads and glibc reuses their ids for other thread indices.
foreach(_tag good hidden)
    run_case(${_tag}_f1)
    expect_exit_zero(${_tag}_f1)
    foreach(_v IN LISTS _tid_vars)
        unset(${_v})
    endforeach()
    set(_tid_vars "")
    foreach(_line IN LISTS _lines)
        if(_line MATCHES "^[0-9]+ ${_tag}:threadInit idx=([0-9]+) data=([0-9a-f]+) initdata=([0-9a-f]+) ([0-9]+)$")
            set(_tid_of_${CMAKE_MATCH_2} ${CMAKE_MATCH_4})
            list(APPEND _tid_vars _tid_of_${CMAKE_MATCH_2})
        endif()
    endforeach()
    set(_execs_checked 0)
    foreach(_line IN LISTS _lines)
        if(_line MATCHES "^[0-9]+ ${_tag}:exec data=([0-9a-f]+) ([0-9]+)$")
            math(EXPR _execs_checked "${_execs_checked} + 1")
            if(NOT DEFINED _tid_of_${CMAKE_MATCH_1})
                or_fail("${_tag} (one frame): exec was called with data ${CMAKE_MATCH_1}, which no threadInit returned (FR-011 b)")
                break()
            elseif(NOT "${_tid_of_${CMAKE_MATCH_1}}" STREQUAL "${CMAKE_MATCH_2}")
                or_fail("${_tag} (one frame): exec ran on thread ${CMAKE_MATCH_2} with the data that thread ${_tid_of_${CMAKE_MATCH_1}} initialized (FR-011 b)")
                break()
            endif()
        endif()
    endforeach()
    if(_execs_checked EQUAL 0)
        or_fail("${_tag} (one frame): the operand did not run")
    endif()
endforeach()

# newer: loaded, one warning.
run_case(newer)
expect_exit_zero(newer)
count_version_messages(_n)
if(NOT _n EQUAL 1)
    or_fail("newer: ${_n} version diagnostic(s), expected exactly one warning:\n${_out}")
elseif(NOT "${_out}" MATCHES "1\\.9\\.0")
    or_fail("newer: the warning does not name the module's version 1.9.0:\n${_out}")
endif()
or_log_count(_execs "newer:exec data=" ${_lines})
if(_execs EQUAL 0)
    or_fail("newer: a module of a newer MINOR was not used")
endif()

# v2 alone: rejected with the full message; nothing of the module is called.
run_case(v2_only)
count_version_messages(_n)
if(NOT _n EQUAL 1)
    or_fail("v2: ${_n} version diagnostic(s), expected exactly one error:\n${_out}")
else()
    foreach(_part "v2\\.dsply" "2\\.0\\.0" "1\\.1\\.0" "rebuild against the installed header")
        if(NOT "${_out}" MATCHES "${_part}")
            or_fail("v2: the error does not contain \"${_part}\" (file, both versions, remedy):\n${_out}")
        endif()
    endforeach()
endif()
or_log_count(_entered "v2:(init|exec|cleanup|threadInit|threadCleanup)" ${_lines})
if(NOT _entered EQUAL 0)
    or_fail("v2: ${_entered} entry point call(s) of a rejected module (SC-001)")
endif()

# v2 then good: the scan goes on.
run_case(v2_then_good)
# (no exit status check: the rejection of v2 is an error(), and orender exits 255 after any error())
count_version_messages(_n)
if(NOT _n EQUAL 1)
    or_fail("v2 then good: ${_n} version diagnostic(s), expected exactly one (the rejection):\n${_out}")
endif()
or_log_count(_entered "v2:(init|exec|cleanup|threadInit|threadCleanup)" ${_lines})
if(NOT _entered EQUAL 0)
    or_fail("v2 then good: ${_entered} entry point call(s) of a rejected module (SC-001)")
endif()
or_log_count(_execs "good:exec data=" ${_lines})
if(_execs EQUAL 0)
    or_fail("v2 then good: the scan did not go on to the module after the rejected one")
endif()

# legacy: one warning across two operands of one module.
run_case(legacy)
expect_exit_zero(legacy)
count_version_messages(_n)
if(NOT _n EQUAL 1)
    or_fail("legacy: ${_n} version diagnostic(s) across two operands, expected exactly one warning (SC-002):\n${_out}")
else()
    foreach(_part "legacy\\.dsply" "1\\.0\\.0" "1\\.2\\.0")
        if(NOT "${_out}" MATCHES "${_part}")
            or_fail("legacy: the warning does not contain \"${_part}\" (file, 1.0.0, the release that rejects it):\n${_out}")
        endif()
    endforeach()
endif()
or_log_count(_add "legacy:exec data=" ${_lines})
or_log_count(_mul "legacy:exec_mul" ${_lines})
if(_add EQUAL 0 OR _mul EQUAL 0)
    or_fail("legacy: both operands must run (probe_add ${_add}, probe_mul ${_mul})")
endif()

if(_or_failures GREATER 0)
    message(FATAL_ERROR "ShadeopAbi_Versions_Render: ${_or_failures} failure(s).")
endif()
