# Spec 038, the JIT DSO parity tests (ShadeopAbi_Jit_*): the scene of render.rib.in (spec 037) with the shader
# format as a parameter. Two frames of a sphere shaded by @RIB_SURFACE@, whose operand comes from the modules
# in the procedural search path @RIB_PROC_PATH@, on @RIB_THREADS@ shading thread(s) with 8x8 buckets, read as
# @RIB_SHADER_FORMAT@ from @RIB_SHADER_DIR@. Two frames, because per-thread data lasts until RiEnd and not
# until the end of a frame. Deterministic: one pixel sample, a box filter, no randomness in the shaders.
Option "shaderformat" "default" ["@RIB_SHADER_FORMAT@"]
Option "searchpath" "shader" ["@RIB_SHADER_DIR@:@SHADEOP_SHADER_DEFAULT_DIR@"]
Option "searchpath" "display" ["@OR_DISPLAY_PATH@"]
Option "searchpath" "procedural" ["@RIB_PROC_PATH@"]
Option "limits" "numthreads" [@RIB_THREADS@]
Option "limits" "bucketsize" [8 8]

FrameBegin 1
    Format @RIB_SIZE@ @RIB_SIZE@ 1
    PixelSamples 1 1
    PixelFilter "box" 1 1
    Projection "perspective" "fov" 30
    Translate 0 0 4
    Display "@RIB_OUTPUT@" "file" "rgba"
    WorldBegin
        Surface "@RIB_SURFACE@"
        Sphere 1 -1 1 360
    WorldEnd
FrameEnd

FrameBegin 2
    Format @RIB_SIZE@ @RIB_SIZE@ 1
    PixelSamples 1 1
    PixelFilter "box" 1 1
    Projection "perspective" "fov" 30
    Translate 0 0 4
    Display "@RIB_OUTPUT@" "file" "rgba"
    WorldBegin
        Surface "@RIB_SURFACE@"
        Sphere 1 -1 1 360
    WorldEnd
FrameEnd
