# Spec 037, ShadeopAbi_Versions_Render, the one-frame renders (good_f1, hidden_f1): one
# frame of a sphere shaded by @RIB_SURFACE@, whose operand comes from the modules in the procedural
# search path @RIB_PROC_PATH@, on @RIB_THREADS@ shading thread(s) with 8x8 buckets. The shader format is
# .rslo in this template. One frame, so an OS thread keeps one thread
# index for the whole render: the thread-affinity check of the per-thread data needs that (a second frame
# starts new threads, and glibc reuses their ids for other thread indices).
Option "shaderformat" "default" ["rslo"]
Option "searchpath" "shader" ["@SHADEOP_SHADER_DIR@:@SHADEOP_SHADER_DEFAULT_DIR@"]
Option "searchpath" "display" ["@OR_DISPLAY_PATH@"]
Option "searchpath" "procedural" ["@RIB_PROC_PATH@"]
Option "limits" "numthreads" [@RIB_THREADS@]
Option "limits" "bucketsize" [8 8]

FrameBegin 1
    Format 64 64 1
    PixelSamples 1 1
    PixelFilter "box" 1 1
    Projection "perspective" "fov" 30
    Translate 0 0 4
    Display "@RIB_OUTPUT@" "file" "rgba"
    WorldBegin
        Surface "@RIB_SURFACE@"
        Sphere 1 -1 1 360
    WorldEnd
FrameEnd
