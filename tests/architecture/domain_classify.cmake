# domain_classify.cmake -- helpers shared by the spec 038 mechanical checks (cmake -P scripts).
#
#   include(<this file>)
#   or_map_load(<domain-map.txt> <source dir> <build dir>)
#   or_map_path(<absolute path> <out>)         repo-relative path, "@build/..." under the build tree, "" outside both
#   or_map_class(<mapped path> <out>)          the class domain-map.txt gives it ("" if unclassified)
#   or_file_includes(<file> <names-out> <quoted-out>)   the #include lines of a file: names, and 1/0 for "x" / <x>
#   or_resolve_include(<including file> <name> <quoted> <dirs> <out>)   absolute path or ""
#
# The rules are archcheck's (tests/architecture/archcheck/config.cpp): a `file` rule beats a `prefix` rule, and among
# prefixes the longest wins. The map file stays the single source of truth; nothing here repeats a class.

set(_or_tab "\t")
set(_or_ws "[ ${_or_tab}]")

macro(or_map_load map_file source_dir build_dir)
    get_filename_component(OR_SOURCE_DIR "${source_dir}" REALPATH)
    get_filename_component(OR_BUILD_DIR "${build_dir}" REALPATH)
    set(OR_MAP_FILE_PATS "")
    set(OR_MAP_FILE_CLASSES "")
    set(OR_MAP_PREFIX_PATS "")
    set(OR_MAP_PREFIX_CLASSES "")
    file(STRINGS "${map_file}" _or_map_lines)
    foreach(_or_line IN LISTS _or_map_lines)
        string(REGEX REPLACE "#.*$" "" _or_line "${_or_line}")
        string(REGEX MATCH "^${_or_ws}*(file|prefix)${_or_ws}+([^ ${_or_tab}]+)${_or_ws}+([A-Za-z]+)${_or_ws}*$" _or_m "${_or_line}")
        if(_or_m)
            if(CMAKE_MATCH_1 STREQUAL "file")
                list(APPEND OR_MAP_FILE_PATS "${CMAKE_MATCH_2}")
                list(APPEND OR_MAP_FILE_CLASSES "${CMAKE_MATCH_3}")
            else()
                list(APPEND OR_MAP_PREFIX_PATS "${CMAKE_MATCH_2}")
                list(APPEND OR_MAP_PREFIX_CLASSES "${CMAKE_MATCH_3}")
            endif()
        endif()
    endforeach()
    list(LENGTH OR_MAP_PREFIX_PATS _or_n_prefix)
    list(LENGTH OR_MAP_FILE_PATS _or_n_file)
    if(_or_n_prefix EQUAL 0)
        message(FATAL_ERROR "no rules read from ${map_file}")
    endif()
endmacro()

function(or_map_path abs out)
    get_filename_component(_p "${abs}" REALPATH)
    string(LENGTH "${OR_SOURCE_DIR}/" _ls)
    string(LENGTH "${OR_BUILD_DIR}/" _lb)
    string(FIND "${_p}" "${OR_SOURCE_DIR}/" _is)
    string(FIND "${_p}" "${OR_BUILD_DIR}/" _ib)
    # the build tree may sit inside the source tree; the longer prefix is the right one
    if(_ib EQUAL 0 AND (NOT _is EQUAL 0 OR _lb GREATER _ls))
        string(SUBSTRING "${_p}" ${_lb} -1 _rel)
        set(${out} "@build/${_rel}" PARENT_SCOPE)
    elseif(_is EQUAL 0)
        string(SUBSTRING "${_p}" ${_ls} -1 _rel)
        set(${out} "${_rel}" PARENT_SCOPE)
    else()
        set(${out} "" PARENT_SCOPE)
    endif()
endfunction()

function(or_map_class mapped out)
    list(FIND OR_MAP_FILE_PATS "${mapped}" _i)
    if(NOT _i EQUAL -1)
        list(GET OR_MAP_FILE_CLASSES ${_i} _c)
        set(${out} "${_c}" PARENT_SCOPE)
        return()
    endif()
    set(_best -1)
    set(_best_class "")
    set(_idx 0)
    foreach(_pat IN LISTS OR_MAP_PREFIX_PATS)
        string(FIND "${mapped}" "${_pat}" _pos)
        if(_pos EQUAL 0)
            string(LENGTH "${_pat}" _len)
            if(_len GREATER _best)
                set(_best ${_len})
                list(GET OR_MAP_PREFIX_CLASSES ${_idx} _best_class)
            endif()
        endif()
        math(EXPR _idx "${_idx} + 1")
    endforeach()
    set(${out} "${_best_class}" PARENT_SCOPE)
endfunction()

function(or_file_includes file names quoted)
    set(_names "")
    set(_quoted "")
    if(EXISTS "${file}")
        file(STRINGS "${file}" _lines REGEX "^${_or_ws}*#${_or_ws}*include${_or_ws}*[\"<]")
        foreach(_line IN LISTS _lines)
            string(REGEX MATCH "^${_or_ws}*#${_or_ws}*include${_or_ws}*([\"<])([^\">]+)[\">]" _m "${_line}")
            if(_m)
                list(APPEND _names "${CMAKE_MATCH_2}")
                if(CMAKE_MATCH_1 STREQUAL "\"")
                    list(APPEND _quoted 1)
                else()
                    list(APPEND _quoted 0)
                endif()
            endif()
        endforeach()
    endif()
    set(${names} "${_names}" PARENT_SCOPE)
    set(${quoted} "${_quoted}" PARENT_SCOPE)
endfunction()

function(or_resolve_include from name quoted dirs out)
    set(_found "")
    set(_cands "")
    if(quoted)
        get_filename_component(_here "${from}" DIRECTORY)
        list(APPEND _cands "${_here}")
    endif()
    list(APPEND _cands ${dirs})
    foreach(_d IN LISTS _cands)
        if(EXISTS "${_d}/${name}" AND NOT IS_DIRECTORY "${_d}/${name}")
            set(_found "${_d}/${name}")
            break()
        endif()
    endforeach()
    set(${out} "${_found}" PARENT_SCOPE)
endfunction()

# or_is_compiled_source(<path> <out>): TRUE for a translation unit (the sources of a target also list headers)
function(or_is_compiled_source path out)
    if("${path}" MATCHES "\\.(c|cc|cpp|cxx|mm|m)$")
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

# or_fail(<message>) / or_finish(<test name>): collect the failures of one run and end with a FATAL_ERROR
macro(or_check_begin)
    set(_or_check_failures 0)
endmacro()
macro(or_check_fail msg)
    message("FAIL: ${msg}")
    math(EXPR _or_check_failures "${_or_check_failures} + 1")
endmacro()
macro(or_check_end name)
    if(_or_check_failures GREATER 0)
        message(FATAL_ERROR "${name}: ${_or_check_failures} failure(s).")
    endif()
    message(STATUS "${name}: ok")
endmacro()
