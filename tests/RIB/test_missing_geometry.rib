# Test RIB file to verify the Geometry statement with non-existent geometry
Display "test_missing_geom.tif" "tiff" "rgba"
Format 256 256 1
Projection "perspective" "fov" 45
Translate 0 0 5

WorldBegin

# Using the Geometry statement to reference a non-existent geometry
Geometry "nonexistent_object"

# Add some other geometry to make sure rendering continues
Sphere 1 -1 1 360

WorldEnd