# Spec 056 (volume shader segments), Phase 1: the registrations of the new scenes (tasks.md T037 to T039).
#
# Included from CMakeLists.txt after determinism-scenes.cmake, so add_parity_test() and add_thread_configs_test()
# exist. Every scene is generated by specs/056-volume-shader-segments/tools/gen_scenes.py into
# examples/rib/tests/<family>-<hider>[-slo].rib; the no-volume twin of a family is <family>-none-<hider>[-slo].rib.
#
# The scenes are written in camera space with a constant segment length for every probed pixel (research R11), so a
# pixel holds one hand-computed value on reyes, zbuffer and raytrace, in .rslo and .slo:
#   VOLUME_PROBE_TOL_FOG    = 0.0001   absolute, a value that contains exp()   (volume-probes.cmake, per probe)
#   VOLUME_PROBE_TOL_COLOUR = 0.00001  absolute, a pass-through colour
# Both are fixed at approval and are never widened. test_hider_parity reads 8-bit RGBA only, so the float probe scenes
# are not parity pairs: their cross-hider and cross-backend agreement is that every variant hits the same value at
# the same tolerance. Parity pairs exist only for the 8-bit glass sphere and the 8-bit atmosphere twins, at the default
# threshold (parity-thresholds.md, "Spec 056").

set(_volume_dir ${CMAKE_BINARY_DIR}/tests/visual/volume)
file(MAKE_DIRECTORY ${_volume_dir})
set(_volume_rib ${CMAKE_SOURCE_DIR}/examples/rib/tests)

# One -slo test is disabled without the JIT (its scene would silently run the interpreter, a guaranteed pass)
function(_volume_gate_slo TEST SCENE)
    if(SCENE MATCHES "-slo$" AND NOT OPENRENDER_HAVE_LLVM)
        set_tests_properties(${TEST} PROPERTIES DISABLED TRUE)
    endif()
endfunction()

# --- Pixel probes -----------------------------------------------------------------------------------------
# add_volume_probe(<scene> <x> <y> <tolerance> <value>...): one pixel of a float scene. The values are the
# scene header's hand-computed ones (volume-probes.cmake is generated with them).
#   Test name: VolumeProbe_<family>_<hider>_<rslo|slo>_x<X>y<Y>, <family> being the scene name without its "volume-" prefix,
#   hider and -slo suffix (so VolumeProbe_miss-clipping_*, VolumeProbe_csg-fragment_*, VolumeProbe_incident-opposite_*,
#   VolumeProbe_atmosphere-fog-reflection_* select a family; a no-volume twin is <family>-none, selected by '-none_').
macro(add_volume_probe SCENE X Y TOL)
    if(NOT "${SCENE}" MATCHES "^(.+)-(reyes|zbuffer|raytrace)(-slo)?$")
        message(FATAL_ERROR "add_volume_probe: ${SCENE} does not end in -<hider>[-slo]")
    endif()
    set(_fam ${CMAKE_MATCH_1})
    set(_hid ${CMAKE_MATCH_2})
    if(CMAKE_MATCH_3 STREQUAL "-slo")
        set(_fmt slo)
    else()
        set(_fmt rslo)
    endif()
    string(REGEX REPLACE "^volume-" "" _fam "${_fam}")
    set(_test VolumeProbe_${_fam}_${_hid}_${_fmt}_x${X}y${Y})
    set(_scratch ${_volume_dir}/${SCENE}-x${X}y${Y})
    file(MAKE_DIRECTORY ${_scratch})
    add_test(NAME ${_test}
        COMMAND test_pixel_probe $<TARGET_FILE:orender> ${_volume_rib}/${SCENE}.rib ${SCENE}.tif ${X} ${Y} ${TOL} ${ARGN}
        WORKING_DIRECTORY ${_scratch})
    set_tests_properties(${_test} PROPERTIES TIMEOUT 120 LABELS "visual;regression;volume"
        ENVIRONMENT "${VISUAL_ENV}" DEPENDS orender)
    _volume_gate_slo(${_test} ${SCENE})
endmacro()
include(${CMAKE_CURRENT_SOURCE_DIR}/volume-probes.cmake)

# --- Goldens of the starting tree, bit for bit per platform (FR-016, SC-007) -----------------------------------
# Captured on the unchanged starting tree by specs/056-volume-shader-segments/tools/capture_goldens.sh; the Linux
# files carry a provenance note (golden/linux/volume-atmosphere.provenance.txt). The atmosphere scenes are the
# characterisation of Atmosphere before the volume step changes the code beside it; the -none twins show that a scene
# with no Interior/Exterior renders as before.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(_volume_golden_dir ${CMAKE_CURRENT_SOURCE_DIR}/golden/linux)
else()
    set(_volume_golden_dir ${CMAKE_CURRENT_SOURCE_DIR}/golden)
endif()
macro(add_volume_golden TESTNAME SCENE)
    set(_scratch ${_volume_dir}/golden-${SCENE})
    file(MAKE_DIRECTORY ${_scratch})
    add_test(NAME ${TESTNAME}
        COMMAND test_golden_compare $<TARGET_FILE:orender> ${_volume_rib}/${SCENE}.rib ${SCENE}.tif
            ${_volume_golden_dir}/${SCENE}.tif
        WORKING_DIRECTORY ${_scratch})
    set_tests_properties(${TESTNAME} PROPERTIES TIMEOUT 120 LABELS "visual;regression;volume;golden"
        ENVIRONMENT "${VISUAL_ENV}" DEPENDS orender)
    _volume_gate_slo(${TESTNAME} ${SCENE})
endmacro()
set(VOLUME_GOLDEN_SCENES "")   # read by tools/capture_goldens.sh through the generated list below
foreach(_kind fog depthcue)
    foreach(_hider reyes zbuffer raytrace)
        foreach(_fmt "" "-slo")
            add_volume_golden(Golden_atmosphere-${_kind}-${_hider}${_fmt} atmosphere-${_kind}-${_hider}${_fmt})
            list(APPEND VOLUME_GOLDEN_SCENES atmosphere-${_kind}-${_hider}${_fmt})
        endforeach()
    endforeach()
endforeach()
foreach(_hider reyes zbuffer raytrace)
    foreach(_fmt "" "-slo")
        add_volume_golden(Golden_volume-none-interior-fog-slab-${_hider}${_fmt} volume-interior-fog-slab-none-${_hider}${_fmt})
        list(APPEND VOLUME_GOLDEN_SCENES volume-interior-fog-slab-none-${_hider}${_fmt})
    endforeach()
endforeach()
add_volume_golden(Golden_volume-none-random-fog-raytrace volume-random-fog-none-raytrace)
list(APPEND VOLUME_GOLDEN_SCENES volume-random-fog-none-raytrace)

# --- The glass sphere ---------------------------------------------------------------------------------------
# VolumeDiffer_glass-sphere-<hider>: the scene with Interior fog renders differently from its no-Interior twin
# (float pair: test_render_compare reads 32-bit float). Red on the starting tree, where the fog never runs.
foreach(_hider reyes zbuffer raytrace)
    set(_a volume-interior-fog-glass-sphere-float-${_hider})
    set(_b volume-interior-fog-glass-sphere-float-none-${_hider})
    set(_scratch ${_volume_dir}/differ-glass-sphere-${_hider})
    file(MAKE_DIRECTORY ${_scratch})
    add_test(NAME VolumeDiffer_glass-sphere-${_hider}
        COMMAND test_render_compare $<TARGET_FILE:orender> differ ${_volume_rib}/${_a}.rib ${_a}.tif ${_volume_rib}/${_b}.rib ${_b}.tif
        WORKING_DIRECTORY ${_scratch})
    set_tests_properties(VolumeDiffer_glass-sphere-${_hider} PROPERTIES TIMEOUT 240 LABELS "visual;regression;volume"
        ENVIRONMENT "${VISUAL_ENV}" DEPENDS orender)
endforeach()
# VolumeProbe_random-fog-runs: the random fog changes the image, so a green determinism test means the fog ran
set(_scratch ${_volume_dir}/random-fog-runs)
file(MAKE_DIRECTORY ${_scratch})
add_test(NAME VolumeProbe_random-fog-runs
    COMMAND test_render_compare $<TARGET_FILE:orender> differ
        ${_volume_rib}/volume-random-fog-raytrace.rib volume-random-fog-raytrace.tif
        ${_volume_rib}/volume-random-fog-none-raytrace.rib volume-random-fog-none-raytrace.tif
    WORKING_DIRECTORY ${_scratch})
set_tests_properties(VolumeProbe_random-fog-runs PROPERTIES TIMEOUT 240 LABELS "visual;regression;volume"
    ENVIRONMENT "${VISUAL_ENV}" DEPENDS orender)

# --- Parity (8-bit scenes only; the default threshold, see parity-thresholds.md) ---------------------------------
# These characterise the starting tree: green now. A red here is reported, never answered with a wider threshold.
set(_g volume-interior-fog-glass-sphere)
foreach(_hider reyes zbuffer)
    add_parity_test(volume-glass-sphere-${_hider}
        examples/rib/tests/${_g}-raytrace.rib ${_g}-raytrace.tif
        examples/rib/tests/${_g}-${_hider}.rib ${_g}-${_hider}.tif)
endforeach()
foreach(_kind fog depthcue)
    set(_a atmosphere-${_kind}-8bit)
    foreach(_hider reyes zbuffer)
        add_parity_test(atmosphere-${_kind}-${_hider}
            examples/rib/tests/${_a}-raytrace.rib ${_a}-raytrace.tif
            examples/rib/tests/${_a}-${_hider}.rib ${_a}-${_hider}.tif)
    endforeach()
endforeach()
if(OPENRENDER_HAVE_LLVM)
    add_parity_test(volume-glass-sphere-jit
        examples/rib/tests/${_g}-raytrace.rib ${_g}-raytrace.tif
        examples/rib/tests/${_g}-raytrace-slo.rib ${_g}-raytrace-slo.tif)
    foreach(_kind fog depthcue)
        set(_a atmosphere-${_kind}-8bit)
        add_parity_test(atmosphere-${_kind}-jit
            examples/rib/tests/${_a}-raytrace.rib ${_a}-raytrace.tif
            examples/rib/tests/${_a}-raytrace-slo.rib ${_a}-raytrace-slo.tif)
    endforeach()
endif()

# --- Determinism: the random fog at -t:1, -t:2 and -t:4, bit for bit (FR-015) -------------------------------------
add_thread_configs_test(Determinism_volume-random-fog
    examples/rib/tests/volume-random-fog-raytrace.rib volume-random-fog-raytrace.tif)
add_thread_configs_test(Determinism_volume-random-fog-slo
    examples/rib/tests/volume-random-fog-raytrace-slo.rib volume-random-fog-raytrace-slo.tif)
if(NOT OPENRENDER_HAVE_LLVM)
    set_tests_properties(Determinism_volume-random-fog-slo PROPERTIES DISABLED TRUE)
endif()
