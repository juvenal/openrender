# Spec 057 (area-light geometry), Phase 4: the closed-form probes of tests/visual/arealight-probes.cmake and the
# AreaLightBinding_Illuminate pair (tasks.md T061, T062).
#
# Included from CMakeLists.txt after volume-scenes.cmake. Every scene is generated by
# specs/057-area-light-geometry/tools/gen_scenes.py into examples/rib/tests/arealight-*.rib; the expected values and
# tolerances (4 sigma_1 / sqrt(n), n = 16) come from specs/057-area-light-geometry/tools/probe_expected.py and are written
# into both the scene headers and arealight-probes.cmake. A tolerance is fixed when the test is approved and never widened.
# The probe lights and receivers are test-local shaders (tests/arealight/shaders, built into
# ${CMAKE_BINARY_DIR}/tests/arealight/shaders), so SHADERS lists that directory first; no shader is added to shaders/.

set(_arealight_dir ${CMAKE_BINARY_DIR}/tests/visual/arealight)
file(MAKE_DIRECTORY ${_arealight_dir})
set(_arealight_rib ${CMAKE_SOURCE_DIR}/examples/rib/tests)
set(_arealight_env ${VISUAL_ENV})
list(TRANSFORM _arealight_env REPLACE "^SHADERS=(.*)$" "SHADERS=${CMAKE_BINARY_DIR}/tests/arealight/shaders:\\1")

# add_arealight_probe(<ctest name> <scene> <x> <y> <tolerance> [--channels=i,j] <value>...)
macro(add_arealight_probe TEST SCENE X Y TOL)
    set(_scratch ${_arealight_dir}/${TEST})
    file(MAKE_DIRECTORY ${_scratch})
    add_test(NAME ${TEST}
        COMMAND test_pixel_probe $<TARGET_FILE:orender> ${_arealight_rib}/${SCENE}.rib ${SCENE}.tif ${X} ${Y} ${TOL} ${ARGN}
        WORKING_DIRECTORY ${_scratch})
    set_tests_properties(${TEST} PROPERTIES TIMEOUT 120 LABELS "arealight;shading_parity" ENVIRONMENT "${_arealight_env}" DEPENDS orender)
    # an -slo scene without the JIT would silently run the interpreter, a guaranteed pass: disabled then
    if(SCENE MATCHES "-slo$" AND NOT OPENRENDER_HAVE_LLVM)
        set_tests_properties(${TEST} PROPERTIES DISABLED TRUE)
    endif()
endmacro()
include(${CMAKE_CURRENT_SOURCE_DIR}/arealight-probes.cmake)

# AreaLightBinding_Illuminate (FR-005): `Illuminate 1 0` after the scope renders the no-light image, equal byte for byte to
# the scene with no AreaLightSource at all (a characterization guard that holds on the starting tree); `Illuminate 1 1`
# gives the bound light's area integral (the AreaLightBinding_Illuminate_On_x3y3 probe above, red on the starting tree).
add_test(NAME AreaLightBinding_Illuminate
    COMMAND ${CMAKE_COMMAND} -DORENDER=$<TARGET_FILE:orender>
        "-DPAIRS=${_arealight_rib}/arealight-illuminate-off.rib|${_arealight_rib}/arealight-illuminate-none.rib"
        -DEXPECT=EQUAL -DTHREADS=1
        -P ${CMAKE_SOURCE_DIR}/tests/arealight/render_pair.cmake
    WORKING_DIRECTORY ${_arealight_dir})
set_tests_properties(AreaLightBinding_Illuminate PROPERTIES TIMEOUT 120 LABELS "arealight;state" ENVIRONMENT "${_arealight_env}" DEPENDS orender)

# ---- Phase 6 image tests (spec 057, thresholds in tests/visual/parity-thresholds.md "Spec 057") ------------------------------------------
# The soft-shadow scenes rendered to 8-bit RGBA (arealight-softimage-*): FR-031, the three camera hiders only: raytrace against reyes and
# against zbuffer for every emitter kind (photon and show are never parity subjects). Threshold 4 (measured worst 1.31, a missing shadow reads about 84).
foreach(_kind quad mesh subdiv)
    foreach(_hider reyes zbuffer)
        add_parity_test(arealight-${_kind}-${_hider}
            examples/rib/tests/arealight-softimage-${_kind}-raytrace.rib arealight-softimage-${_kind}-raytrace.tif
            examples/rib/tests/arealight-softimage-${_kind}-${_hider}.rib arealight-softimage-${_kind}-${_hider}.tif 4 "${_arealight_env}")
        set_tests_properties(Parity_arealight-${_kind}-${_hider} PROPERTIES LABELS "visual;parity;arealight")
    endforeach()
endforeach()
# Visual references (T104, approved after inspection): each scene against its own render on the approved tree, threshold 2 (measured 0 on the same
# platform; the measured Linux difference is reported at CHECKPOINT 6).
foreach(_kind quad mesh subdiv)
    foreach(_hider reyes zbuffer raytrace)
        add_visual_test(arealight-softshadow-${_kind}-${_hider}
            examples/rib/tests/arealight-softimage-${_kind}-${_hider}.rib arealight-softimage-${_kind}-${_hider}.tif
            arealight-softimage-${_kind}-${_hider}.tif 2)
        # the scenes use the test-local shaders (al_surface_matte): the arealight environment puts them on the shader path
        set_tests_properties(Visual_arealight-softshadow-${_kind}-${_hider} PROPERTIES LABELS "visual;regression;arealight" ENVIRONMENT "${_arealight_env}")
    endforeach()
    # the JIT twin: the .slo light against the same reference as the raytrace render (add_visual_test disables an -slo scene without LLVM)
    add_visual_test(arealight-softshadow-${_kind}-raytrace-slo
        examples/rib/tests/arealight-softimage-${_kind}-raytrace-slo.rib arealight-softimage-${_kind}-raytrace-slo.tif
        arealight-softimage-${_kind}-raytrace.tif 2)
    set_tests_properties(Visual_arealight-softshadow-${_kind}-raytrace-slo PROPERTIES LABELS "visual;regression;arealight" ENVIRONMENT "${_arealight_env}")
endforeach()

# ---- Phase 9: the old and the new quad light (US9; FR-022; SC-006; tasks.md T123) ----------------------------------------------
# AreaLight_QuadlightAgreement{,-slo}: examples/rib/quadlight.rib's geometry rendered with the shipped quadlight shader and with the quad as
# geometry under AreaLightSource "arealight" (intensity / the quad's area, decision D-1), compared by the 8 x 8 block metric of
# test_hider_parity. Threshold 8, fixed after the measurement of validation.md section 25 (run-to-run noise 2.1 to 3.7, old against new at
# 16 samples 3.8 to 5.95 on macOS, a 10 % intensity error 16.7 to 22.4) and never widened.
set(_ql_threshold 8)
foreach(_fmt "" "-slo")
    set(_ql_scratch ${_arealight_dir}/AreaLight_QuadlightAgreement${_fmt})
    file(MAKE_DIRECTORY ${_ql_scratch})
    add_test(NAME AreaLight_QuadlightAgreement${_fmt}
        COMMAND test_hider_parity $<TARGET_FILE:orender>
            ${_arealight_rib}/arealight-quadlight-agree-old-raytrace${_fmt}.rib arealight-quadlight-agree-old-raytrace${_fmt}.tif
            ${_arealight_rib}/arealight-quadlight-agree-new-raytrace${_fmt}.rib arealight-quadlight-agree-new-raytrace${_fmt}.tif
            ${_ql_threshold}
        WORKING_DIRECTORY ${_ql_scratch})
    set_tests_properties(AreaLight_QuadlightAgreement${_fmt} PROPERTIES TIMEOUT 360 LABELS "arealight;visual" ENVIRONMENT "${_arealight_env}" DEPENDS orender)
    # an -slo scene without the JIT would silently run the interpreter, a guaranteed pass: disabled then
    if("${_fmt}" STREQUAL "-slo" AND NOT OPENRENDER_HAVE_LLVM)
        set_tests_properties(AreaLight_QuadlightAgreement${_fmt} PROPERTIES DISABLED TRUE)
    endif()
endforeach()
