##RenderMan RIB-Structure 1.0
# Spec 039, Phase 8 (T086): ambient occlusion under the raytrace hider. The integral is the hemisphere
# sampling of occlusion() in the ambientocclusion light (@SAMPLES@ samples per shaded point). The
# irradiance cache is off (maxerror 0), so every point samples for itself; the pixel positions are fixed
# (jitter 0, one sample per pixel).
version 3.03
Option "sampling" "sampler" ["@SAMPLER@"]
Option "sampling" "seed" [@SEED@]
Option "shaderformat" "default" ["rslo"]
Option "limits" "bucketsize" [16 16]
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "convergence-out.tif" "file" "rgba"
Format 64 64 1
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
Projection "perspective" "fov" 40
Clipping 0.1 1000
Translate 0 0 12
WorldBegin
    Attribute "irradiance" "float maxerror" [0]
    Attribute "visibility" "int diffuse" [1]
    LightSource "ambientocclusion" 1 "numSamples" [@SAMPLES@]
    AttributeBegin
        Color [1 1 1]
        Surface "matte" "Ka" [1] "Kd" [0]
        Translate 0 0 3
        Sphere 1.5 -1.5 1.5 360
    AttributeEnd
    AttributeBegin
        Color [1 1 1]
        Surface "matte" "Ka" [1] "Kd" [0]
        Translate 2.2 -1.8 1
        Sphere 1 -1 1 360
    AttributeEnd
    AttributeBegin
        Color [1 1 1]
        Surface "matte" "Ka" [1] "Kd" [0]
        Translate 0 -3 0
        Rotate -90 1 0 0
        Disk 0 20 360
    AttributeEnd
WorldEnd
