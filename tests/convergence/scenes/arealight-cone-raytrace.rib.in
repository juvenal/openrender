##RenderMan RIB-Structure 1.0
# Spec 039, T089b (option B): arealight-raytrace with the shadow rays' origins kept at the shaded
# point ("samplebase" 0, transmission()'s "sampleBase"), so the cone of convergence_arealight.sl is the
# only integral: one active pair of dimensions, which the backend stratifies. arealight-raytrace,
# which keeps the footprint, couples two padded pairs and is checked by the weaker `gain` bar; see
# tests/convergence/README.md. Same geometry and light otherwise.
version 3.03
Option "sampling" "sampler" ["@SAMPLER@"]
Option "sampling" "seed" [@SEED@]
Option "shaderformat" "default" ["rslo"]
Option "limits" "bucketsize" [16 16]
PixelFilter "box" 1 1
Quantize "rgba" 0 0 0 0
Display "convergence-out.tif" "file" "rgba"
Format 64 64 1
Hider "raytrace" "jitter" [0]
PixelSamples 1 1
Projection "perspective" "fov" 40
Clipping 0.1 1000
Translate 0 0 12
WorldBegin
    Attribute "visibility" "int transmission" [1]
    LightSource "convergence_arealight" 1 "from" [4 6 -2] "intensity" [2.5] "samples" [@SAMPLES@] "samplecone" [0.12] "samplebase" [0]
    AttributeBegin
        Color [0.8 0.8 0.8]
        Surface "matte"
        Translate 0 0 3
        Sphere 1.5 -1.5 1.5 360
    AttributeEnd
    AttributeBegin
        Color [0.7 0.7 0.7]
        Surface "matte"
        Translate 0 -3 0
        Rotate -90 1 0 0
        Disk 0 20 360
    AttributeEnd
WorldEnd
