##RenderMan RIB
# param-override-test.rib — US3 parameter passing test
# Same scene as background-test.rib but with blue background color.
# Expected: non-geometry pixels ≈ (0, 0, 1).

Display "##OUTPUT##" "file" "rgb"
Format 64 32 1
PixelSamples 1 1
ShadingRate 1

Imager "background"
    "color bgcolor" [0 0 1]

Projection "perspective" "fov" 45

WorldBegin
    LightSource "ambientlight" 1 "intensity" [0.5]
    LightSource "distantlight" 2 "intensity" [1.0] "from" [0 0 -1] "to" [0 0 0]

    Surface "matte"
    Translate -0.5 0 4
    Sphere 0.6 -0.6 0.6 360
WorldEnd
