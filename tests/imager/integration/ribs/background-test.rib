##RenderMan RIB
# background-test.rib — US1 integration test
# Geometry: sphere covering the left half; red background imager fills the rest.
# Expected: right-half pixels ≈ (1, 0, 0); geometry pixels are shaded normally.

Display "##OUTPUT##" "file" "rgb"
Format 64 32 1
PixelSamples 1 1
ShadingRate 1

Imager "background"
    "color bgcolor" [1 0 0]

Projection "perspective" "fov" 45

WorldBegin
    LightSource "ambientlight" 1 "intensity" [0.5]
    LightSource "distantlight" 2 "intensity" [1.0] "from" [0 0 -1] "to" [0 0 0]

    Surface "matte"
    Translate -0.5 0 4
    Sphere 0.6 -0.6 0.6 360
WorldEnd
