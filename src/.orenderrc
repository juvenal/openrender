########################################################################
## Any customizations can be put in this file. It's just straight RIB.
########################################################################

Option "shaderformat" "default"  ["rslo"]

Option "searchpath" "shader"     ["&:.:%ORENDERHOME%/shaders:%SHADERS%:/usr/local/shaders"]
Option "searchpath" "texture"    ["&:.:%ORENDERHOME%/textures:%TEXTURES%:/usr/local/textures"]
Option "searchpath" "archive"    ["&:.:%ORENDERHOME%/ribs:%RIBS%:/usr/local/models"]
Option "searchpath" "display"    ["&:.:%ORENDERHOME%/displays:%DISPLAYS%:/usr/local/displays"]
Option "searchpath" "procedural" ["&:.:%ORENDERHOME%/procedurals:%PROCEDURALS%:/usr/local/procedural"]
Option "searchpath" "geometry"   ["&:.:%ORENDERHOME%/geometry:%GEOMETRIES%:/usr/local/share/openrender/geometry"]

Format 640 480 1
PixelSamples 2 2

