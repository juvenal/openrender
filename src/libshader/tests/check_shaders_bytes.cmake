# Shaders_BytesUnchanged (spec 038, FR-019, SC-007; contracts/compiler-tables.md "Unchanged outputs"): the
# compiler's output for every shipped shader, and its command-line surface, do not change while the compiler
# stops borrowing the shading engine's tables.
#
#   cmake -DMODE=compare|capture|capture-differences -DSHADER_DIR=<build/shaders> -DPROBE_DIR=<dir of probe.rslo>
#         -DOSHADER=<oshader> -DWITH_SLO=ON|OFF -DREFERENCE_ROOT=<src/libshader/tests/reference> -DPLATFORM=macos|linux
#         -DWORK=<scratch dir> [-DRECAPTURE=ON] -P check_shaders_bytes.cmake
#
# What is compared, with reference/<platform>/shaders.sha256 and oshader_help.txt:
#   * the sha256 of the .rslo of every shipped shader in SHADER_DIR, and (WITH_SLO, i.e. OPENRENDER_ENABLE_JIT)
#     of every .slo; plus the .rslo of probe.sl and probe_two.sl (tests/plugins/shadeop), whose operands are
#     built by the plug-in tests;
#   * the text and the exit status of `oshader` with no argument, `oshader --help` and `oshader <missing file>`.
# The references are macOS's (reference/macos/); on Linux a file under reference/linux/ replaces one where the
# Linux output differs (the .slo bitcode follows the LLVM version), captured by the Linux gate only for the
# files that differ.
#   compare              (default) fails on any difference
#   capture              writes the macOS references that do not exist; replaces them only with RECAPTURE=ON
#   capture-differences  writes reference/linux/<file> for a file whose Linux result differs from macOS's
if(NOT MODE)
    set(MODE compare)
endif()

# --- compute ---
set(_lines "")
file(GLOB _rslo "${SHADER_DIR}/*.rslo")
list(SORT _rslo)
set(_files ${_rslo})
if(WITH_SLO)
    file(GLOB _slo "${SHADER_DIR}/*.slo")
    list(SORT _slo)
    list(APPEND _files ${_slo})
endif()
foreach(_probe probe probe_two)
    list(APPEND _files "${PROBE_DIR}/${_probe}.rslo")
endforeach()
if(NOT _rslo)
    message(FATAL_ERROR "no .rslo in ${SHADER_DIR}: build the tree first")
endif()
foreach(_f IN LISTS _files)
    if(NOT EXISTS "${_f}")
        message(FATAL_ERROR "${_f} does not exist: build the tree first")
    endif()
    file(SHA256 "${_f}" _hash)
    get_filename_component(_name "${_f}" NAME)
    list(APPEND _lines "${_hash}  ${_name}")
endforeach()
list(SORT _lines)
string(REPLACE ";" "\n" _manifest "${_lines}")
set(_manifest "${_manifest}\n")

file(MAKE_DIRECTORY "${WORK}")
set(_help "")
foreach(_case "no-argument" "--help" "missing_file.sl")
    if(_case STREQUAL "no-argument")
        set(_args "")
    else()
        set(_args "${_case}")
    endif()
    execute_process(COMMAND "${OSHADER}" ${_args} WORKING_DIRECTORY "${WORK}"
        RESULT_VARIABLE _rc OUTPUT_VARIABLE _o ERROR_VARIABLE _e TIMEOUT 60)
    set(_help "${_help}### oshader ${_case}: exit ${_rc}\n--- stdout\n${_o}--- stderr\n${_e}")
endforeach()

# --- the references ---
function(or_reference_file name out_primary out_override)
    set(${out_primary} "${REFERENCE_ROOT}/macos/${name}" PARENT_SCOPE)
    set(${out_override} "${REFERENCE_ROOT}/linux/${name}" PARENT_SCOPE)
endfunction()

# the manifest of the reference, restricted to what this run computes
function(or_restrict manifest out)
    if(WITH_SLO)
        set(${out} "${manifest}" PARENT_SCOPE)
        return()
    endif()
    string(REPLACE "\n" ";" _l "${manifest}")
    set(_keep "")
    foreach(_line IN LISTS _l)
        if(NOT _line STREQUAL "" AND NOT _line MATCHES "\\.slo$")
            list(APPEND _keep "${_line}")
        endif()
    endforeach()
    string(REPLACE ";" "\n" _text "${_keep}")
    set(${out} "${_text}\n" PARENT_SCOPE)
endfunction()

set(_failures 0)
foreach(_item IN ITEMS "shaders.sha256" "oshader_help.txt")
    or_reference_file(${_item} _primary _override)
    if(_item STREQUAL "shaders.sha256")
        set(_actual "${_manifest}")
    else()
        set(_actual "${_help}")
    endif()

    if(MODE STREQUAL "capture")
        if(EXISTS "${_primary}" AND NOT RECAPTURE)
            message(STATUS "kept     ${_primary} (exists; configure with -DOR038_RECAPTURE=ON to replace)")
        else()
            get_filename_component(_dir "${_primary}" DIRECTORY)
            file(MAKE_DIRECTORY "${_dir}")
            file(WRITE "${_primary}" "${_actual}")
            message(STATUS "captured ${_primary}")
        endif()
        continue()
    endif()

    if(MODE STREQUAL "capture-differences")
        if(EXISTS "${_override}" AND NOT RECAPTURE)
            message(STATUS "kept     ${_override}")
            continue()
        endif()
        file(READ "${_primary}" _expected)
        if(_item STREQUAL "shaders.sha256")
            or_restrict("${_expected}" _expected)
        endif()
        if(_expected STREQUAL _actual)
            message(STATUS "same     ${_item}")
        else()
            get_filename_component(_dir "${_override}" DIRECTORY)
            file(MAKE_DIRECTORY "${_dir}")
            file(WRITE "${_override}" "${_actual}")
            message(STATUS "DIFFERS  captured ${_override}")
        endif()
        continue()
    endif()

    # compare
    if(EXISTS "${_override}" AND CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        set(_reference "${_override}")
    else()
        set(_reference "${_primary}")
    endif()
    if(NOT EXISTS "${_reference}")
        message("FAIL: missing reference ${_reference} (build the target scene-interface-capture-baselines)")
        math(EXPR _failures "${_failures} + 1")
        continue()
    endif()
    file(READ "${_reference}" _expected)
    if(_item STREQUAL "shaders.sha256")
        or_restrict("${_expected}" _expected)
    endif()
    if(NOT _expected STREQUAL _actual)
        # name the first differing line
        string(REPLACE "\n" ";" _e "${_expected}")
        string(REPLACE "\n" ";" _a "${_actual}")
        set(_first "")
        list(LENGTH _e _ne)
        list(LENGTH _a _na)
        if(_ne GREATER _na)
            set(_n ${_ne})
        else()
            set(_n ${_na})
        endif()
        set(_i 0)
        while(_i LESS _n AND _first STREQUAL "")
            set(_x "<end>")
            set(_y "<end>")
            if(_i LESS _ne)
                list(GET _e ${_i} _x)
            endif()
            if(_i LESS _na)
                list(GET _a ${_i} _y)
            endif()
            if(NOT _x STREQUAL _y)
                set(_first "line ${_i}: expected [${_x}] actual [${_y}]")
            endif()
            math(EXPR _i "${_i} + 1")
        endwhile()
        message("FAIL: ${_item} differs from ${_reference}: ${_first}")
        math(EXPR _failures "${_failures} + 1")
    endif()
endforeach()
if(_failures GREATER 0)
    message(FATAL_ERROR "Shaders_BytesUnchanged: ${_failures} failure(s).")
endif()
message(STATUS "Shaders_BytesUnchanged: ${MODE} ok")
